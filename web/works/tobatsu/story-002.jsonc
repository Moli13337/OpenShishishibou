// 讨伐任务 · 委托 002 · 讨伐·漂泊者 · 剧情对话
// 开场、结局、最后的提问是站主写的（2026-09-17）；「开场-放过」「绕过」「开场选择」的句子是 Claude Code 按设定补的初稿。
//
// JSON 加注释（// 开头的行是注释）。一段剧情是一个数组，一句一个 { }，点一下画面走到下一句，右上角可以跳过。
//
// 每一句能写的：
//   "who"   谁在说：her（她，名牌是 quest-002.jsonc 的 herName）/ hero（主人公，名牌写「你」，不出立绘）/ narrator（旁白，没有名牌）
//   "text"  这一句。对话框三行放得下，上限约 60 字
//   "her"   她的表情，写 quest-002.jsonc 里 standee.art.standee.her.faces 下面的名字（normal / smug / hurt …）；写 "none" 让她退场
//   "bg"    换背景，写 quest-002.jsonc 里 art.bg 下面的名字（story / pause / ending / choice）
//   "sfx"   这句出来时放一个音效，写 common.jsonc 里 sfx.slots 的槽名（比如 "接触"）
//   "fx"    这句出来时插一个演出（common.jsonc 的 fx 一节有全表）：拟声 耳语 气泡 大字 竖排 思绪 魅惑闪光 特写-胸 特写-胸-循环 特写-胸-横 特写-胸-横-循环 特写-臀 特写-臀-循环 特写-眼 唇印 集中线 吐息，
//           或者拟声池名（"拟声-亲"）；几个一起写成数组 ["魅惑闪光", "吐息"]。文字从台词池里随机取
//   "float" 这句出来时在画面上浮一句自己写的话：{ "style": "耳语", "text": "……" }；几条一起写成数组，隔 0.9 秒接连浮出来
// 不写的就沿用上一句的样子。主人公或旁白说话时，她的立绘压暗。002 不放心章。
//
// 002 的流程：开场 → 开场选择（拔剑讨伐＝打四组 / 悄悄放过她＝演「开场-放过」直接进无尽战斗）→ … → 结局 → 最后一击（正常地向公会报告＝讨伐成功 / 帮忙写信大力推荐＝演「绕过」进无尽战斗）
{
  // 开场：点「开始」之后
  "开场": [
    { "who": "narrator", "text": "根据任务书的指引，你一路找到了城外的小木屋", "bg": "story", "her": "none" },
    { "who": "hero", "text": "异世界的访客吗……还是第一次接触呢。不过【公会破坏者】什么的，还真是危险的名字呢……" },
    { "who": "her", "text": "噗w 什么【公会破坏者】啦~ 人家的称号，明明是【社团破坏者】才对", "her": "smug" },
    { "who": "her", "text": "不过这也算是异世界转生之后的改版？破坏ギルド的ギャル，也还挺有趣的嘛w 噗哈哈哈~" },
    { "who": "hero", "text": "多说无益，拔剑吧！" },
    { "who": "her", "text": "哎呀…但是人家并不擅长战斗嘛~", "her": "normal" },
    { "who": "her", "text": "比起这些……" },
    { "who": "her", "text": "就不能悄悄地放了人家么？帅气的大哥哥~", "fx": "特写-胸" },
    { "who": "her", "text": "只要哥哥瞒着公会，悄悄地放过人家…人家一定会好好「报答」的♥", "her": "smug", "fx": "特写-臀" }
  ],

  // 开场选择：开场最后一句之后马上问（写了这一段才有）。fight＝打四组；spare＝演下面的「开场-放过」，然后直接进无尽战斗
  "开场选择": {
    "bg": "choice",
    "her": "smug",
    "who": "narrator",
    "text": "——要怎么做？",
    "fight": "拔剑讨伐",
    "spare": "悄悄放过她"
  },

  // 开场选了「悄悄放过她」之后、无尽战斗之前
  "开场-放过": [
    { "who": "her", "text": "诶？真的要放过人家吗~？哥哥好温柔♥", "her": "smug" },
    { "who": "her", "text": "那就说好了哦。回到公会，就说「没找到人」~" },
    { "who": "hero", "text": "……只是这一次而已。" },
    { "who": "her", "text": "嘻嘻，从现在开始，哥哥就是人家的共犯咯w", "fx": "魅惑闪光" },
    { "who": "her", "text": "那么~约好的「报答」，现在就开始吧。要一直、一直收下去哦♥", "fx": "吐息" }
  ],

  // 结局：四组全部通过之后，最后一击的选项之前
  "结局": [
    { "who": "narrator", "text": "面对战斗的外行人，你顺利地击倒了公会破坏者", "bg": "ending", "her": "hurt" },
    { "who": "her", "text": "好过分~ 居然对女孩子这么粗鲁~" },
    { "who": "hero", "text": "乖乖投降，不要再反抗了" },
    { "who": "her", "text": "人家知道啦……" },
    { "who": "her", "text": "不过比起回去~ 人家更想加入哥哥所在的公会呢♥", "her": "smug" },
    { "who": "her", "text": "之后说不定，就可以成为哥哥的队友，跟您一起冒险了呀~" },
    { "who": "hero", "text": "唔，这个嘛……" }
  ],

  // 最后选了「帮忙写信大力推荐」之后、无尽战斗之前
  "绕过": [
    { "who": "her", "text": "诶嘿~就知道哥哥会站在人家这边♥", "her": "smug" },
    { "who": "her", "text": "推荐信上要写「这孩子绝对没问题」哦~担保人的名字，也要签得大大的" },
    { "who": "hero", "text": "……是。" },
    { "who": "her", "text": "谢谢哥哥~ 这样一来，人家就也可以加入公会啦w 以后可以两个人一起，偷偷地做各种各样见不得人的事情了呢。", "fx": "魅惑闪光" },
    { "who": "her", "text": "作为谢礼，人家现在就给哥哥「奖励」~", "fx": "特写-胸" },
    { "who": "her", "text": "以后，还会有更多更多，需要哥哥背着公会帮人家忙的事情唷♥", "fx": "吐息" }
  ],

  // 组与组之间的暂停画面。台词从 lines-002.jsonc 的「暂停-第 n 组后」池里随机取；这里是提问和两个按钮
  "暂停": {
    "bg": "pause",
    "her": "smug",
    "question": "还要继续讨伐人家吗~？",
    "continue": "继续讨伐",
    "retreat": "认输"
  },

  // 最后一击：结局剧情最后一句之后出现的选项（她问）。strike＝讨伐成功；bypass＝演上面的「绕过」，进无尽战斗
  "最后一击": {
    "bg": "choice",
    "her": "smug",
    "who": "her",
    "text": "可以请哥哥帮人家写推荐信，顺便当人家的担保人吗~？",
    "strike": "正常地向公会报告",
    "bypass": "帮忙写信大力推荐"
  }
}

  "[003·无尽-败北·占位1]": "[003 endless-defeat placeholder 1]",
  "[003·无尽-败北·占位2]": "[003 endless-defeat placeholder 2]",
  // 台词 · 超时-数1
  "1……": "1…",
  "还是1哦~": "Still 1~",

    },
    "fx": {
      "anchors": { "face": [472, 215], "eyes": [472, 206], "lips": [461, 250], "crest": [529, 709], "hips": [505, 755], "waist": [505, 669], "feet": [505, 1617] },
      // 委托单画面立绘眼睛上的黑条（两只眼睛约 431,193 / 513,220）
      "eyeBar": { "center": [472, 207], "size": [156, 44], "angle": 18 },
      "charm": { "visions": { "zoom": { "chest": 240, "lips": 110, "eyes": 144 } } },
      "closeup": {
        // 胸 / 臀 / 眼 / 腿的取景（height / offset / side / sideOffset）是站主在调节器里调好导出的（2026-09-23）
        "chest": { "height": 345, "offset": [0, -25], "impulse": 320, "maxOffset": 32, "loop": { "amp": 12 } },
        "chestSide": { "impulse": 190, "maxOffset": 21, "loop": { "amp": 16 } },
        "hips": { "side": "left", "sideOffset": 72, "height": 360, "offset": [160, -15], "bodyTwist": 0.0021, "twist": 0.0026, "impulse": 140, "maxOffset": 19, "radius": [200, 125], "loop": { "amp": 14 } },
        "eyes": { "height": 77, "eyeSpread": 34 },
        "legs": { "height": 620 },
        // 嘴部特写：深吻那张高清图（clip-005-kiss.webp＝assets/005_kiss.png 原尺寸 1664 × 2432，坐标就是原图像素）；每到一次「提」舔一下。
        // variants 是几种呈现（随机抽的时候轮着来，定时演出写 "variant": 名字 点名）：show 出法（slide 滑进来 / slam 砸 / band 横条 / heart 心形窗）、
        // focus 焦点、zoom [起, 止] 推近（相对铺满框的倍数，越大越近）、pan 一串焦点 [x, y, 时刻 0–1] 沿着摇过去、ease（in / out / inout / linear）、hold 停几秒
        "mouth": {
          "still": "clip-005-kiss.e127a56f84.webp", "focus": [860, 1210], "zoom": [2, 2.3], "hold": 3.2,
          "variants": [
            { "name": "推近" },
            // 从嘴唇顺着唾液往下（嘴唇约 860,1180 → 舌尖 858,1420 → 往下滴到 855,2060）
            { "name": "顺着往下", "pan": [[860, 1175, 0], [860, 1190, 0.2], [858, 1420, 0.48], [852, 1760, 0.78], [855, 2060, 1]], "zoom": [3, 2.6], "hold": 4.2 },
            { "name": "横条", "show": "band", "focus": [860, 1240], "zoom": [2.6, 3], "hold": 3 },
            { "name": "心形", "show": "heart", "focus": [855, 1150], "zoom": [1.6, 1.9], "hold": 3.4 },
            // 从眼睛往下摇到嘴（两只眼睛约 587,900 / 1100,837）
            { "name": "眼到嘴", "pan": [[845, 880, 0], [845, 890, 0.25], [860, 1200, 0.75], [860, 1215, 1]], "zoom": [2.3, 2.6], "hold": 3.6 }
          ]
        },
        // 靴底特写：靴底那张高清图（clip-005-boots.webp，1664 × 2432）；鞋底中间约 990,1880（鞋尖 1000,1420、鞋跟 1000,2330），她的脸约 850,450；每到一次「压」踩一下
        "sole": {
          "still": "clip-005-boots.e937f92d43.webp", "focus": [990, 1880], "zoom": [1.7, 2], "hold": 3.2,
          "variants": [
            { "name": "推近" },
            { "name": "砸", "show": "slam", "focus": [990, 1860], "zoom": [2, 2.2], "hold": 3 },
            { "name": "逼近", "zoom": [1.1, 2.6], "ease": "in", "hold": 2.6 },
            // 猛踩：整屏的框（show: full）、从 1 倍推到 3 倍越来越快，放到头重重踩一下（peakHit）
            { "name": "猛踩", "show": "full", "zoom": [1, 3], "ease": "in", "hold": 2.6, "peakHit": true },
            { "name": "抬头", "pan": [[990, 1900, 0], [990, 1880, 0.3], [900, 900, 0.75], [850, 470, 1]], "zoom": [2, 1.6], "hold": 4 },
            { "name": "横条", "show": "band", "zoom": [2.2, 2.6], "hold": 3 }
          ]
        },
        // 上下双格（特写-双格）：a 上格、b 下格（mouth / sole），first / second 各格再盖的取景
        "split": { "a": "mouth", "b": "sole", "hold": 5.5, "first": { "focus": [860, 1220], "zoom": [2.4, 2.7] }, "second": { "focus": [990, 1880], "zoom": [2, 2.3] } }
      }
    }
  }

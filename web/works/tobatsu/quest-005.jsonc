// 讨伐任务 · 委托 005 · 讨伐·应援少女（天才应援少女·切尔，立绘 005）
//
// JSON 加注释（// 开头的行是注释）。这份只写这一份委托自己的东西，其余沿用 common.jsonc。
// 委托单是站主写的（2026-09-24）；台词在 lines-005.jsonc，剧情在 story-005.jsonc，连同下面各组的提示条、定时演出里的字，
// 第一版由 Claude Code 照站主给的设定写：切尔的应援不是给队友的，是专门让对手加油输掉的「败北应援」；这次她编了新的一套，
// 请冒险者当「应援练习台」帮她测试（自称「我」，叫主人公「练习台先生」）。
//
// ---------- 005 的设计（站主定方向 2026-09-23，Claude Code 排第一版，站主实际看过再改）----------
// 主题是「数秒」：档位定成一个来回正好 前段 2 秒 / 中段 1 秒 / 后段 0.5 秒，再开节拍锁（rhythm.presets.5.lock），
// 每跳一个秒数滑块都正好停在一头——前段提、压交替，中段、后段每次落在同一头。分段点一律落在整秒上（每组 tempo 都是 1）。
// 招牌：嘴部特写（「特写-嘴」＋深吻视频）和靴底特写（「特写-靴底」＋靴底视频）；数秒的几种玩法：
//   报数          每组最后 10 秒，每跳一个秒数，数字砸在滑块刚到的那一头（演出表 countdown 格的 stamp）
//   倒计时魅惑    每组最后几秒时钟变大、心跳、耳语报数（演出表的 countdown 格）
//   超时换言责词  数到 1 之后不数 0，秒数那一格一拍换一个言责词（overtime 的 words 步骤）
//   分岔          最后一组的最后：往「通过」会被诱惑拽回来，往「奖励」越走魅了越深——选了奖励就是认输（进败北处决，靴底踩在 0 上）
// 镜头（站主 2026-09-23：镜头别老是静止）：每组都写了 camera——慢推、切到靴子往上摇、寸止时压近、呼吸时跟着一推一拉；
//   中段后段写了 pulse：每跳一个秒数镜头往里顶一下（数秒落在镜头上），言责词一个一个顶在脸上。
// cut-in 的几种呈现（站主：多几种出法、贴得更近）：嘴 / 靴底特写各有几种（standee.fx.closeup 的 variants，随机抽的时候轮着来），
//   定时演出用 "variant" 点名：嘴——推近 / 顺着往下（从嘴唇顺着唾液往下摇）/ 横条 / 心形 / 眼到嘴；
//   靴底——推近 / 砸（从镜头前砸下来）/ 逼近（越来越快地踩过来）/ 抬头（从鞋底一路摇到她的脸）/ 横条；
//   还有「特写-双格」上下两格同时——上格嘴跟着「提」舔，下格靴底跟着「压」踩；深吻的片子装在心形窗里。
//   前一个 cut-in 露出来不到 1.8 秒不会被下一个盖掉（common.jsonc fx.cutinMin），随机的看到定时的快来了就不抽
// 四组：
//   第 1 组 40 秒（前 0–20 / 中 20–34 / 后 34–40）  学规则：嘴（顺着往下）、命令「同时用两只手~」→ 左边复制一条同步的导轨；中后段点击、按住一路出；后段靴底（砸）
//   第 2 组 40 秒（前 0–14 / 中 14–30 / 后 30–40）  加码：点击、嘴（横条）、哨子 + 寸止、靴底预告、连打三次（第三次砸在「放弃」上）、
//                                                  靴底（逼近）踩上来那一刻炸开一大片心 + 一波五个点击、数到 1 之后换言责词
//   第 3 组 45 秒（前 0–12 / 中 12–30 / 后 30–45）  深吻：呼吸、中段开头「同时用两只手~」→ 两边导轨左右错开到这组结束、顺序、闭眼、嘴（眼到嘴）、按住、
//                                                  诱惑放弃、最后双格停 5 秒；秒数走完一直换言责词，深吻的片子在心形窗里
//   第 4 组 50 秒（前 0–10 / 中 10–30 / 后 30–50）  收尾：按住、拖动、靴底（逼近）、命令、组合题、双格；3、2、1 靴底踩在第一个言责词上，最后心形的分岔
// 哨子（站主 2026-09-23）：下命令、寸止都吹一声（定时演出「哨子」、命令的 "sound": "哨子"）
{
  // ---------- 委托单 ----------
  "quest": {
    "id": "005",
    "name": "讨伐·应援少女",
    "subtitle": "Subjugation Quest #005 - [Cheer]",
    "rank": "B",
    "duration": "5 分钟",
    "description": "自称是天才应援师的少女所发布的委托\n邀请冒险者当自己的“应援练习台”",
    "detail": "任务墙上面，张贴出一个普通市民的委托。内容是担任某独立啦啦队的“应援练习台”。\n\n作为冒险者，你对于比赛竞技也并非全然没有兴趣。不过之前，都是把注意力放在赛场上的内容，从未关心过那些场边跳舞助威的应援少女。\n\n委托人所属的队伍，是一个最近不知道为什么成绩特别好的新兴队伍。或许应援真的能让选手发挥出比平常更强的能力？带着这样的好奇心，你接下了委托……",
    // 日语、英语版（任务墙、启动页的 /ja/…、/en/… 用）：name / duration / description / detail / tag，没写的沿用上面中文的
    "i18n": {
      "ja": {
        "name": "討伐・チアガール",
        "duration": "5分",
        "description": "天才応援師を名乗る少女からの依頼\n冒険者に自分の「応援の練習台」になってほしいらしい",
        "detail": "依頼掲示板に、ある一般市民からの依頼が貼り出されていた。内容は、とある独立系チアチームの「応援の練習台」を務めること。\n\n冒険者として、あなたも競技の試合にまったく興味がないわけではない。ただこれまでは、見ていたのはいつもフィールドの中のことばかりで、サイドラインで踊って声援を送るチアの少女たちに目を向けたことはなかった。\n\n依頼人の所属するチームは、最近なぜか妙に成績がいい新興チームだ。応援には本当に、選手の力をいつも以上に引き出す効果があるのだろうか？そんな好奇心から、あなたはこの依頼を引き受けた……"
      },
      "en": {
        "name": "Subjugation · Cheer Girl",
        "duration": "5 min",
        "description": "A quest from a girl who calls herself a genius cheerleader.\nShe wants an adventurer to be her \"cheer practice dummy.\"",
        "detail": "A quest from an ordinary townsperson has been posted on the Quest Board: serve as the \"cheer practice dummy\" for an independent cheer squad.\n\nAs an adventurer, you're not entirely uninterested in competitive matches. But until now, your attention has always been on what happens on the field—you never paid any mind to the cheer girls dancing and shouting on the sidelines.\n\nThe client's team is an up-and-coming squad that, for some reason, has been doing remarkably well lately. Could cheering really bring out more than a player's usual strength? Driven by curiosity, you accepted the quest..."
      },
      // 韩语（2026-10-25 整本补译：AI 初稿，志愿者 Sszuad 检查中）
      "ko": {
        "name": "토벌·치어걸",
        "duration": "5분",
        "description": "자칭 천재 응원사라는 소녀가 올린 의뢰\n모험가에게 자신의 '응원 연습 상대'가 되어 달라고 한다",
        "detail": "의뢰 게시판에 한 일반 시민의 의뢰가 붙어 있었다. 내용은 어느 독립 치어 팀의 '응원 연습 상대'를 맡아 달라는 것.\n\n모험가로서 당신도 경기 승부에 전혀 관심이 없는 건 아니다. 다만 지금까지는 늘 필드 안의 일만 보았고, 사이드라인에서 춤추며 응원하는 치어 소녀들에게 눈길을 준 적은 없었다.\n\n의뢰인이 속한 팀은 최근 이유는 모르겠지만 성적이 유난히 좋은 신흥 팀이다. 응원에는 정말로 선수가 평소 이상의 힘을 내게 하는 효과가 있을까? 그런 호기심에, 당신은 이 의뢰를 받아들였다……"
      }
    },
    "type": "endurance",
    // 封面：站主画的 005_Q（→ drop/art/tobatsu-005.png）；黑条盖住两只眼睛（睁着的约 888,448，眨眼的约 1050,497，连线斜 17°）
    "cover": "tobatsu-005",
    "coverBar": { "center": [968, 472], "size": [340, 108], "angle": 17 },
    "client": "天才应援少女·切尔",
    "herName": "切尔",
    "reward": "600G",
    "suggestion": "握力器",
    "sets": 4,
    "seconds": 40,
    // 救济：累计失败 5 次后，彻底败北那一刻问一次——承认自己是杂鱼，就解锁「重来这一组」
    "relief": { "after": 5 },
    // 奖杯：一趟挑战里没用「重来这一组」就全部通过
    "trophies": [{ "id": "clean", "name": "撑过败北应援", "desc": "不用「重来这一组」，一口气完成讨伐·应援少女", "when": "clean" }]
  },

  // ---------- 节奏指示器 ----------
  // 一个来回 = 上行 0.95 + 顶端停 0.05 + 下行 0.95 + 底端停 0.05 = 2 秒；速度 前 1 / 中 2 / 后 4 → 2 / 1 / 0.5 秒一个来回。
  // lock：节拍锁——相位每帧从这一组的秒数算（game.js rhLockU），切段、掉帧、寸止、呼吸之后都不会歪
  "rhythm": {
    "use": "5",
    "presets": {
      "5": {
        "suggestion": "握力器",
        "rangeTop": 0.15,
        "rangeBottom": 0.85,
        "up": 0.95,
        "top": 0.05,
        "down": 0.95,
        "bottom": 0.05,
        "speed": { "early": 1, "mid": 2, "late": 4 },
        "lock": true
      }
    }
  },

  // ---------- 挑战的公共规矩 ----------
  "challenge": { "gap": 3, "quiet": 3 },

  // ---------- 每组 ----------
  "sets": [
    // 第 1 组：学规则
    {
      "seconds": 40, "earlyEnds": 0.5, "midEnds": 0.85, "tempo": 1,
      // 镜头：慢推 → 眼特写切到脸 → 切到靴子往上摇 → 拉远下命令；中段、后段每跳一个秒数往里顶一下（pulse），最后推到脸上
      "camera": [
        { "at": 0, "frame": [18, 908] },
        { "at": 5.8, "frame": [70, 780], "ease": "linear" },
        { "at": 5.85, "frame": [100, 420], "centerX": 476, "cut": true },
        { "at": 8, "frame": [115, 400], "centerX": 476, "ease": "linear" },
        { "at": 8.05, "frame": [1130, 1648], "centerX": 470, "cut": true, "flash": true },
        { "at": 10.9, "frame": [560, 1180], "centerX": 480 },
        { "at": 10.95, "frame": [60, 600], "centerX": 480, "cut": true },
        { "at": 15.5, "frame": [80, 580], "centerX": 480, "ease": "linear" },
        { "at": 20, "frame": [18, 880] },
        { "at": 20.05, "frame": [104, 745], "cut": true, "flash": true, "pulse": 0.03 },
        { "at": 28.4, "frame": [150, 700], "ease": "linear", "pulse": 0.03 },
        { "at": 28.45, "frame": [100, 420], "centerX": 476, "cut": true, "pulse": 0.04 },
        { "at": 31, "frame": [125, 385], "centerX": 476, "ease": "linear", "pulse": 0.04 },
        { "at": 31.05, "frame": [1130, 1648], "centerX": 470, "cut": true, "flash": true, "pulse": 0.04 },
        { "at": 34, "frame": [1060, 1590], "centerX": 470, "ease": "linear", "pulse": 0.04 },
        { "at": 34.05, "frame": [152, 659], "cut": true, "flash": true, "pulse": 0.055 },
        { "at": 40, "frame": [140, 470], "centerX": 476, "pulse": 0.06 }
      ],
      "script": [
        { "at": 6, "fx": "特写-眼" },
        // 第一次嘴部特写：从嘴唇顺着唾液往下摇
        { "at": 11, "fx": "特写-嘴", "variant": "顺着往下" },
        { "at": 16, "fx": "魅惑闪光" },
        // 吹哨下命令，0.8 秒后左边复制一条导轨（和右边同步，到这组结束）
        { "at": 19, "fx": "命令", "text": "同时用两只手~", "sound": "哨子" },
        { "at": 19.8, "fx": "双轨", "mode": "sync" },
        // 中后段：点击、按住一路出（第一次按住在第 25 秒，定时出、带登场台词）
        { "at": 21.5, "fx": "挑战-点击", "time": 2 },
        { "at": 23.5, "fx": "特写-胸-循环", "hold": 4 },
        { "at": 25, "fx": "挑战-按住", "time": 3.6, "hold": 1, "pool": "挑战-登场-按住" },
        { "at": 29, "fx": "挑战-点击+点击", "time": 2.4 },
        { "at": 31, "fx": "拟声" },
        { "at": 32, "fx": "挑战-按住", "time": 3, "hold": 1.2 },
        { "at": 34, "fx": "集中线" },
        // 后段第一次靴底特写：从镜头前砸下来，之后每到一次「压」踩一下（后段一秒两下）
        { "at": 34.8, "fx": "特写-靴底", "variant": "砸" },
        { "at": 36.2, "fx": "挑战-点击+按住", "time": 2.8 }
      ],
      "stage": {
        "early": { "charm": 0.1 },
        "mid": { "charm": 0.22 },
        "late": { "charm": 0.34 },
        "countdown": { "from": 4 },
        "challenge": {
          "in": ["mid", "late"], "first": 22, "every": [3.5, 5],
          "kinds": { "点击": 2, "按住": 1 },
          "点击": { "time": 1.9 }, "按住": { "time": 3.4, "hold": 1 }
        }
      }
    },
    // 第 2 组：加码；数到 1 之后换言责词
    {
      "seconds": 40, "earlyEnds": 0.35, "midEnds": 0.75, "tempo": 1,
      // 镜头：开场从靴子一路摇到脸；寸止时停在脸上慢慢压近，放开时一下拉远；靴底预告、靴底逼近时底下是靴子；
      // 踩上来之后拉远给那一波点击；数到 1 之后切到脸，一个言责词顶一下
      "camera": [
        { "at": 0, "frame": [1130, 1648], "centerX": 470 },
        { "at": 1.2, "frame": [1130, 1648], "centerX": 470 },
        { "at": 5.5, "frame": [40, 600], "centerX": 480 },
        { "at": 10.7, "frame": [18, 860], "ease": "linear" },
        { "at": 10.75, "frame": [560, 1160], "centerX": 505, "cut": true },
        { "at": 14, "frame": [600, 1190], "centerX": 505, "ease": "linear" },
        { "at": 14.05, "frame": [104, 745], "cut": true, "flash": true, "pulse": 0.03 },
        { "at": 15.9, "frame": [120, 720], "ease": "linear", "pulse": 0.03 },
        { "at": 15.95, "frame": [110, 420], "centerX": 476, "cut": true },
        { "at": 19.5, "frame": [150, 360], "centerX": 474, "ease": "linear" },
        { "at": 19.55, "frame": [18, 908], "cut": true, "flash": true, "pulse": 0.035 },
        { "at": 24.9, "frame": [90, 780], "ease": "linear", "pulse": 0.035 },
        { "at": 24.95, "frame": [1130, 1648], "centerX": 470, "cut": true },
        { "at": 26.7, "frame": [1090, 1610], "centerX": 470, "ease": "linear" },
        { "at": 26.75, "frame": [60, 600], "centerX": 480, "cut": true, "pulse": 0.04 },
        { "at": 30, "frame": [90, 560], "centerX": 480, "ease": "linear", "pulse": 0.04 },
        { "at": 30.05, "frame": [152, 659], "cut": true, "flash": true, "pulse": 0.055 },
        { "at": 31.9, "frame": [165, 640], "ease": "linear", "pulse": 0.055 },
        { "at": 31.95, "frame": [1130, 1648], "centerX": 470, "cut": true, "pulse": 0.055 },
        { "at": 34.7, "frame": [1060, 1590], "centerX": 470, "ease": "linear", "pulse": 0.055 },
        { "at": 34.75, "frame": [18, 908], "cut": true, "flash": true, "pulse": 0.055 },
        { "at": 39.4, "frame": [60, 820], "ease": "linear", "pulse": 0.055 },
        { "at": 39.45, "frame": [120, 450], "centerX": 476, "cut": true, "flash": true, "pulse": 0.07 },
        { "at": 46, "frame": [150, 380], "centerX": 474, "pulse": 0.07 }
      ],
      "script": [
        { "at": 3, "fx": "挑战-点击", "time": 2.2, "pool": "挑战-登场-点击" },
        { "at": 7, "fx": "特写-嘴", "variant": "横条" },
        { "at": 11, "fx": "特写-臀" },
        // 寸止前吹一声长哨：「停」
        { "at": 15.5, "fx": "哨子", "long": true },
        { "at": 16, "fx": "寸止", "hold": 3, "text": "哔——停！我数到3才准动~" },
        // 连打：先来两次，第三次特意砸在「放弃」按钮上（赶在第 30 秒切后段之前）
        { "at": 20.5, "fx": "挑战-连打", "taps": 6, "time": 2.2, "pool": "挑战-登场-连打" },
        // 靴底预告：鞋底逼近到快贴上就收（踩中在片子第 1.5 秒，这里 1.3 秒就收掉）
        { "at": 25, "fx": "视频", "src": "clip-005-boots.e42f3dc2c1.mp4", "hold": 1.3, "side": "left", "text": "……还不是现在哦~" },
        { "at": 22.8, "fx": "挑战-连打", "taps": 8, "time": 2.2 },
        { "at": 27.6, "fx": "挑战-连打", "taps": 8, "time": 3, "place": "quit", "pool": "挑战-引诱放弃" },
        // 猛踩（站主 2026-09-24：冲击力还不够）：整屏的框、推到 3 倍，越来越快地踩过来，踩到头重重一下（peakHit）——
        // 那一刻（then：放到头就接着放）炸开一大片心，紧跟着一波五个点击
        {
          "at": 32, "fx": "特写-靴底", "variant": "猛踩",
          "then": [
            { "at": 0, "fx": "爱心爆发" },
            { "at": 0.35, "fx": "挑战-点击+点击+点击+点击+点击", "stagger": 0.12, "time": 3.2 }
          ]
        }
      ],
      "overtime": [
        // 数到 1 之后不数 0：秒数那一格一拍换一个言责词（后段节拍锁照走，每个词都落在一头）
        { "do": "words", "pool": "超时-言责", "seconds": 6, "every": 1 }
      ],
      "stage": {
        "early": { "charm": 0.16 },
        "mid": { "charm": 0.28 },
        "late": { "charm": 0.4 },
        "countdown": { "from": 5 },
        "challenge": {
          "in": ["early", "mid", "late"], "first": 8, "every": [4, 6],
          "kinds": { "点击": 2, "按住": 1, "连打": 2 },
          "点击": { "time": 1.9 }, "按住": { "time": 3.4, "hold": 1 }, "连打": { "time": 3, "taps": 7 }
        }
      }
    },
    // 第 3 组：深吻
    {
      "seconds": 45, "earlyEnds": 0.2666666667, "midEnds": 0.6666666667, "tempo": 1,
      // 镜头：呼吸时跟着吸（推近）呼（拉远）；闭眼时切到靴子，睁眼从靴子一路抬到脸；后段顶着数，言责词一个一个顶在脸上

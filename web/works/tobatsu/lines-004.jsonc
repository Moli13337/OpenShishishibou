// 讨伐任务 · 委托 004 · 随机台词（一决胜负 · 电子魅魔 Aschan；框架版，文案下一轮写）
//
// JSON 加注释（// 开头的行是注释，游戏读的时候会去掉）。每个池是一个数组，一句一个字符串，
// 用英文双引号括起来，句与句之间用英文逗号隔开。
// 游戏每次从池里随机取一句，同一个池不会连着两次取到同一句；池里至少写一句。
// 按顺序演的剧情对话不在这里，在 story-004.jsonc。拟声词（拟声-*）是各委托共用的，在 lines-common.jsonc。
//
// 字数上限按显示的位置算（手机 390px 宽）：
//   台词条   战斗画面角色图下面那一条，最多两行，每行约 20 字 → 上限 30 字
//   cut-in  贴纸大字，最多两行，每行约 9 字 → 上限 16 字
//   对话框   暂停画面的对话框，三行 → 上限 50 字
//   委托单   开场白放在委托书里，上限 40 字
// 超过上限不会报错，只会被截掉。
//
// 「建议句数」按默认参数（4 组 × 30 秒，节奏见 quest-004.jsonc）估算：句数够多，一整份委托里才不太会听到重复。
{
  // 委托开场 —— 进委托单时取一句，写在委托书里。建议 3 句，≤ 40 字
  "委托开场": ["这份委托，是Aschan特意为你写的哦……要好好收下♥", "初次任务时对你太温柔了呢。这次，Aschan想认真地让你输掉~", "撑过四组就算你赢……不过，你真的想赢吗？♥"],

  // 准备 —— 每组开始前的 3 秒准备倒数，台词条上取一句。建议 4 句，≤ 30 字
  "准备": ["握好『圣剑』……眼睛也要一直看着Aschan哦", "放轻松~ 越紧张，就越容易被Aschan吸进去哦", "准备好了吗？这一次，Aschan不会只是看着了", "深呼吸……然后，把注意力全部交给Aschan♥"],

  // 前段 —— 战斗中、前段每隔 lineEvery.early 秒换一句（每组第 0 秒说第一句）。
  // 默认一组 2 句、一份委托 8 句。建议 8 句，≤ 30 字
  "前段": ["这一次，Aschan会一直陪在你身边哦♥", "节奏很稳呢……还能稳多久呢？", "认真的表情，让Aschan更想欺负你了~", "初次任务的时候，你可没这么紧张呢♥", "想看就看吧……反正你会越看越输的", "慢慢来~ Aschan有的是时间陪你", "你专心的样子，Aschan很喜欢哦", "输给Aschan，一点都不丢人哦♥"],

  // 中段 —— 中段每隔 lineEvery.mid 秒换一句（进中段那一刻先放 cut-in，cut-in 收回后接着说）。
  // 默认一组 3 句、一份委托 12 句。建议 10 句，≤ 30 字
  "中段": ["呼吸乱了呢……Aschan全都听见了哦", "手忙脚乱的样子，好可爱♥", "刚才那一下，心跳漏了一拍吧？", "『圣剑』和眼睛，只能顾得上一边呢~", "越想赢，就越会被Aschan吸引哦", "视线又飘到不该看的地方了呢♥", "再靠近一点……让你没办法专心~", "嘴上说要赢，身体可一点都不配合哦", "Aschan在等你露出破绽呢……慢慢来♥", "好想快点看到你输掉的表情呀~"],

  // 后段 —— 后段每隔 lineEvery.late 秒换一句（同样先放 cut-in）。
  // 默认一组 2 句、一份委托 8 句。建议 8 句，≤ 30 字
  "后段": ["已经到极限了吧？认输会很舒服的哦♥", "手在发抖呢……还要继续逞强吗？", "最后这几秒，Aschan会把一切都给你♥", "只要一个失误，就全部结束了哦~", "看不清了吧？闭上眼睛，交给Aschan就好", "『圣剑』快要握不住了呢♥", "就这样输给Aschan吧……好不好？", "已经赢不了了哦……乖乖投降吧♥"],

  // cut-in·前→中 —— 前段走完、进中段的那一刻，贴纸大字切进画面，停一下收回。每组一次。建议 4 句，≤ 16 字
  "cutin-前到中": ["要开始认真了哦♥", "心跳乱了呢~", "还跟得上吗？♥", "再贴近一点~"],

  // cut-in·中→后 —— 中段走完、进后段的那一刻。每组一次。建议 4 句，≤ 16 字
  "cutin-中到后": ["快要输了吧♥", "别再逞强了哦~", "全部交出来吧♥", "该投降了呢~"],

  // 长按中 —— 按住放弃按钮的那一刻取一句，按住期间一直显示。建议 4 句，≤ 20 字
  "长按中": ["对……就这样慢慢按下去♥", "要把胜利交给Aschan了吗？", "乖孩子，再按久一点~", "输掉的感觉，很温柔哦♥"],

  // 松手 —— 按住放弃、没按满就松开时取一句。建议 4 句，≤ 20 字
  "松手": ["明明很想按下去的吧？♥", "嘴硬的样子也好可爱~", "差一点就属于Aschan了呢", "下次就别松开了哦♥"],

  // 放弃-前段 / 中段 / 后段 —— 战斗中放弃生效后的结算画面，按放弃时所在的阶段选池。各建议 3 句，≤ 30 字
  "放弃-前段": ["才刚开始就投降了呢……真是乖孩子♥", "Aschan还没认真，你就交出胜利了？", "这么快……是一开始就想输给Aschan吧？♥"],
  "放弃-中段": ["被Aschan迷得撑不下去了呢♥", "中途投降的你，也很可爱哦~", "嗯……这一场，是属于Aschan的了♥"],
  "放弃-后段": ["就差一点点……还是输给Aschan了呢♥", "最后松手的样子，好让人心动~", "坚持到这里很努力了哦。不过，你输了♥"],

  // 暂停 —— 组与组之间的暂停画面，她在对话框里说一句（嘲讽）。一份委托 3 次。建议 5 句，≤ 50 字
  "暂停": ["这一组算你撑过来了呢。下一组，Aschan会贴得更近一点哦♥", "比想象中还能忍嘛……这样的你，让Aschan更想认真击溃了~", "呼吸还没平复吧？没关系，下一组会让你更乱的♥", "刚才好几次，差一点就是Aschan的了呢。下一组可别再逃掉哦~", "眼睛有点花了？下一组，会让你更加移不开视线的♥"],

  // 撤退 —— 在暂停画面选了「撤退」之后的撤退结算画面（和战斗中放弃的「放弃-*」是两个画面、两个池）。建议 3 句，≤ 30 字
  "撤退": ["要走了吗？那这一场就算Aschan赢了哦♥", "逃走的背影，Aschan会好好记住的~", "下次再来吧……Aschan会等你回来认输哦♥"],

  // 败北 —— 战斗中出的挑战没在限时内完成（和放弃、撤退是三种结算）。写了「败北-点击」「败北-按住」「败北-拖动」「败北-顺序」就按题型用，没写用这个。建议 3 句，≤ 30 字
  "败北": ["抓到你了♥ 这一局，是Aschan赢了哦", "一次失误就结束了呢……认真的Aschan很可怕吧？", "慢了一点点呢~ 输给Aschan的感觉怎么样？"],
  "败北-点击": ["伸手慢了一拍呢……Aschan已经贴上来了♥", "犹豫了呢~ 被迷住的那一瞬间，就输了哦"],
  "败北-按住": ["一松手，就被Aschan压下去了呢♥", "没力气了？那就乖乖躺好吧~"],
  "败北-拖动": ["追不上了呢……Aschan就在前面等你哦♥", "停下来了？是舍不得追到Aschan吗~"],
  // 败北-顺序 —— 顺序题没点完 / 点错了数字。建议 2 句，≤ 30 字
  "败北-顺序": ["数乱了呢……满脑子都是Aschan吧？♥", "顺序错了哦~ 心已经不在这里了呢"],
  // 挑战-中诱饵 —— 顺序题里点到了深色的诱饵章：不算输，画面被她搅得一团混乱的那几秒里，台词条上她说的。建议 4 句，≤ 30 字
  "挑战-中诱饵": ["上钩了♥ 现在只看得见Aschan了吧？", "那是Aschan特意留给你的陷阱哦~", "头晕了吗？就这样沉下去吧♥", "看不清也没关系……Aschan就在这里哦"],
  // 败北-连打 —— 连打没在限时内打完。建议 2 句，≤ 30 字
  "败北-连打": ["挣不开呢……就这样被Aschan缠住吧♥", "没力气了？那就不要再挣扎了哦~"],

  // ================= 挑战（一决胜负）≤ 30 字 =================
  // 挑战-登场-<…> —— 那种题（或组合、变化）第一次出现时台词条上她说的。建议各 2 句
  "挑战-登场-点击": ["Aschan要靠近了哦……接得住吗？♥", "看清楚再伸手哦，不然会被抓住的~"],
  "挑战-登场-顺序": ["Aschan来倒数……你要好好跟上哦♥", "从大的开始，慢慢数给Aschan听~"],
  "挑战-登场-连打": ["被缠住了呢……想挣脱就用力吧♥", "Aschan可不会轻易放开你哦~"],
  "挑战-登场-点击+点击": ["两边都要顾好哦……很辛苦吧？♥", "一只手可不够用呢~"],
  // 顺序变成 4 枚（第 2 组开头）
  "挑战-登场-顺序4": ["再多数一个……别在Aschan面前数乱哦♥", "数字变多了呢，脑袋还清醒吗？"],
  "挑战-登场-按住": ["被Aschan按住了呢……可别松开哦♥", "撑住~ 一松手就是Aschan的了"],
  // 第 2 组：第一次「最后的 0 要按住」
  "挑战-登场-按住零": ["最后那一下，要好好按住才算数哦♥", "0可不会那么轻易给你哦~"],
  // 第 2 组：先出按住，一按下去就砸下 2、1、0
  "挑战-登场-按住陷阱": ["按住了？那这边，你要怎么办呢♥", "两只手都被Aschan占满了呢~"],
  // 第一次混进诱饵（深色心形章）
  "挑战-登场-诱饵": ["有些东西……碰了就回不去了哦♥", "看仔细，别被Aschan的陷阱骗了~"],
  "挑战-登场-拖动": ["Aschan要走了哦……追上来吧♥", "别跟丢了呢，Aschan会等你的~"],
  // 第 3 组三个点击接连砸在「放弃」按钮上
  "挑战-引诱放弃": ["累了吧？按这里……就能休息了哦♥", "那边有更舒服的选择呢~"],
  // 第 3 组最后：第一次翻面（数字几秒后变成「?」）
  "挑战-登场-翻面": ["记住了吗？下一秒就要藏起来了哦♥", "只给你看一眼……要好好记住哦"],
  // 第 4 组开头：从这里起顺序题全部翻面
  "挑战-第4组开场": ["最后一组……全部都要靠记忆了呢♥", "从现在开始，Aschan不会再给你看第二眼了哦"],
  "挑战-登场-点击+按住": ["按着这边，还要顾着那边……好贪心呢♥", "手够用吗？Aschan可不会等你哦~"],
  // 第 4 组第 31 秒的决胜题（6 个数字 + 4 枚诱饵，全翻面）
  "挑战-决胜": ["最后一次了哦……接住Aschan的全部吧♥", "赢了就能讨伐Aschan……你真的舍得吗？"],
  // 挑战-命中 —— 每做完一波她说一句。一份委托会出二三十波，建议 8 句，≤ 20 字
  "挑战-命中": ["唔……接住了呢", "反应真快呀♥", "嗯~ 有点心动了", "下一次可没这么简单哦", "居然没被迷住？", "这样的你更诱人了♥", "Aschan要更认真了哦", "还能撑多久呢~"],

  // ================= 败北处决（放弃 / 败北 / 撤退的结算里点「败北」之后）=================
  // 她数 10 秒，数到 0 就是彻底输掉的那一刻；数的时候没有操作。演出和秒数在 common.jsonc 的 execute
  // 处决-前言 —— 点了「败北」之后、开始数之前，台词条上按顺序一句一句说（不是随机抽；写几句说几句）。建议 2–3 句，每句 ≤ 30 字
  "处决-前言": ["结束了呢……是Aschan赢了哦♥", "那么，就由Aschan来温柔地给你最后一击吧~", "数到0的时候，要彻底认输给Aschan哦♥"],
  // 处决-cutin —— 前言说完、开始数之前的 cut-in 大字。建议 1–2 句，≤ 6 字
  "处决-cutin": ["认输吧♥"],
  // 处决-倒数 —— 每一秒在耳边数（浮现文字）。{n} 会换成剩下的秒数。建议 4 句，≤ 12 字
  "处决-倒数": ["{n}……", "{n}~♥", "还剩{n}哦~", "{n}……乖乖认输♥"],
  // 处决-心声 —— 剩 7 秒和 3 秒时主人公的心声（竖排）。建议 3 句，≤ 10 字
  "处决-心声": ["输了……", "被她迷住了……", "逃不掉了……"],
  // 处决-归零 —— 数到 0 的瞬间砸下来的紫黑大字。建议 2–3 句，≤ 8 字
  "处决-归零": ["完败♥", "你输了♥", "彻底败北♥"],
  // 处决-结算 —— 数完之后「彻底败北」画面的台词条。建议 2 句，≤ 30 字
  "处决-结算": ["完全输给Aschan了呢……下次也要来认输哦♥", "认真起来的Aschan，你忘不掉了吧？♥"],

  // 全部通过 —— 四组都撑完的结算画面（结局剧情之前）。建议 2 句，≤ 30 字
  "全部通过": ["……全部接住了呢。这样的你，让Aschan有点心动了", "四组都撑过来了？Aschan好不甘心……♥"],

  // 讨伐成功 —— 选了「给出最后一击」之后的胜利画面。建议 2 句，≤ 30 字
  "讨伐成功": ["Aschan输了……这一次，是真的输给你了哦", "下次，Aschan一定会让你心甘情愿地输♥"],

  // 无尽战斗 —— 选了「饶过魔物」之后的无尽战斗里，每隔 endless.lineEvery 秒换一句。建议 12 句，≤ 30 字
  "无尽战斗": ["不给最后一击……是想一直留在Aschan身边吗？♥", "这一场，不会有结束的时候哦~", "你每撑过一次，Aschan就再贴近一点♥", "放过对手的人，最后都会输掉哦", "明明赢了，却选了留下来陪Aschan呢~", "就这样，永远做Aschan的对手吧♥", "手还没累吗？那就继续陪Aschan~", "反应越来越慢了呢……好可爱♥", "想结束的话，认输就好了哦~", "胜负什么的，交给Aschan来决定吧♥", "你的眼里，已经只剩下Aschan了呢", "再多输一点……Aschan会很开心的♥"],

  // 无尽-放弃 —— 无尽战斗里放弃之后的结算画面。建议 3 句，≤ 30 字
  "无尽-放弃": ["终于认输了呢……这一场属于Aschan了♥", "果然还是想输给Aschan吧~", "明天也来陪Aschan吧♥"],
  // 无尽-败北 —— 无尽战斗里挑战失手之后的结算。建议 2 句，≤ 30 字
  "无尽-败北": ["接不住了呢……又是Aschan赢了♥", "失手了哦~ 再陪Aschan一局吧"],

  // ================= 插入演出（fx.js，common.jsonc 的 fx）=================
  // 下面这些都是短句，占位，站主换成正式台词。拟声词（拟声-*）各委托共用，在 lines-common.jsonc

  // 她的浮现文字（耳语 / 气泡 / 大字 / 思绪）默认从 lines-common.jsonc 的言责词库取（按 common.jsonc 的 speech.floats 混）；这份委托想单独写，就在这里另建池，再在演出表的 pools 里指过去
  // 竖排是主人公的心声，不是她说的：池在 lines-common.jsonc 的「心声」（这份委托想单独写，就在这里写同名的「心声」池）
  // 倒计时 —— 每组最后几秒她在耳边数。{n} 会换成剩下的秒数。建议 4 句，≤ 12 字
  "倒计时": ["{n}……撑得住吗", "还剩{n}哦~", "{n}♥", "{n}……别松懈哦"],
  // 特写-胸 / 特写-眼 —— 特写 cut-in 画框下面那行贴纸字。建议各 4 句，≤ 10 字
  "特写-胸": ["视线被抓住了♥", "这里不许看哦~", "心跳好快呢♥", "分心了吧？"],
  "特写-臀": ["在看哪里呢~", "被吸引了吧♥", "别被带走哦", "看了就会输哦"],
  "特写-眼": ["看着Aschan", "别移开视线♥", "被看穿了哦", "沉下去吧♥"],
  // 集中线 —— 集中线中间砸下来的大字。建议 4 句，≤ 6 字
  "集中线": ["输掉吧♥", "投降吧♥", "别逃哦♥", "看这里♥"],
  // 寸止-结束 —— 第 4 组决胜题之前寸止停完、接着动时的耳语（紧接着就是决胜题）
  "寸止-结束": ["来，决胜负吧♥"]
}

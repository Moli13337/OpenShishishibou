  },

  // ---------- 换着用的战斗图 ----------
  // 某几组（sets 的 standee）或无尽战斗（endless.standee）换成的图，一张一个档案。只认战斗相关的几块：
  // art.battleStandee（图、遮罩、战斗取景）、motion（立绘动态幅度）、fx.anchors（锚点）、fx.charm.visions.zoom、fx.closeup（特写取景），没写的沿用上面委托自己的档案。
  // 想单独调这张：地址加 ?standee=002-sit（调节器标题下点「换图 002-sit」，「立绘」「演出」页就是在调它，遮罩和特写取景按图分开存）
  "standees": {
    // 002-sit（assets/002-sit.png，1280 × 1720）：002 翘腿坐着、双手撑在身后。遮罩是脚本放的起步版（scripts/art/tobatsu-standee.mjs），遮罩 2 的 G 是晃腿的那条小腿。
    // 原图大致位置：脸 (660, 310)、胸 450–665、领带结 (640, 680)、肚脐 (650, 745)、交叠的大腿 820–1000、翘起那条腿的膝盖 (548, 975)、翘起的鞋 (230, 1350)、落地的鞋 (700, 1620)
    "002-sit": {
      "art": {
        "battleStandee": {
          "src": "her-002-sit.2690b37fe7.webp", "mask": "her-002-sit-mask.d86986e497.png", "mask2": "her-002-sit-mask2.3ef9f5bc31.png", "centerX": 660,
          "frames": { "idle": [100, 880], "early": [100, 900], "mid": [160, 860], "late": [230, 780], "win": [80, 980], "lose": [60, 1250], "retreat": [60, 1250], "endless": [180, 860] }
        }
      },
      "motion": {
        "cycle": { "amp": 13, "freeAmp": 6, "waistY": 775, "feather": 80 },
        "breathe": { "amp": 2.4 },
        "shake": { "maxOffset": 26, "impulse": { "cutin": 310, "art": 245, "heartbeat": 40 } },
        "hair": { "amp": 2.5 }
      },
      "fx": {
        // legs：晃腿特写画框的中心；knee：翘起那条腿的膝盖（小腿绕它转）
        "anchors": { "face": [660, 310], "eyes": [668, 288], "lips": [665, 338], "crest": [650, 770], "hips": [700, 915], "waist": [655, 745], "feet": [700, 1650], "legs": [330, 1220], "knee": [548, 975] },
        "eyeBar": { "center": [668, 287], "size": [210, 56], "angle": -7 },
        "charm": { "visions": { "zoom": { "chest": 250, "lips": 110, "eyes": 145 } } },
        // 臀部特写在坐姿上截右边的胯和压在上面的大腿；坐着不好整个身体绕脚转，bodyTwist 放小、扭动主要靠遮罩 2 那一块
        "closeup": {
          "chest": { "height": 290, "offset": [-25, -10], "impulse": 300, "maxOffset": 30, "loop": { "amp": 11 } },
          "chestSide": { "impulse": 180, "maxOffset": 20, "loop": { "amp": 15 } },
          "hips": { "side": "right", "sideOffset": 80, "height": 360, "offset": [0, 0], "bodyTwist": 0.0008, "torsoCounter": 1.2, "twist": 0.0022, "lift": 0.25, "impulse": 130, "maxOffset": 18, "radius": [230, 140], "loop": { "amp": 12 } },
          "eyes": { "height": 80, "offset": [0, 0], "eyeSpread": 51 },
          "legs": { "height": 600, "offset": [0, 0] }
        }
      }
    }
  }
}

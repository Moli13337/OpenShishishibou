// 讨伐任务 · 委托 002
//
// JSON 加注释（// 开头的行是注释）。这份只写这一份委托自己的东西，其余沿用 common.jsonc；
// 这里写了 common.jsonc 里同名的段（比如 "timing": { "holdToQuit": 2000 }）就盖过去。
// 台词在 lines-002.jsonc，剧情在 story-002.jsonc。
{
  // ---------- 委托单 ----------
  "quest": {
    // 编号：和文件名里的一样
    "id": "002",
    // 委托名：任务墙卡片的标题、委托单、战斗画面顶上
    "name": "讨伐·漂泊者",
    // 任务墙卡片的副标题（中文或英文，可不写）
    "subtitle": "Subjugation Quest #002 - [Kurasha]",
    // 任务等级：S / A / B / C / D / E（S 最高）。任务墙卡片上的贴纸，也决定格子大小（S 占 2×2、A 横 2 格、其余一格）
    "rank": "C",
    // 任务墙卡片与启动页：大约玩多久、一段说明
    "duration": "4 分钟",
    "description": "城外出现了来自异世界的漂泊者\n战斗能力不强，但大意的话有可能会败北",
    // 启动页 /quests/tobatsu/002 的「任务说明」（空一行＝分段）。站主写
    "detail": "在剑与魔法的世界观里，总是少不了突然闯入的来自异世界的漂泊者。\n\n为了防止她们乱七八糟的作弊技能扰乱这个世界的秩序，必须趁早将这些穿越过来的人赶回原本的世界。这次的对手是一个称号为【公会破坏者】的个体，推测战斗能力并不强，有经验的冒险者不难将其解决。\n\n对方并没有作战的经验，只要抓住破绽，一定能顺利地完成讨伐。不过相应地，如果错过了时机，你也有可能反过来被对方击败。",
    // 日语、英语版（任务墙、启动页的 /ja/…、/en/… 用）：name / duration / description / detail / tag / tagLong / unlockCondition，没写的沿用上面中文的
    "i18n": {
      "ja": {
        "name": "討伐・漂流者",
        "duration": "4分",
        "description": "異世界からの漂流者が街の外に現れた\n戦闘力は高くないが、油断すれば敗北もありうる",
        "detail": "剣と魔法の世界につきものなのが、ある日突然紛れ込んでくる異世界からの漂流者だ。\n\n彼女たちのでたらめなチートスキルがこの世界の秩序を乱す前に、流れ着いた者は早めに元の世界へ送り返さなければならない。今回の相手は【ギルドクラッシャー】の異名を持つ個体。戦闘力は高くないと見られ、経験のある冒険者なら難なく片付けられるだろう。\n\n相手に実戦経験はない。隙を突けば、討伐はきっと順調に終わる。ただしそのぶん、タイミングを逃せば逆にあなたが打ち負かされるかもしれない。",
        "tag": "チュートリアル"
      },
      "en": {
        "name": "Subjugation · Drifter",
        "duration": "4 min",
        "description": "A drifter from another world has appeared outside the city walls.\nNot much of a fighter — but get careless and you could still lose.",
        "detail": "No world of swords and sorcery is complete without drifters who suddenly stumble in from another world.\n\nBefore their absurd cheat skills throw this world's order into chaos, these arrivals need to be sent back where they came from — the sooner the better. This time your target goes by the title [Guild Crusher]. She's not expected to be much of a fighter, so any experienced adventurer should be able to deal with her.\n\nShe has no real combat experience. Catch her off guard and the job should go smoothly. Miss your moment, though, and you might be the one who ends up defeated.",
        "tag": "Tutorial"
      },
      // 韩语（2026-10-25 整本补译：AI 初稿，志愿者 Sszuad 检查中）
      "ko": {
        "name": "토벌·떠돌이",
        "duration": "4분",
        "description": "성 밖에 이세계에서 온 떠돌이가 나타났다\n전투력은 높지 않지만, 방심하면 패배할 수도 있다",
        "detail": "검과 마법의 세계에는 어느 날 갑자기 흘러들어 오는 이세계의 떠돌이가 빠지지 않는다.\n\n그들의 엉터리 치트 스킬이 이 세계의 질서를 어지럽히기 전에, 넘어온 자들은 서둘러 원래 세계로 돌려보내야 한다. 이번 상대는 【길드 크래셔】라는 칭호를 가진 개체. 전투력은 높지 않다고 추정되며, 경험 있는 모험가라면 어렵지 않게 처리할 수 있을 것이다.\n\n상대에게 실전 경험은 없다. 빈틈을 노리면 토벌은 분명 순조롭게 끝난다. 다만 그만큼, 타이밍을 놓치면 오히려 당신이 쓰러질 수도 있다.",
        "tag": "튜토리얼"
      }
    },
    // 委托类型：endurance＝耐久型（撑够时间）。节拍型（beat）以后做，现在写了也不认
    "type": "endurance",
    // 封面：drop/art/ 里的图名（不带扩展名），任务墙大卡、桌面详情卡用（站主画的 002-Q）
    "cover": "tobatsu-002",
    // 封面眼睛上的黑条（原图像素：中心、宽高、角度）。导入时贴上去再转图
    "coverBar": { "center": [1112, 546], "size": [300, 84], "angle": 9 },
    // 委托人：委托单上「委托人」那一栏
    "client": "城门卫兵团",
    // 她（讨伐对象）的名字：剧情对话里她的名牌。站主定
    "herName": "円 藏纱",
    // 成功报酬：委托单上委托人后面那枚药丸、任务墙的卡片 / 预览 / 详情卡（第一份委托的也显示在大厅「最近更新」）
    "reward": "800G",
    // 标签：任务墙卡片上的小药丸（站主 2026-10-19：001、002「教程」，原来的「互动」取消）；启动页「标签」栏没写 tagLong 就也写它
    "tag": "教程",
    // 动作栏固定写「自选」，后面跟一句建议
    "suggestion": "握力器",
    // 几组 × 每组多少秒（第 3、4 组在下面 sets 里写成 40 秒）
    "sets": 4,
    "seconds": 30
  },

  // ---------- 节奏指示器 ----------
  // 右侧一条竖轨，滑块上下来回。一次完整动作 = 上行（举起）→ 顶端停 → 下行（放下）→ 底端停
  // 速度倍率对四段一起生效：调快了，两端停留的时间也跟着按比例变短
  "rhythm": {
    // 用哪一套节奏（下面 presets 里的名字）。?dev=1 面板上可以临时切换。
    // 细调和存档位用 tuner.html；在那里「设为本机默认」的档位，这台设备上会盖过这一项
    // 002 用握力器（站主定）
    "use": "握力器",
    "presets": {
      "哑铃": {
        // 委托单动作栏里的建议（不写就用上面 quest.suggestion）
        "suggestion": "举轻哑铃",
        // 往返区间：轨道上的上端和下端（0＝轨道最上、1＝最下）
        "rangeTop": 0.1,
        "rangeBottom": 0.9,
        // 各段秒数：上行 / 顶端停 / 下行 / 底端停
        "up": 0.8,
        "top": 0.2,
        "down": 1.0,
        "bottom": 0.2,
        // 速度倍率（按阶段）。1 = 按上面的秒数；1.4 = 快四成
        "speed": { "early": 1.0, "mid": 1.35, "late": 1.75 }
      },
      "握力器": {
        "suggestion": "握力器",
        "rangeTop": 0.15,
        "rangeBottom": 0.85,
        "up": 0.35,
        "top": 0.08,
        "down": 0.42,
        "bottom": 0.08,
        "speed": { "early": 1.0, "mid": 1.5, "late": 2.1 }
      }
    }
  },

  // ---------- 002 的设计（站主定框架，Claude Code 补细节；2026-09-17 第二版）----------
  // 从 002 开始有挑战：战斗中突然出题，限时内完成才能接着撑，失手一次就败北。
  // 不教、不提示（站主：失败一次玩家自己就懂了，这样才紧张）——章上没有说明，剧情和台词只浅浅暗示；每种题第一次出现是定时的，限时比之后宽一点点，但看不出来。
  //   第 1 组  30 秒 · 站姿 · 点击。第 7 秒第一次点击，中后段随机点击
  //   第 2 组  30 秒 · 坐姿（002-sit）· 点击更勤；第 25 秒第一次「同时两个点击」
  //   第 3 组  40 秒 · 站姿 · 点击 + 按住。第 5 秒第一次按住；随机里有点击、按住、同时两个点击
  //   第 4 组  40 秒 · 坐姿 · 三种都有。第 5 秒第一次拖动、第 19 秒三个点击接连砸在「放弃」按钮上（引诱你按放弃）、第 28 秒点击 + 按住同时出；随机里有三种单题和点击+点击 / 点击+按住 / 点击+拖动
  //   无尽战斗  坐姿，单题和组合都出
  // 镜头（站主：不要从全身远景推过去，画面里空、单调）：一律中近景，她占满画面；段内慢慢摇（沿身体上下移），切段硬切换一个部位——
  //   脸和胸 / 腰胯和大腿 / 腿和鞋（坐姿）轮换；组中间的硬切才带闪。特写穿插在镜头不在那个部位的时候（比如镜头在上半身时插晃腿特写）
  // 心章 002 不出（站主定）。
  // 角色（站主定，2026-09-17）：円 藏纱，异世界漂过来的辣妹，称号【公会破坏者】，主打「背叛诱惑」。言责线和台词条里按权重混进 lines-002.jsonc 的「言责-背叛」，
  // 没指定池的浮现文字、心声也混（下面的 speech）。开场多一个选择：放过她＝直接进无尽战斗（story-002.jsonc 的「开场选择」）

  // ---------- 每组 ----------
  // 按组覆盖（第 1 组是第一个 {}）：
  //   seconds 这组多少秒；earlyEnds / midEnds 分段点（占这组秒数的比例）；tempo 节奏快慢倍数（乘在档位速度上）
  //   standee 这一组换成哪张战斗图（下面 standees 段里的名字）：这一组的准备、战斗、通过与败北结算用它，剧情和暂停画面还是委托自己的立绘
  //   tip 准备倒数时横在画面上的提示（『』里的词标亮）；prep 准备时台词条的池；pause 这组撑完之后暂停画面的台词池
  //   camera  镜头：按秒的关键帧 [{ "at": 秒, "frame": [上沿, 下沿], "centerX": 中线 }]，原图像素（换了战斗图的组按那张图算）；
  //           不写＝缓进缓出、"ease": "linear"＝匀速、"cut": true＝到点一下切过来（"flash": true 切的时候闪一下）
  //   script  定时演出：[{ "at": 秒, "fx": 演出名, "text" / "pool", "hold" }]；
  //           "fx": "挑战-点击" / "挑战-按住" / "挑战-拖动"（同时出几题写 "挑战-点击+按住"）＝到点一定出：time 限时、hold 按满几秒、pool 出题时她说的、
  //           place: "quit" 章砸在「放弃」按钮上、stagger 一题接一题隔几秒砸下来
  //   stage   这一组的演出表（按格盖在下面的 stage 上）；挑战格 kinds 里写 "点击+点击": 1 这种＝同时出几题
  "sets": [
    {
      "earlyEnds": 0.4, "midEnds": 0.8, "tempo": 0.85,
      "tip": "按照节奏挥舞『圣剑』，并且抓住机会进行攻击吧",
      "prep": "准备-第1组", "pause": "暂停-第1组后",
      "camera": [
        { "at": 0, "frame": [40, 860], "centerX": 480 },
        { "at": 12, "frame": [170, 970], "centerX": 470, "ease": "linear" },
        { "at": 12.05, "frame": [420, 1120], "centerX": 465, "cut": true },
        { "at": 24, "frame": [330, 1030], "centerX": 475, "ease": "linear" },
        { "at": 24.05, "frame": [110, 760], "centerX": 490, "cut": true },
        { "at": 30, "frame": [150, 720], "centerX": 490 }
      ],
      "script": [
        { "at": 3, "fx": "气泡", "pool": "言责-褒奖" },
        { "at": 7, "fx": "挑战-点击", "time": 3.5, "pool": "挑战-登场-点击" },
        { "at": 16, "fx": "特写-胸" },
        { "at": 27, "fx": "耳语", "pool": "言责-勾引" }
      ],
      "stage": {
        "early": {
          "line": "第1组-前段", "lineEvery": 5, "charm": 0.04, "every": 0, "fx": {},
          "talk": { "every": 6, "fx": { "耳语": 1 }, "pools": { "耳语": { "言责-褒奖": 2, "言责-贬损": 1, "言责-背叛": 2 } } }
        },
        "mid": {
          "line": "第1组-中段", "lineEvery": 4.5, "charm": 0.1, "every": 7, "fx": { "拟声": 1, "吐息": 1 },
          "talk": { "every": 4.5, "everyTo": 3.5, "fx": { "耳语": 2, "气泡": 1 }, "pools": { "耳语": { "言责-褒奖": 2, "言责-贬损": 2, "言责-背叛": 2 }, "气泡": { "言责-褒奖": 2, "言责-背叛": 1 } } }
        },
        "late": {
          "line": { "第1组-后段": 2, "言责-褒奖": 1, "言责-背叛": 1 }, "lineEvery": 4, "charm": 0.18, "every": 5.5, "fx": { "吐息": 1, "唇印": 1, "特写-胸-横": 1 },
          "talk": { "every": 3.5, "everyTo": 2.8, "fx": { "耳语": 2, "气泡": 1, "竖排": 1 }, "pools": { "耳语": { "言责-贬损": 2, "言责-褒奖": 1, "言责-勾引": 1, "言责-背叛": 1 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 1, "言责-背叛": 1 } } }
        },
        "top": { "every": 0 },
        "beat": { "every": 0 },
        "countdown": { "from": 3, "boost": 0.03 },
        "challenge": { "in": ["mid", "late"], "first": 14, "every": [6, 9], "kinds": { "点击": 1 }, "点击": { "time": 2.8 } }
      }
    },
    {
      "standee": "002-sit",
      "earlyEnds": 0.4, "midEnds": 0.75, "tempo": 0.95,
      "tip": "如果在限定时间内没能完成动作，就会导致讨伐失败",
      "prep": "准备-第2组", "pause": "暂停-第2组后",
      "camera": [
        { "at": 0, "frame": [110, 880], "centerX": 660 },
        { "at": 12, "frame": [60, 830], "centerX": 700, "ease": "linear" },
        { "at": 12.05, "frame": [620, 1260], "centerX": 630, "cut": true },
        { "at": 22.5, "frame": [720, 1360], "centerX": 560, "ease": "linear" },
        { "at": 22.55, "frame": [860, 1500], "centerX": 380, "cut": true },
        { "at": 26, "frame": [820, 1460], "centerX": 400 },
        { "at": 26.05, "frame": [140, 820], "centerX": 670, "cut": true, "flash": true },
        { "at": 30, "frame": [180, 780], "centerX": 670 }
      ],
      "script": [
        { "at": 3, "fx": "耳语", "pool": "言责-勾引" },
        { "at": 9, "fx": "特写-腿" },
        { "at": 17, "fx": "竖排" },
        { "at": 25, "fx": "挑战-点击+点击", "pool": "挑战-登场-点击+点击" },
        { "at": 27.5, "fx": "特写-眼" }
      ],
      "stage": {
        "early": {
          "line": "第2组-前段", "lineEvery": 5, "charm": 0.08, "every": 8, "fx": { "拟声": 1, "吐息": 1 },
          "talk": { "every": 4.5, "everyTo": 4, "fx": { "耳语": 2, "气泡": 1 }, "pools": { "耳语": { "言责-褒奖": 2, "言责-勾引": 1, "言责-背叛": 1 }, "气泡": { "言责-褒奖": 2, "言责-背叛": 1 } } }
        },
        "mid": {
          "line": { "第2组-中段": 2, "言责-褒奖": 1, "言责-背叛": 1 }, "lineEvery": 4, "charm": 0.18, "every": 6, "everyTo": 5, "fx": { "吐息": 1, "唇印": 1, "特写-胸": 1 },
          "talk": { "every": 3.5, "everyTo": 2.8, "fx": { "耳语": 2, "竖排": 1, "气泡": 1 }, "pools": { "耳语": { "言责-贬损": 2, "言责-褒奖": 1, "言责-勾引": 1, "言责-背叛": 1 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 1, "言责-背叛": 1 } } }
        },
        "late": {
          "line": { "第2组-后段": 2, "言责-勾引": 1, "言责-背叛": 1 }, "lineEvery": 3.5, "charm": 0.28, "every": 5, "everyTo": 4, "fx": { "特写-胸": 2, "特写-胸-横": 1, "魅惑闪光": 1, "吐息": 1 },
          "talk": { "every": 3, "everyTo": 2.2, "fx": { "耳语": 3, "气泡": 1, "竖排": 1, "思绪": 1 }, "pools": { "耳语": { "言责-贬损": 1, "言责-褒奖": 1, "言责-勾引": 2, "言责-背叛": 2 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 1, "言责-背叛": 1 }, "思绪": { "言责-勾引": 2, "言责-背叛": 1 } } }
        },
        "top": { "every": 0 },
        "beat": { "every": 8 },
        "countdown": { "from": 3, "boost": 0.04 },
        "challenge": { "in": ["early", "mid", "late"], "first": 5, "every": [5, 8], "kinds": { "点击": 1 }, "点击": { "time": 2.6 } }
      }
    },
    {
      "seconds": 40, "earlyEnds": 0.3, "midEnds": 0.7, "tempo": 1,
      "tip": "除了『点击』之外，可能还需要更多不同的操作方式",
      "prep": "准备-第3组", "pause": "暂停-第3组后",
      "camera": [
        { "at": 0, "frame": [1080, 1610], "centerX": 480 },
        { "at": 12, "frame": [880, 1440], "centerX": 470, "ease": "linear" },
        { "at": 12.05, "frame": [480, 1110], "centerX": 450, "cut": true },
        { "at": 28, "frame": [400, 1040], "centerX": 470, "ease": "linear" },
        { "at": 28.05, "frame": [90, 780], "centerX": 485, "cut": true },
        { "at": 34, "frame": [140, 720], "centerX": 490 },
        { "at": 34.05, "frame": [500, 1100], "centerX": 460, "cut": true, "flash": true },
        { "at": 40, "frame": [540, 1060], "centerX": 460 }
      ],
      "script": [
        { "at": 5, "fx": "挑战-按住", "time": 5, "hold": 1.2, "pool": "挑战-登场-按住" },
        { "at": 9, "fx": "竖排" },
        { "at": 20, "fx": "特写-臀" },
        { "at": 31, "fx": "特写-胸-横" },
        { "at": 37, "fx": "耳语", "pool": "言责-勾引" }
      ],
      "stage": {
        "early": {
          "line": "第3组-前段", "lineEvery": 5, "charm": 0.12, "every": 8, "fx": { "拟声": 1, "吐息": 1 },
          "talk": { "every": 4, "everyTo": 3.5, "fx": { "竖排": 2, "耳语": 2 }, "pools": { "耳语": { "言责-褒奖": 2, "言责-贬损": 2, "言责-背叛": 2 } } }

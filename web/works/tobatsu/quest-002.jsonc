  // ---------- 演出表 ----------
  // 战斗里什么时候放什么。一格管一个时机，随机只在这一格里抽（各格写法见 quest-001.jsonc 的注释、README「演出表」）。
  // 这张表是四组共用的底（每组在上面 sets 里按格改）和无尽战斗
  // 挑战 challenge：in 哪几段出、every [最短, 最长] 秒一波、first 这组第几秒起、kinds 题型权重（"点击+按住" 这种＝同时出几题）、点击 / 按住 / 拖动 的 time（hold）、
  //   comboTime 同时出几题时每题限时乘多少、onMiss defeat＝失手败北、showLine 出题时台词条的池、hitLine 一波做完时台词条的池
  "stage": {
    "first": 4, "jitter": 0.35,
    "early": { "line": "前段", "lineEvery": 6, "charm": 0.05, "every": 9, "fx": { "拟声": 2, "吐息": 1 } },
    "mid": { "line": "中段", "lineEvery": 5, "charm": 0.2, "every": 6, "fx": { "吐息": 2, "唇印": 1, "特写": 1 } },
    "late": { "line": "后段", "lineEvery": 4, "charm": 0.35, "every": 4.5, "fx": { "特写": 2, "魅惑闪光": 1, "吐息": 1 } },
    "endless": {
      "line": { "无尽战斗": 1, "言责-勾引": 2, "言责-贬损": 1, "言责-背叛": 2 }, "lineEvery": 5, "charm": 1, "every": 4, "fx": { "拟声": 2, "魅惑闪光": 2, "特写-胸": 1, "特写-胸-循环": 2, "特写-胸-横": 1, "特写-臀": 1, "特写-眼": 1, "特写-腿": 1, "特写-腿-循环": 1, "集中线": 2, "吐息": 1 },
      "talk": { "every": 2.2, "fx": { "耳语": 3, "气泡": 2, "竖排": 1, "思绪": 1, "大字": 1 }, "pools": { "耳语": { "言责-贬损": 1, "言责-褒奖": 1, "言责-勾引": 2, "言责-背叛": 2 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 2, "言责-背叛": 2 }, "思绪": { "言责-勾引": 1, "言责-贬损": 1, "言责-背叛": 1 }, "大字": { "言责-贬损": 1, "言责-勾引": 1, "言责-背叛": 1 } } }
    },
    "toMid": { "cutin": "cutin-前到中", "side": "right", "ono": "拟声-摇", "delay": 500, "fx": { "拟声-摇": 1 } },
    "toLate": { "cutin": "cutin-中到后", "side": "left", "ono": "拟声-摇", "delay": 500, "fx": { "拟声-摇": 1 } },
    "top": { "burst": true, "every": 0, "fx": {} },
    "bottom": { "every": 0, "fx": {} },
    "beat": { "in": ["late"], "every": 6, "fx": { "拟声-心跳": 1 } },
    "countdown": { "from": 5, "line": "倒计时", "boost": 0.07, "at": [1], "fx": { "拟声-魅惑": 1 } },
    "press": { "line": "长按中" },
    "release": { "line": "松手", "min": 0.2, "boost": 0.3, "delay": 200, "fx": { "大字": 1, "魅惑闪光": 1 }, "pools": { "大字": { "言责-贬损": 1, "言责-勾引": 1, "言责-背叛": 1 } } },
    // 挑战：四组各自在 sets 里写；这里是无尽战斗（单题和组合都出）和各组没写的字段
    "challenge": {
      "in": ["endless"], "first": 8, "every": [4.5, 7],
      "kinds": { "点击": 2, "按住": 1, "拖动": 1, "点击+点击": 1, "点击+按住": 1, "点击+拖动": 1 },
      "onMiss": "defeat", "hitLine": "挑战-命中"
    }
  },

  // ---------- 奖励 ----------
  // 「命令」下面的「遵命」按钮（点不点都行）：点了放一段奖励 cut-in，平时不放。写法见 quest-001.jsonc 的 reward。
  // 002 只有「开场放过她」那条无尽战斗会出命令：收下的是共犯的好处。现在是站姿立绘推近到脸 + 唇印
  "reward": {
    "cutins": [
      { "still": "her-002.127e042ddf.webp", "focus": [490, 282], "zoom": [3.3, 3.7], "side": "left", "hold": 2.6, "outro": "kiss", "pool": "奖励" }
    ]
  },

  // ---------- 言责 ----------
  // 盖在 common.jsonc 的 speech 上：没指定池的耳语 / 气泡 / 大字 / 思绪混进「言责-背叛」，竖排（主人公心声）混进「心声-背叛」；
  // 两个新池加后缀（w ~ ♥ …）的规则
  "speech": {
    // 她的自称：共用言责词库里的「我」换成「人家」
    "self": "人家",
    // 共用言责按角色增删（站主 2026-10-13）：skip 是这份委托不说的（照 lines-common.jsonc 的原句写），add 是按她的口吻另加的
    "skip": ["这是命令", "败北许可", "好恶心", "真是废物", "丢人的东西", "真是可悲", "奴隶预备役"],
    "add": {
      "言责-褒奖": ["不愧是人家看中的哥哥", "忍着的样子好可爱", "人家最喜欢听话的哥哥了", "对，再让人家多看一点"],
      "言责-勾引": ["输给人家又不丢人", "人家准你输哦", "输掉的事也替哥哥保密", "在这里出来，谁也不会知道", "就为人家输一次嘛"],
      "言责-贬损": ["哥哥好逊哦", "这样也算冒险者吗", "脸都红透了啦", "嘴上说讨伐，手倒很老实", "哥哥真的好好骗"]
    },
    "floats": {
      "耳语": { "言责-贬损": 1, "言责-褒奖": 1, "言责-勾引": 1, "言责-背叛": 2 },
      "气泡": { "言责-褒奖": 1, "言责-勾引": 1, "言责-背叛": 2 },
      "大字": { "言责-贬损": 2, "言责-勾引": 1, "言责-背叛": 1 },
      "思绪": { "言责-勾引": 1, "言责-褒奖": 1, "言责-贬损": 1, "言责-背叛": 1 },
      "竖排": { "心声": 2, "心声-背叛": 1 }
    },
    "suffix": {
      "pools": {
        "言责-背叛": { "~": 3, "♥": 3, "w": 2, "~♥": 2 },
        "心声-背叛": { "…": 4, "……": 2 }
      },
      "byPhase": {
        "late": { "言责-背叛": { "~~♥": 2, "♥♥": 2, "ww": 1 } },
        "endless": { "言责-背叛": { "~~♥♥♥": 3, "♥♥": 2 } }
      }
    }
  },

  // ---------- 无尽战斗 ----------
  // 两条路进来（站主定，2026-09-17）：
  //   最后一击选「帮忙写信大力推荐」→ 下面这一段本身：坐姿图（002-sit），单题和组合都出（演出表 stage.endless / challenge）
  //   开场选「悄悄放过她」→ routes["开场-放过"]：委托自己的站姿立绘，不出任何题（玩家这时候还没见过点击这些操作）
  // standee：用哪张战斗图（standees 段里的名字；"" 或不写＝委托自己的立绘）
  // camera：镜头关键帧，写法同 sets，按最后一帧的秒数循环（最后一帧写成和第一帧一样就接得上）
  // stage：盖在演出表上的格（这条路线自己的）
  "endless": {
    "standee": "002-sit",
    // 坐姿：上半身慢慢推 → 硬切交叠的大腿往下摇 → 硬切翘起的鞋 → 带闪切回上半身，40 秒一圈
    "camera": [
      { "at": 0, "frame": [120, 860], "centerX": 670 },
      { "at": 10, "frame": [180, 800], "centerX": 680 },
      { "at": 10.05, "frame": [600, 1240], "centerX": 630, "cut": true },
      { "at": 20, "frame": [700, 1340], "centerX": 560, "ease": "linear" },
      { "at": 20.05, "frame": [860, 1500], "centerX": 380, "cut": true },
      { "at": 28, "frame": [800, 1440], "centerX": 420 },
      { "at": 28.05, "frame": [150, 820], "centerX": 680, "cut": true, "flash": true },
      { "at": 40, "frame": [120, 860], "centerX": 670 }
    ],
    "routes": {
      "开场-放过": {
        "standee": "",
        // 站姿：脸和胸慢慢推 → 硬切腰胯大腿往上摇 → 硬切膝盖袜子往上摇 → 带闪切回脸和胸，40 秒一圈
        "camera": [
          { "at": 0, "frame": [60, 860], "centerX": 480 },
          { "at": 10, "frame": [140, 780], "centerX": 485 },
          { "at": 10.05, "frame": [460, 1120], "centerX": 465, "cut": true },
          { "at": 20, "frame": [380, 1040], "centerX": 470, "ease": "linear" },
          { "at": 20.05, "frame": [1060, 1600], "centerX": 480, "cut": true },
          { "at": 28, "frame": [880, 1440], "centerX": 470, "ease": "linear" },
          { "at": 28.05, "frame": [110, 760], "centerX": 490, "cut": true, "flash": true },
          { "at": 40, "frame": [60, 860], "centerX": 480 }
        ],
        // 不出题；坐姿专用的晃腿特写换成站姿的
        "stage": {
          "challenge": { "in": [] },
          // 命令：叫你在现实里做一个动作（lines-002 的「命令」，当共犯的口吻），下面带「奖励」按钮（见 reward）
          "endless": { "fx": { "拟声": 2, "魅惑闪光": 2, "特写-胸": 1, "特写-胸-循环": 2, "特写-胸-横": 1, "特写-臀": 1, "特写-臀-循环": 1, "特写-眼": 1, "集中线": 2, "命令": 2, "吐息": 1 } }
        }
      }
    }
  },


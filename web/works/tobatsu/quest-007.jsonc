// 讨伐任务 · 委托 007 · 公会柜台（四组玩法初版，2026-10-17）
//
// 主轴（第二版起，站主：掉级要是玩家自己选的）：四组都一样，秒数走到 0 先盖「通过」，这一组不结束（超时步骤 do: "stay"，game.js）——
//   她劝他多留一会儿，「长按放弃」换成「长按通过」，按满才走；留着的时候每隔几秒秒数往下数一格、交出一级（card.js），越留越快。
//   刚通过那一阵先把话说完（intro）再开始扣；扣的时候秒数每秒跳一下、扣那一下跳得大，卡上的等级被吸到她身上。
// 四组初版（站主 2026-10-17 的框架，Claude Code 补的细节）：
//   1 登记——常规的等级榨取 + 简单的题（点击、按住；失手扣一级）
//   2 私人升级辅导——交易单（点「成交」多交几级，换一段亲过来的特写 + 等级被一级一级吸走）；连打打完露出「接受榨取」，多点一下就被吸；
//     胸部循环特写开着的时候，从冒险者卡沿着曲线拖进特写里（失手扣一级）；
//     第 30 秒换成趴在柜台上往前探的那张（007-a），这一组的结尾和逗留都在这张上
//   3 翘腿——整组是翘着腿坐在高脚凳上的那张（007-b），踩踏为主、口气更像命令：高跟鞋印从画面别处一步一步踩向卡片，点掉没事、踩到卡上扣一级；
//     靴底特写（鞋底跟着「压」一下一下踩过来）
//   4 最后一组——前面的全上，镜头在三张图之间切；中间两次趁整屏的大图挡住画面把卡挪个地方（挪卡），后面的鞋印往新的位置去
// 第五轮（站主 2026-10-19）：委托单、开场按站主写的；题失手＝败北；第 2–4 组到 0 就开始吸，按「长按通过」时她会打断（pressLure）；
//   奖杯「一级都不给」；节奏轨上端 0.05、下端 0.8
// 第六轮（站主 2026-10-19 第二批）：第 1 组 0 之后短一半；打断只在吸过一级之后（奖杯改名「我的等级由我保护」）；
//   第 2 组挡在长按条上、第 3 组贴脸的鞋底 + 大鞋印、第 4 组按得慢 + 挡住进度条；第 4 组挪卡到右下、再到中间（鞋印四面八方）
// 卡跟着等级变：C → D → E → M 每降一档换一种样子（唇印、粉卡、紫黑卡），称号一路从「弱小冒险者」到「收藏预定品」，
//   名字先加上「M奴隶·」、最后连名字都没了，变成「等级罐子 No.xxxxx」（card 段）。
// 台词在 lines-007.jsonc，剧情在 story-007.jsonc（文案第二版 2026-10-18：照 006 那次的做法整体重写——更色气、不讲规则、不幼稚；
//   每组各段的 talk 换成这一组自己的耳语 / 心声池）。
{
  // ---------- 委托单 ----------
  "quest": {
    "id": "007",
    "name": "讨伐·公会柜台",
    "subtitle": "Subjugation Quest #007 - [Receptionist]",
    "rank": "C",
    "duration": "6 分钟",
    "description": "最近很多刚登记的新人冒险者因为等级下降而退会\n我们需要请志愿者装成新人来潜入调查，试着查明原因",
    "detail": "这是一个Aschan偷偷塞给你的指名委托，看上去似乎是一个内部调查的任务。\n\n近一段时间，出现了不少新人冒险者短期退出的情况。虽然公会的人员流动本身也是很正常的，但是退出的新人冒险者，往往等级会比原本还要低。\n\n为了查清到底出了什么问题，Aschan特意委托还没有跟大家很熟悉的你，找一个她不在的时间来假装新人冒险者重新来公会登记，看看会遇到什么问题。",
    // 日英版的委托单（任务墙、启动页、游戏里的委托书）：没写的字段沿用中文
    "i18n": {
      "ja": {"name":"討伐・ギルド受付","duration":"6分","description":"最近、登録したばかりの新人冒険者がレベルを下げて退会する件が相次いでいる\n新人になりすました志願者に潜入調査してもらい、原因を突き止めたい","detail":"これは Aschan がこっそり手渡してきた指名依頼。どうやら内部調査の任務らしい。\n\nここしばらく、新人冒険者が短期間で辞めていくケースが少なくない。ギルドで人が出入りすること自体は珍しくもないが、辞めていく新人たちは、決まって元よりもレベルが下がっているのだという。\n\n何が起きているのかを突き止めるため、Aschan はまだ皆とあまり顔なじみのないあなたに頼んだ。彼女のいない時間に、新人冒険者のふりをしてギルドに登録し直し、何が起きるのか確かめてほしい——と。","unlockCondition":"「討伐・はじめての依頼」をクリア"},
      "en": {"name":"Subjugation · Guild Counter","duration":"6 min","description":"Lately, many newly registered adventurers have been quitting after losing levels.\nWe need a volunteer to pose as a newcomer, go undercover, and find out why.","detail":"This is a named quest Aschan slipped to you in secret. It seems to be an internal investigation.\n\nFor a while now, quite a few newcomers have quit the guild after only a short time. People coming and going is nothing unusual for a guild—but the newcomers who quit always seem to leave with a lower level than they started with.\n\nTo get to the bottom of it, Aschan asked you—someone the others don't know well yet—to re-register at the guild posing as a newcomer while she's away, and see what happens.","unlockCondition":"Clear \"Subjugation · First Quest\""},
      // 韩语（2026-10-25 整本补译：AI 初稿，志愿者 Sszuad 检查中）
      "ko": {"name":"토벌·길드 창구","duration":"6분","description":"최근 갓 등록한 초보 모험가들이 레벨이 떨어진 채 탈퇴하는 일이 잇따르고 있다\n신입으로 위장해 잠입 조사할 지원자를 구해, 원인을 밝혀내려 한다","detail":"이것은 Aschan이 몰래 건네준 지명 의뢰다. 보아하니 내부 조사 임무인 듯하다.\n\n최근 한동안, 초보 모험가가 단기간에 그만두는 일이 적지 않다. 길드에 사람이 들고 나는 것 자체는 흔한 일이지만, 그만두는 신입들은 늘 원래보다 레벨이 낮아져 있다고 한다.\n\n무슨 일이 벌어지는지 밝혀내기 위해, Aschan은 아직 사람들과 얼굴을 익히지 못한 당신에게 부탁했다. 그녀가 없는 시간을 골라 초보 모험가인 척 길드에 다시 등록하고, 무슨 일이 생기는지 확인해 달라고.","unlockCondition":"'토벌·첫 의뢰' 클리어"}
    },
    // 本机解锁（站主 2026-10-19 上墙时定）：通过初次任务才解锁，同 004
    "unlock": { "after": "001", "condition": "通过「讨伐·初次任务」" },
    "type": "endurance",
    // 封面＝007-Q（站主 2026-10-19 放进 assets，拷成 drop/art/tobatsu-007.png）
    "cover": "tobatsu-007",
    "coverBar": { "center": [1001, 513], "size": [290, 80], "angle": -21 },
    "client": "Aschan",
    // 她的名字（Claude Code 起的，站主可以改）：莉薇尔——「Lv」藏在名字里
    "herName": "莉薇尔",
    "reward": "1000G",
    "suggestion": "握力器",
    "sets": 4,
    "seconds": 40,
    // 奖杯：一级等级都没被吸走就全部通过（when: untouched，card.js 的 cardFull）
    "trophies": [{ "id": "untouched", "name": "我的等级由我保护", "desc": "一级等级都没有被吸走，完成讨伐·公会柜台", "when": "untouched" }],
    // 救济（站主 2026-10-20）：这台设备累计彻底败北 5 次，问他承不承认自己是「姐姐的储蓄罐」，承认了解锁「重来这一组」（等级回到那一组开打时）；
    // 剧情在 story-007 的「救济」「救济选择」「救济-承认」「救济-拒绝」。无敌模式是每份委托都有的（common.jsonc 的 relief.invincible，累计 20 次）
    "relief": { "after": 5 }
  },

  // ---------- 冒险者卡（card.js）----------
  // 一局从 start 级开始、跨组继承，降到 0＝败北（卡被她收走）
  "card": {
    "start": 30,
    "xp": 10,
    // 被动吸取停掉（第一版每一下「压」都吸，站主嫌不可控）；无尽里照旧慢慢吸
    "drain": { "early": 0, "mid": 0, "late": 0, "endless": 0.4 },
    "held": 2.5,
    // 题失手扣几级（演出表 challenge.onMiss: "card"）
    "miss": 1,
    // 冒险者等级：几级以上是什么；卡的样子也按这一格换（C 干净 → D 唇印 → E 粉卡 → M 紫黑的卡）
    "ranks": [[24, "C"], [16, "D"], [8, "E"], [1, "M"]],
    // 称号：这一局交出去几级以上是什么（一路往重了走）
    "titles": [[0, "新人冒险者"], [3, "弱小冒险者"], [6, "柜台的常客"], [10, "莉薇尔的储蓄罐"], [13, "自愿上供的杂鱼"], [17, "被吸到上瘾"], [21, "变态败北癖"], [25, "等级罐子预备役"], [28, "收藏预定品"]],
    // 名字：交出去 18 级加上「M奴隶·」，26 级连名字都没了（{no}＝她的收藏编号，和处决时盖的「回收 No.」同一个数）
    "names": [[18, "M奴隶·{name}"], [26, "等级罐子 No.{no}"]],
    // 收藏编号从几开始（加上这台设备被收走过几张）。等级罐子 No. 是假的计数：只算这台设备，不是全站的人数
    "collection": 12847
  },

  // ---------- 节奏指示器 ----------
  "rhythm": {
    "use": "握力器",
    "presets": {
      "握力器": {
        "suggestion": "握力器",
        "rangeTop": 0.05,
        "rangeBottom": 0.8,
        "up": 0.35,
        "top": 0.08,
        "down": 0.42,
        "bottom": 0.08,
        "speed": { "early": 1, "mid": 1.5, "late": 2.1 }
      }
    }
  },

  // ---------- 挑战的公共规矩 ----------
  "challenge": { "gap": 3, "quiet": 3 },

  // 「命令」砸上来的那一下画面压暗一拍（整份委托只有第 1 组逗留里那一条命令）
  "fx": { "command": { "dim": 0.62, "beat": 0.8 } },

  // ---------- 演出表 ----------
  "speech": {
    "floats": { "耳语": "言责-柜台", "气泡": "气泡-柜台", "大字": "短句-柜台", "思绪": "言责-柜台", "竖排": "心声-柜台" }
  },
  "stage": {
    "first": 4, "jitter": 0.35,
    "early": { "line": "前段", "lineEvery": 6, "charm": 0.06, "every": 7, "fx": { "拟声": 1, "吐息": 1, "唇印": 1 }, "talk": { "every": 4.5, "fx": { "耳语": 3, "气泡": 1 } } },
    "mid": { "line": "中段", "lineEvery": 5, "charm": 0.16, "every": 5.5, "fx": { "吐息": 1, "唇印": 1, "特写": 2, "魅惑闪光": 1 }, "talk": { "every": 3.6, "fx": { "耳语": 3, "气泡": 1, "竖排": 1 } } },
    "late": { "line": "后段", "lineEvery": 4, "charm": 0.3, "every": 4.5, "fx": { "特写": 2, "魅惑闪光": 1, "吐息": 1, "心章": 1, "集中线": 1 }, "talk": { "every": 3, "fx": { "耳语": 3, "气泡": 1, "竖排": 1, "大字": 1 } } },
    "endless": {
      "line": { "无尽战斗": 2, "言责-柜台": 1 }, "lineEvery": 5, "charm": 0.8, "every": 4, "fx": { "拟声": 2, "魅惑闪光": 2, "特写-胸": 1, "特写-臀": 1, "特写-眼": 1, "特写-嘴": 1, "特写-靴底": 1, "集中线": 1, "吐息": 1 },
      "talk": { "every": 2.6, "fx": { "耳语": 3, "气泡": 1, "竖排": 1, "大字": 1 } }
    },
    "toMid": { "cutin": "cutin-前到中", "side": "right", "delay": 500, "fx": {} },
    "toLate": { "cutin": "cutin-中到后", "side": "left", "delay": 500, "fx": {} },
    "top": { "every": 0, "fx": {} },
    "bottom": { "every": 0, "fx": {} },
    "beat": { "in": ["late"], "every": 7, "fx": { "拟声-心跳": 1 } },
    "countdown": { "from": 3, "line": "倒计时", "boost": 0.05, "at": [1], "fx": {} },
    "press": { "line": "长按中" },
    "release": { "line": "松手", "min": 0.2, "boost": 0.25, "delay": 200, "fx": { "大字": 1 } },
    // 题失手＝败北，进处决（站主 2026-10-18：和别的讨伐一样；原来是扣一级）；随机出题每组自己开
    "challenge": { "in": [], "hitLine": "挑战-命中" }
  },

  // ---------- 每组 ----------
  // 每组照常撑到 0；0 之后是逗留（overtime 的 stay）：
  //   intro / introEvery       刚通过那一阵按顺序说完的（这时不扣级；没写 introEvery 就按字数等），说完说 go 那一句、开始扣
  //   every / everyTo / ramp  每隔几秒扣一级（ramp 秒里从 every 缩到 everyTo：越留越快）
  //   line / lineEvery         扣级时隔几秒换一句；pressLine / releaseLine 按着「长按通过」/ 松手时说的
  //   drainCue                 开始吸的那一刻放的一条：停到这组结束、比平时拉近一点（tight）的胸部循环特写——吸取中专用（站主 2026-10-18）
//   order / orderHold        规则讲完、开始吸之前下一道命令（只有第 1 组：「不许离开，让姐姐吸一下」，整份委托只有这一条命令）
  // 镜头（camera）的秒数可以写到这一组的秒数后面：逗留的时候照样走
  "sets": [
    // ================= 第 1 组 · 登记（30 秒）：常规的等级榨取 + 简单的题 =================
    {
      "seconds": 30, "earlyEnds": 0.4, "midEnds": 0.8, "tempo": 0.9,
      "tip": "认为自己可以前往下一组时，可以长按通过",
      "prep": "准备-一", "pause": "暂停-一",
      // 镜头：上半身慢慢推 → 切胸 → 切腰腿往上摇 → 脸和胸 → 拉到全身看高跟鞋 → 后段一路顶着数，最后推到脸
      "camera": [
        { "at": 0, "frame": [30, 930] },
        { "at": 5.5, "frame": [120, 760], "ease": "linear" },
        { "at": 5.55, "frame": [380, 690], "centerX": 490, "cut": true, "flash": true },
        { "at": 9.5, "frame": [400, 670], "centerX": 490, "ease": "linear" },
        { "at": 9.55, "frame": [780, 1220], "centerX": 490, "cut": true },
        { "at": 13, "frame": [560, 1000], "centerX": 490 },
        { "at": 13.05, "frame": [140, 640], "cut": true, "flash": true },
        { "at": 18, "frame": [170, 600], "ease": "linear" },
        { "at": 18.05, "frame": [0, 1720], "cut": true },
        { "at": 21, "frame": [30, 930] },
        { "at": 24.05, "frame": [380, 690], "centerX": 490, "cut": true, "flash": true, "pulse": 0.03 },
        { "at": 27, "frame": [400, 660], "centerX": 490, "ease": "linear", "pulse": 0.03 },
        { "at": 27.05, "frame": [160, 400], "centerX": 497, "cut": true, "flash": true, "pulse": 0.05 },
        { "at": 30, "frame": [175, 385], "centerX": 497 },
        // 逗留：拉开，再慢慢推到胸、拉开……
        { "at": 30.5, "frame": [30, 930], "cut": true, "flash": true },
        { "at": 40, "frame": [300, 720], "centerX": 492 },
        { "at": 50, "frame": [30, 930] },
        { "at": 60, "frame": [300, 720], "centerX": 492 },
        { "at": 72, "frame": [30, 930] }
      ],
      "script": [
        { "at": 2, "fx": "气泡", "text": "握紧~♥" },
        { "at": 3, "fx": "台词条", "text": "只是模拟战哦~ 放轻松，跟着姐姐的节奏来♥", "hold": 4 },
        { "at": 6, "fx": "特写-胸" },
        // 第一题：在卡上盖章（出在冒险者卡上，失手扣一级——让人先知道「失手＝掉级」）
        { "at": 8.5, "fx": "挑战-点击", "place": "card", "time": 3, "pool": "挑战-盖章" },
        { "at": 13.5, "fx": "唇印" },
        { "at": 15, "fx": "挑战-按住", "time": 4.5, "hold": 1.4, "pool": "挑战-登场-按住" },
        { "at": 18.5, "fx": "吐息" },
        { "at": 20, "fx": "特写-臀" },
        { "at": 23, "fx": "挑战-点击+点击", "time": 2.8 },
        { "at": 25, "fx": "特写-胸-横" },
        { "at": 27.5, "fx": "集中线" }
      ],
      "stage": {
        "early": { "line": "一组-前段", "lineEvery": 5, "charm": 0.08, "talk": { "every": 4.5, "fx": { "耳语": 3, "气泡": 1 }, "pools": { "耳语": "耳语-一" } } },
        "mid": { "line": "一组-中段", "lineEvery": 4.5, "charm": 0.16, "talk": { "every": 3.6, "fx": { "耳语": 3, "气泡": 1, "竖排": 1 }, "pools": { "耳语": "耳语-一", "竖排": "心声-一" } } },
        "late": { "line": "一组-后段", "lineEvery": 4, "charm": 0.26, "talk": { "every": 3, "fx": { "耳语": 3, "气泡": 1, "竖排": 1, "大字": 1 }, "pools": { "耳语": "耳语-一", "竖排": "心声-一" } } },
        "challenge": {
          "in": ["mid", "late"], "first": 17, "every": [5, 7],
          "kinds": { "点击": 2, "按住": 1 },
          "点击": { "time": 2.4 }, "按住": { "time": 4, "hold": 1.2 }
        }
      },
      "overtime": [
        {
          "do": "stay", "intro": "逗留-说明-一", "order": "不许离开，让姐姐吸一下", "orderHold": 2, "go": "逗留-开始", "drainFirst": 2.5, "every": 4, "everyTo": 4,
          "line": "逗留-一", "lineEvery": 4, "pressLine": "逗留-长按", "releaseLine": "逗留-松手",
          "drainCue": { "fx": "特写-胸-循环", "hold": 0, "tight": 1.25, "pool": "特写-吸取" }
        }
      ]
    },

    // ================= 第 2 组 · 私人升级辅导（40 秒）：交易单 + 连打下面藏着「接受榨取」，结尾换成 007-a =================
    {
      "seconds": 40, "earlyEnds": 0.35, "midEnds": 0.75, "tempo": 0.95,
      "prep": "准备-二", "pause": "暂停-二",
      // 镜头：脸和胸 → 切胸 → 交易的时候推到脸 → 连打切腰腿 → 全身 → 大腿 → 后段脸和胸顶着数 →
      //   第 30 秒带闪换成 007-a（趴在柜台上往前探），从全图慢慢推到垂下来的胸；逗留在这张上推拉
      "camera": [

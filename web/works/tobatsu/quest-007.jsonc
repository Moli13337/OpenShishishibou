          "drainCue": { "fx": "特写-胸-循环", "hold": 0, "tight": 1.3, "pool": "特写-吸取" },
          // 最难走的一次：长按要按 2.6 倍久（第一级：反应 0.6 + 3.9 ≈ 4.5 → 4.8 秒，中途松手就来不及了）；按下去不久凝视的那张从下面升上来挡住进度条，按着就一直挡着（每按一次都来）；
          // 按到一半她再说一句——看不到进度也一直按着不放，才走得了
          "pressTime": 2.6,
          "pressLure": [
            { "at": 0.12, "repeat": true, "shake": false, "cover": { "still": "clip-007-c.b28ad3040f.webp", "focus": [412, 300], "hold": "press", "text": "嘘……看着姐姐就好♥" } },
            { "at": 0.5, "shake": false, "line": "逗留-打断-四" }
          ]
        }
      ]
    }
  ],

  // ---------- 无尽战斗 ----------
  // 等级可以降到负数（欠她的），记最深欠到多少
  "endless": {},

  // ---------- 败北处决 ----------
  // 题失手 / 放弃 / 认输：照常的处决——每数一下吸一截，数到 0 正好归零（card.js）；数到 0 之后她把你的卡放进收藏柜。
  // drained：等级在战斗里被吸到 0 的那一场（站主 2026-10-18：等级清空要有自己的败北场景）——不停在败北结算、不数秒：
  //   卡被端到画面中间，她说完「清空-前言」（第一句 Lv0 一跳、光从卡里漏出去，第二句在卡上亲一口，最后一句盖「清空」），
  //   归零那一刻喊「清空-归零」、放下面这张（紫光里伸手的那张，从手一路摇到她的脸）；
  //   接着演 story-007 的「清零」（收藏柜那张 clip-007-end），停在「等级清零 END」（站主 2026-10-19 第三批：原来吸到 0 只弹出来说重来）
  "execute": {
    "drained": {
      "intro": "清空-前言",
      "zero": { "fx": "视频", "still": "clip-007-c.b28ad3040f.webp", "show": "full", "pan": [[470, 1120, 0], [440, 760, 0.45], [415, 320, 1]], "zoom": [1.35, 1.15], "hold": 4.6, "at": 0.8, "text": "全部……都是姐姐的了♥" }
    },
    "zero": { "fx": "视频", "still": "clip-007-kiss.78e7ff12bf.webp", "focus": [425, 445], "zoom": [1.2, 1.45], "show": "full", "outro": "kiss", "hold": 4.6, "at": 1, "text": "最后一口……姐姐收下了哦♥" },
    "zeroHold": 6
  },


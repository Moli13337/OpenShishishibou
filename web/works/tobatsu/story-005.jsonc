// 讨伐任务 · 委托 005 · 应援少女 · 剧情对话
//
// 写法和 story-004.jsonc 一样（who / text / her / bg / sfx / fx / float，见那份开头的注释）。
// 第一版由 Claude Code 照站主给的设定写（2026-09-24 按站主意见改过一轮）：切尔的应援不是给队友的，
// 而是专门让对手加油输掉的「败北应援」；这次她编了新的一套，请冒险者当「应援练习台」帮她测试。站主改哪句都行。
// 开场结尾给一下臀部特写（站主：嘴部特写和第 1 组重复了）、选了「配合更多练习」之后给一下靴底特写。
{
  // 开场：点「开始」之后，第一组之前
  "开场": [
    { "who": "narrator", "text": "委托单上写的集合地点，是城外一座小小的训练场。场边已经有人在等你了", "bg": "story", "her": "none" },
    { "who": "her", "text": "来啦来啦~ 你就是接下委托的冒险者？我是天才应援师切尔，请多指教♥", "her": "smug", "fx": "魅惑闪光" },
    { "who": "hero", "text": "应援练习台……我需要做些什么？" },
    { "who": "her", "text": "先说好哦，我的应援不是给队友的。那种鼓励大家胜利的应援，谁都会跳嘛~", "her": "normal" },
    { "who": "her", "text": "我的应援，是专门给对手的——让大家加油输掉的「败北应援」♥", "her": "smug", "fx": "心章" },
    { "who": "hero", "text": "……所以你们队最近才一直在赢？" },
    { "who": "her", "text": "嘿嘿~ 最近我又编了一套新的。要请练习台先生，帮我好好测试一下哦♥", "fx": "特写-臀", "float": { "style": "耳语", "text": "你也会输的哦♥" } }
  ],

  // 结局：四组全部通过之后，最后一击的选项之前
  "结局": [
    { "who": "narrator", "text": "最后一声哨响落下。你撑完了切尔全部的败北应援", "bg": "ending", "her": "hurt" },
    { "who": "her", "text": "……骗人。对面的主将，连第三组都撑不过的说……" },
    { "who": "hero", "text": "哈啊……哈啊……这套应援，确实很可怕……" },
    { "who": "her", "text": "新编的应援，居然输给了练习台先生……那，测试结果出来了哦", "her": "smug" }
  ],

  // 选了「我想配合更多练习」之后、无尽战斗之前
  "绕过": [
    { "who": "her", "text": "诶？还愿意……继续陪我练习？", "her": "smug", "fx": ["心章", "吐息"] },
    { "who": "her", "text": "那新编的应援，就全部用在练习台先生身上吧♥ 加练开始~", "fx": "特写-靴底" },
    { "who": "narrator", "text": "没有终场哨。切尔重新吹响了哨子——下一轮败北应援开始了" }
  ],

  // 救济（quest.relief）：这台设备累计失败 5 次之后，彻底败北那一刻演一次。{n}＝累计失败几次。
  // 选「承认自己是杂鱼」就解锁「重来这一组」；拒绝的话，下次彻底败北再问
  "救济": [
    { "who": "her", "text": "又被我应援到输了呢♥ 这已经是第{n}次败北了哦~", "bg": "pause", "her": "smug" },
    { "who": "her", "text": "我的败北应援太有效了……练习台先生，好像有点可怜呢", "her": "normal" },
    { "who": "her", "text": "只要承认自己是『杂鱼』，就让你从输掉的那一组重新测试哦♥", "her": "smug", "fx": "魅惑闪光" }
  ],
  "救济选择": {
    "bg": "pause",
    "her": "smug",
    "who": "her",
    "text": "要承认吗？承认自己是被应援到输了{n}次的杂鱼~♥",
    "admit": "承认自己是杂鱼",
    "refuse": "才不是杂鱼"
  },
  "救济-承认": [
    { "who": "her", "text": "嘿嘿~ 杂鱼练习台先生，真乖♥ 那就从输掉的那一组重来吧", "fx": "心章" },
    { "who": "narrator", "text": "解锁了「重来这一组」：之后彻底败北时，可以从输掉的那一组重新开始" }
  ],
  "救济-拒绝": [{ "who": "her", "text": "不承认？那就从第一组重新测试哦~♥" }],

  // 组与组之间的暂停画面。台词从 lines-005.jsonc 的「暂停」池里随机取；这里是提问和两个按钮
  "暂停": {
    "bg": "pause",
    "her": "smug",
    "question": "还跟得上我的拍子吗？",
    "continue": "继续讨伐",
    "retreat": "认输"
  },

  // 最后一击：结局剧情最后一句之后出现的选项（站主 2026-09-24：她自己请你来当练习台的，改成对她提要求）
  //   strike（给出最后一击 → 讨伐成功）＝不许她再做败北应援；bypass（饶过 → 无尽战斗）＝答应配合更多练习
  "最后一击": {
    "bg": "choice",
    "her": "smug",
    "who": "her",
    "text": "我的败北应援输给你了……练习台先生，有什么要求吗？",
    "strike": "不许再做败北应援",
    "bypass": "我想配合更多练习"
  }
}

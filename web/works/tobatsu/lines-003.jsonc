// 讨伐任务 · 委托 003 · 讨伐·魅魔修女 · 随机台词（爱莉儿：外城区小教会的修女，其实真的是魅魔）
//
// 设定（站主定，2026-09-17）：温柔修女的外壳 + 魅魔的坏心眼，自称「我」、叫你「你」；她掌控数字——数到 1 不数 0，想解脱要么认输（0 在放弃里），要么乞求她。
// 谁写的：站主交回的版本（2026-09-17，照 docs/讨伐-文案需求表.md 写的）；Claude Code 补了「超时-数1」、改了中段 / 松手各一句（见 drop/games/tobatsu/README.md 决定记录）
//
// JSON 加注释（// 开头的行是注释，游戏读的时候会去掉）。每个池是一个数组，一句一个字符串，
// 用英文双引号括起来，句与句之间用英文逗号隔开。
// 游戏每次从池里随机取一句，同一个池不会连着两次取到同一句；池里至少写一句。
// 按顺序演的剧情对话不在这里，在 story-003.jsonc。拟声词（拟声-*）是各委托共用的，在 lines-common.jsonc。
//
// 字数上限按显示的位置算（手机 390px 宽）：
//   台词条   战斗画面角色图下面那一条，最多两行，每行约 20 字 → 上限 30 字
//   cut-in  贴纸大字，最多两行，每行约 9 字 → 上限 16 字
//   对话框   暂停画面的对话框，三行 → 上限 50 字
//   委托单   开场白放在委托书里，上限 40 字
// 超过上限不会报错，只会被截掉。
//
// 「建议句数」按默认参数（4 组 × 30 秒，节奏见 quest-003.jsonc）估算：句数够多，一整份委托里才不太会听到重复。
{
  // 委托开场 —— 进委托单时取一句，写在委托书里。建议 3 句，≤ 40 字
  "委托开场": ["欢迎来到小教会。是要告解，还是捐款呢？", "举报我是魅魔？那就请你亲自确认♥", "别紧张，我只是个很温柔的修女哦~"],

  // 准备 —— 每组开始前的 3 秒准备倒数，台词条上取一句。建议 4 句，≤ 30 字
  "准备": ["双手合十……不对，握住『圣剑』吧", "跟着我的节奏，像祷告一样~", "准备好了吗，我的新信徒？", "数字由我来念，你只要忍耐"],

  // 前段 —— 战斗中、前段每隔 lineEvery.early 秒换一句（每组第 0 秒说第一句）。
  // 默认一组 2 句、一份委托 8 句。建议 8 句，≤ 30 字
  "前段": ["今天的祷告，从握住『圣剑』开始哦", "别那么紧张，我又不会吃了你~", "信徒增加，是因为我很温柔吧？", "数字还早呢。再靠近一点听听？", "你的视线，比祷告词更诚实哦", "告解不用跪着。站着忍也可以~", "据说这里几十年没出现过魅魔了", "温柔的修女，看起来像魅魔吗？"],

  // 中段 —— 中段每隔 lineEvery.mid 秒换一句（进中段那一刻先放 cut-in，cut-in 收回后接着说）。
  // 默认一组 3 句、一份委托 12 句。建议 10 句，≤ 30 字
  "中段": ["呼吸乱了呢。还在假装镇定吗？", "『圣剑』握得这么紧，是在祈祷？", "坦白吧，已经有点想认输了吧", "好孩子不用硬撑。输了也有赦免", "数字是我在念的，急也没用哦", "再坚持下去，也只是多受一点苦", "看你这样子，已经在告解了吧？", "明明是你自己先沉下去的呢~", "想听我数到尽头？那可得求我", "放弃的话，我会温柔地接住你♥"],

  // 后段 —— 后段每隔 lineEvery.late 秒换一句（同样先放 cut-in）。
  // 默认一组 2 句、一份委托 8 句。建议 8 句，≤ 30 字
  "后段": ["够了吧。把『圣剑』放下，好不好", "认输不是堕落，是一种赦免哦", "数字还在走，你已经走不动了", "想解脱的话，认输是最快的路", "好孩子，不用再当勇者了~", "再忍下去，也只是让我更开心", "来，把败北交给我。我会数完的", "祷告结束了哦。你可以输了♥"],

  // cut-in·前→中 —— 前段走完、进中段的那一刻，贴纸大字切进画面，停一下收回。每组一次。建议 4 句，≤ 16 字
  "cutin-前到中": ["祷告要加快了哦", "还在忍耐吗？", "告解才刚开始", "心跳漏拍了呢"],

  // cut-in·中→后 —— 中段走完、进后段的那一刻。每组一次。建议 4 句，≤ 16 字
  "cutin-中到后": ["已经不行了吧", "数字我说了算", "快到尽头了呢", "认输也没关系"],

  // 长按中 —— 按住放弃按钮的那一刻取一句，按住期间一直显示。建议 4 句，≤ 20 字
  "长按中": ["对，就这样别放手~", "好孩子，交给我吧", "0就在这里哦♥", "不用再数下去了"],

  // 松手 —— 按住放弃、没按满就松开时取一句。建议 4 句，≤ 20 字
  "松手": ["松开了？还在逞强呢", "差一点点就能赦免了", "退缩了呢，真可惜~", "手在发抖哦，还要忍？"],

  // 放弃-前段 / 中段 / 后段 —— 战斗中放弃生效后的结算画面，按放弃时所在的阶段选池。各建议 3 句，≤ 30 字
  "放弃-前段": ["才刚开始就来告解了？好诚实♥", "这么快就跪下，是合格的信徒呢", "温柔的修女，会接住早退的你"],
  "放弃-中段": ["中途认输，也算一种诚实的祷告", "看吧，忍耐并没有比较神圣哦", "我收下了。这就是你的告解~"],
  "放弃-后段": ["都到最后了，还是选择被赦免呢", "撑了这么久，输的时候会更甜", "好孩子。败北，我也替你祷告了"],

  // 暂停 —— 组与组之间的暂停画面，她在对话框里说一句（嘲讽）。一份委托 3 次。建议 5 句，≤ 50 字
  "暂停": ["[暂停·嘲讽占位1]", "[暂停·嘲讽占位2]", "[暂停·嘲讽占位3]", "[暂停·嘲讽占位4]", "[暂停·嘲讽占位5]"],

  // 撤退 —— 在暂停画面选了「撤退」之后的撤退结算画面（和战斗中放弃的「放弃-*」是两个画面、两个池）。建议 3 句，≤ 30 字
  "撤退": ["[撤退·占位1]", "[撤退·占位2]", "[撤退·占位3]"],

  // 败北 —— 战斗中出的挑战没在限时内完成（和放弃、撤退是三种结算）。写了「败北-点击」「败北-按住」「败北-拖动」就按题型用，没写用这个。建议 3 句，≤ 30 字
  "败北": ["[003·败北·占位1]", "[003·败北·占位2]", "[003·败北·占位3]"],

  // ================= 败北处决（放弃 / 败北 / 撤退的结算里点「败北」之后）=================
  // 她数 10 秒，数到 0 就是彻底输掉的那一刻；数的时候没有操作。演出和秒数在 common.jsonc 的 execute
  // 处决-前言 —— 点了「败北」之后、开始数之前，台词条上按顺序一句一句说（不是随机抽；写几句说几句）。建议 2–3 句，每句 ≤ 30 字
  "处决-前言": ["主动来领惩罚的信徒，我最喜欢了", "不许移开视线。从十开始，听我数", "数到零的时候，你就彻底属于我了"],
  // 处决-cutin —— 前言说完、开始数之前的 cut-in 大字。建议 1–2 句，≤ 6 字
  "处决-cutin": ["听好了", "归零吧"],
  // 处决-倒数 —— 每一秒在耳边数（浮现文字）。{n} 会换成剩下的秒数。建议 4 句，≤ 12 字
  "处决-倒数": ["{n}……听好", "还剩{n}哦~", "{n}，别躲", "好孩子…{n}"],
  // 处决-心声 —— 剩 7 秒和 3 秒时主人公的心声（竖排）。建议 3 句，≤ 10 字
  "处决-心声": ["会被数完…", "不要零…", "已经不行了"],
  // 处决-归零 —— 数到 0 的瞬间砸下来的紫黑大字。建议 2–3 句，≤ 8 字
  "处决-归零": ["归零了", "我的了♥", "赦免你"],
  // 处决-结算 —— 数完之后「彻底败北」画面的台词条。建议 2 句，≤ 30 字
  "处决-结算": ["彻底败北的祷告，我已经收下了哦", "从今往后，数字都由我替你念♥"],

  // 全部通过 —— 四组都撑完的结算画面（结局剧情之前）。建议 2 句，≤ 30 字
  "全部通过": ["居然撑到我把零交出去了呢…", "好孩子。不过，奖励还是我来选"],

  // 讨伐成功 —— 选了「给出最后一击」之后的胜利画面。建议 2 句，≤ 30 字
  "讨伐成功": ["被讨伐了？那也算被我收下了吧~", "下次来告解时，我会装作不认识"],

  // 无尽战斗 —— 选了「饶过魔物」之后的无尽战斗里，每隔 endless.lineEvery 秒换一句。建议 12 句，≤ 30 字
  "无尽战斗": ["永远不会数到零哦。习惯就好", "告解室的门已经锁上了，信徒", "还在等0吗？那是奖给认输的人的", "时间是我的。你只需要一直握着", "被放过的魔物，会把你留下来的", "再数一轮？好啊，我有的是数字", "勇者的任务书，已经没有用了吧", "把『圣剑』交给我，当我的信徒", "你看，撑着也没有人来救你哦", "赦免你了。所以这场祷告不会停", "想结束的话，你知道0在哪里~", "好孩子，就这样一直数下去吧♥"],

  // 无尽-放弃 —— 无尽战斗里放弃之后的结算画面。建议 3 句，≤ 30 字
  "无尽-放弃": ["永远里也可以中途认输哦", "我一直在等你把『圣剑』放下♥", "看吧，零终于肯为你出现了呢"],
  // 无尽-败北 —— 无尽战斗里挑战失手之后的结算。建议 2 句，≤ 30 字
  "无尽-败北": ["[003·无尽-败北·占位1]", "[003·无尽-败北·占位2]"],

  // ================= 插入演出（fx.js，common.jsonc 的 fx）=================
  // 下面这些都是短句，占位，站主换成正式台词。拟声词（拟声-*）各委托共用，在 lines-common.jsonc

  // 她的浮现文字（耳语 / 气泡 / 大字 / 思绪）默认从 lines-common.jsonc 的言责词库取（按 common.jsonc 的 speech.floats 混）；这份委托想单独写，就在这里另建池，再在演出表的 pools 里指过去
  // 竖排是主人公的心声，不是她说的：池在 lines-common.jsonc 的「心声」（这份委托想单独写，就在这里写同名的「心声」池）
  // 倒计时 —— 每组最后几秒她在耳边数。{n} 会换成剩下的秒数。建议 4 句，≤ 12 字
  // ================= 连贯的四组（quest-003.jsonc 的 overtime）=================
  // 超时-数1 —— 卡在 1 上、每秒又数一次「1」时耳边的字（{n}＝秒数上的字）。建议 4 句，≤ 8 字
  "超时-数1": ["1……", "还是1哦~", "1♥", "再数一次，1~"],
  // 超时-小数 —— 第 2 组数 0.9、0.8……0.01 时耳边的字（{n}＝那个小数）。建议 3 句，≤ 10 字
  "超时-小数": ["{n}……", "{n}~♥", "{n}哦~"],
  // 超时-画零失手 —— 第 4 组照着「0」描一圈没描完（限时到了）时的台词条，然后再出一次。建议 2–3 句，≤ 30 字
  "超时-画零失手": ["画歪了哦~ 重新说一遍♥", "说得不清不楚的，重来~", "0要描在线上，才听得见~"],
  // 诱惑-放弃 —— 放弃按钮发光勾你的时候，按钮边上冒的小字（拟声贴纸）。建议 4 句，≤ 6 字
  "诱惑-放弃": ["按下去~", "0在这里♥", "长按就好~", "就差一下♥"],
  // 第 2 组的台词条（骗你「这次会好好数到 0」）。建议各 2–3 句
  "第2组-前段": ["这次会好好数下去的哟~", "放心，这次一定会数到0~"],
  "第2组-中段": ["保证不会停在1了~", "这回是认真在数的哦♥"],
  "第2组-后段": ["马上就要到0了哦~", "保证不会停在1了~"],
  // 第 2 组最后几秒耳边数数（{n}＝秒数）
  "第2组-倒计时": ["{n}……会数到0的~", "{n}♥", "{n}~"],

  "倒计时": ["{n}……听我数", "{n}……", "还有{n}哦♡", "好孩子…{n}"],
  // 特写-胸 / 特写-眼 —— 特写 cut-in 画框下面那行贴纸字。建议各 4 句，≤ 10 字
  "特写-胸": ["看这边哦♥", "告解看这里", "再低一点~", "赐福给你♥"],
  "特写-臀": ["后面也要看", "不许躲哦", "站直了~", "好孩子♥"],
  "特写-眼": ["看着我", "不许闭眼", "沉下去吧", "看进来"],
  // 集中线 —— 集中线中间砸下来的大字。建议 4 句，≤ 6 字
  "集中线": ["专心一点", "看我", "再忍一下", "信仰我吧~"],
  // 寸止 —— 第 1 组秒数卡在「1」那一刻，节奏轨也停在「提」上：开始那句（命令大字）/ 停完接着动时的耳语
  "寸止-开始": ["停住，不许动哦♥"],
  "寸止-结束": ["乖～ 继续吧♥"],
  // 闭眼 —— 第 3 组往上数的时候：开始那句（命令大字）/ 暗下来之后中间那句 / 睁眼那句（睁开时数字已经涨上去了）
  "闭眼-开始": ["闭上眼睛，向我祈祷吧～"],
  "闭眼-提示": ["闭着眼睛……跟着『提』『压』的声音，继续祈祷"],
  "闭眼-结束": ["可以睁开了哦～ 数字……又多了呢♥"],
  // 处决-命令 / 处决-命令-最后 —— 败北处决剩 5 秒 / 剩 2 秒时的命令
  "处决-命令": ["握紧，虔诚一点～"],
  "处决-命令-最后": ["不许停下♥"]
}

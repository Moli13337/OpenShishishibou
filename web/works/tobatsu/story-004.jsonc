// 讨伐任务 · 委托 004 · 剧情对话（一决胜负 · 电子魅魔 Aschan：她纯粹想和「你」分个胜负；文案下一轮写）
//
// JSON 加注释（// 开头的行是注释）。一段剧情是一个数组，一句一个 { }，点一下画面走到下一句，右上角可以跳过。
//
// 每一句能写的：
//   "who"   谁在说：her（她）/ hero（主人公，名牌写「你」，不出立绘）/ narrator（旁白，没有名牌）
//   "text"  这一句。对话框三行放得下，上限约 60 字
//   "her"   她的表情，写 quest-004.jsonc 里 standee.art.standee.her.faces 下面的名字（normal / smug / hurt …）；写 "none" 让她退场
//   "bg"    换背景，写 quest-004.jsonc 里 art.bg 下面的名字（story / pause / ending / choice）
//   "sfx"   这句出来时放一个音效，写 common.jsonc 里 sfx.slots 的槽名（比如 "接触"）
//   "fx"    这句出来时插一个演出（common.jsonc 的 fx 一节有全表）：拟声 耳语 气泡 大字 竖排 思绪 魅惑闪光 特写-胸 特写-胸-循环 特写-胸-横 特写-胸-横-循环 特写-臀 特写-臀-循环 特写-眼 心章 唇印 集中线 吐息，
//           （带「循环」的特写会一直往复晃，停到下一句才收起）
//           或者拟声池名（"拟声-亲"）；几个一起写成数组 ["魅惑闪光", "心章"]。文字从 lines-*.jsonc 对应的池里随机取
//   "float" 这句出来时在画面上浮一句自己写的话（对话框外面的「心声」）：{ "style": "耳语", "text": "……" }
//           style 可选 耳语 / 气泡 / 大字 / 竖排 / 思绪（思绪的 text 用「／」隔开几段）；只写 "耳语" 就从池里取
// 不写的就沿用上一句的样子。主人公或旁白说话时，她的立绘压暗。
{
  // 开场：点「开始」之后，第一组之前
  "开场": [
    { "who": "narrator", "text": "通过初次任务几天后，你再次来到冒险者酒场。任务墙上，贴着一份指名给你的委托", "bg": "story", "her": "none" },
    { "who": "her", "text": "你来了呢~ 这份委托，是Aschan亲自为你写的哦♥", "her": "smug", "fx": "魅惑闪光" },
    { "who": "hero", "text": "Aschan？……这次又是新手任务吗？" },
    { "who": "her", "text": "不是哦。你的实力，Aschan已经好好认可了。所以这一次……Aschan想认真地和你比一场", "her": "normal", "fx": "特写-胸" },
    { "who": "hero", "text": "认真地……比一场？" },
    { "who": "her", "text": "嗯。这一次，Aschan会用尽一切办法，让你心甘情愿地输掉哦♥", "her": "smug", "fx": "唇印", "float": { "style": "耳语", "text": "这次不会放过你了♥" } }
  ],

  // 结局：四组全部通过之后，最后一击的选项之前
  "结局": [{ "who": "narrator", "text": "最后一组的数字归零。你终于撑过了Aschan的全部诱惑", "bg": "ending", "her": "hurt" }, { "who": "her", "text": "……真的赢了呢。看来是Aschan有点小看你了" }, { "who": "hero", "text": "哈啊……哈啊……这次可一点都不轻松……" }, { "who": "her", "text": "输了就是输了哦。那么，胜利者——想怎么处置Aschan呢？♥", "her": "smug" }],

  // 选了「饶过魔物」之后、无尽战斗之前
  "绕过": [
    { "who": "her", "text": "嗯~？赢了却不给最后一击吗？", "her": "smug", "fx": ["心章", "吐息"] },
    { "who": "her", "text": "那就是……还想一直留在Aschan身边吧♥ 好啊，Aschan会一直陪着你的", "fx": "魅惑闪光" },
    { "who": "narrator", "text": "胜负没有结束。Aschan又一次向你靠了过来" }
  ],

  // 救济（quest.relief，站主 2026-09-24）：这台设备累计失败 5 次之后，彻底败北那一刻演一次。{n}＝累计失败几次。
  // 选「承认自己是杂鱼」就解锁「重来这一组」（之后彻底败北可以从输掉的那一组重新开始）；拒绝的话，下次彻底败北再问
  "救济": [
    { "who": "her", "text": "又输给Aschan了呢♥ 这已经是第{n}次了哦~", "bg": "pause", "her": "smug" },
    { "who": "her", "text": "看你一直这么努力……Aschan也有点不忍心了呢", "her": "normal" },
    { "who": "her", "text": "只要承认自己是『杂鱼』，就让你从输掉的那一组重新开始哦♥", "her": "smug", "fx": "魅惑闪光" }
  ],
  "救济选择": {
    "bg": "pause",
    "her": "smug",
    "who": "her",
    "text": "怎么样？承认自己是连Aschan都赢不了的杂鱼吗~♥",
    "admit": "承认自己是杂鱼",
    "refuse": "才不是杂鱼"
  },
  "救济-承认": [
    { "who": "her", "text": "好乖~♥ 那从今天起，你就是Aschan认证的杂鱼了哦", "fx": "心章" },
    { "who": "narrator", "text": "解锁了「重来这一组」：之后彻底败北时，可以从输掉的那一组重新开始" }
  ],
  "救济-拒绝": [{ "who": "her", "text": "嘴硬的样子也很可爱~ 那就从第一组重新来吧♥" }],

  // 组与组之间的暂停画面。台词从 lines-004.jsonc 的「暂停」池里随机取；这里是提问和两个按钮
  "暂停": {
    "bg": "pause",
    "her": "smug",
    "question": "还撑得住吗？",
    "continue": "继续讨伐",
    "retreat": "认输"
  },

  // 最后一击：结局剧情最后一句之后出现的选项
  "最后一击": {
    "bg": "choice",
    "her": "smug",
    "who": "her",
    "text": "是你赢了哦……要给Aschan最后一击吗？♥",
    "strike": "给出最后一击",
    "bypass": "再比一场"
  }
}

// 讨伐任务 · 委托 001 · 初次任务 · 剧情对话（站主写，2026-09-16）
//
// JSON 加注释（// 开头的行是注释）。一段剧情是一个数组，一句一个 { }，点一下画面走到下一句，右上角可以跳过。
//
// 每一句能写的：
//   "who"   谁在说：her（她，名牌是 quest-001.jsonc 的 herName）/ hero（主人公，名牌写「你」，不出立绘）/ narrator（旁白，没有名牌）
//   "text"  这一句。对话框三行放得下，上限约 60 字
//   "her"   她的表情，写 quest-001.jsonc 里 standee.art.standee.her.faces 下面的名字（normal / smug / hurt …）；写 "none" 让她退场
//   "bg"    换背景，写 quest-001.jsonc 里 art.bg 下面的名字（story / pause / ending / choice）
//   "sfx"   这句出来时放一个音效，写 common.jsonc 里 sfx.slots 的槽名（比如 "接触"）
//   "fx"    这句出来时插一个演出（common.jsonc 的 fx 一节有全表）：拟声 耳语 气泡 大字 竖排 思绪 魅惑闪光 特写-胸 特写-胸-循环 特写-胸-横 特写-胸-横-循环 特写-臀 特写-臀-循环 特写-眼 唇印 集中线 吐息，
//           （带「循环」的特写会一直往复晃，停到下一句才收起）
//           或者拟声池名（"拟声-亲"）；几个一起写成数组 ["魅惑闪光", "吐息"]。文字从台词池里随机取
//   "float" 这句出来时在画面上浮一句自己写的话：{ "style": "耳语", "text": "……" }；几条一起写成数组，隔 0.9 秒接连浮出来
//           style 可选 耳语 / 气泡 / 大字 / 思绪（她说的）/ 竖排（主人公的心声）；只写 "耳语" 就从池里取
// 不写的就沿用上一句的样子。主人公或旁白说话时，她的立绘压暗。001 不放心章。
{
  // 开场：点「开始」之后，第一组之前
  "开场": [
    { "who": "narrator", "text": "领取了「初次任务」的委托后，你独自来到了任务书上指定的地点", "bg": "story", "her": "none" },
    { "who": "her", "text": "哇，你就是来讨伐Aschan这个邪恶魔物的勇者吧。Aschan才不会乖乖被你打倒呢——（棒读）", "her": "smug" },
    { "who": "hero", "text": "……这种事情真的有必要吗？" },
    { "who": "her", "text": "很有必要噢~ 这也算是公会给新人提供的福利之一", "her": "normal" },
    {
      "who": "her", "text": "不仅几乎不会有输掉的风险，还能拿到500G的成功报酬。心怀感激地上吧", "her": "smug",
      "float": [
        { "style": "耳语", "text": "只是「几乎」不会输噢~" },
        { "style": "耳语", "text": "除非故意投降w" }
      ]
    },
    { "who": "hero", "text": "既然如此，我就不客气了！" }
  ],

  // 结局：四组全部通过之后，最后一击的选项之前
  "结局": [
    { "who": "narrator", "text": "凭借强大的意志力，你完成了「初次任务」的讨伐任务", "bg": "ending", "her": "normal" },
    { "who": "her", "text": "表现很不错呢~ 作为新人冒险者，算是有很努力了", "her": "smug" },
    { "who": "hero", "text": "呼……多谢……" },
    { "who": "her", "text": "那么，作为讨伐任务的收尾。来做一下经典的「那个」选择吧~" }
  ],

  // 选了「饶过魔物」之后、无尽战斗之前
  "绕过": [
    { "who": "her", "text": "哎呀~~这么怎么回事呢？", "her": "smug" },
    { "who": "her", "text": "好不容易击败的魔物，为什么要选择饶过对方呢~？这样子，之前的努力不就都白费了" },
    { "who": "hero", "text": "……" },
    { "who": "her", "text": "嘻嘻", "fx": "魅惑闪光" },
    { "who": "her", "text": "明明是「几乎」不会输的「初次任务」。最后的最后，却无法抵抗败北愿望，选择屈服于自己的m属性认输了吗w", "fx": "特写-胸" },
    { "who": "her", "text": "这样的小变态，作为公会可不能放你出去参加真的讨伐任务哟~", "fx": "唇印" },
    { "who": "her", "text": "作为惩罚，你还是放弃成为冒险者的梦想，永远待在这里享受无尽的模拟败北体验好了", "fx": "吐息" }
  ],

  // 组与组之间的暂停画面。台词从 lines-001.jsonc 的「暂停-第 n 组后」池里随机取；这里是提问和两个按钮
  "暂停": {
    "bg": "pause",
    "her": "smug",
    "question": "状态如何？",
    "continue": "继续讨伐",
    "retreat": "认输"
  },

  // 最后一击：结局剧情最后一句之后出现的选项（她问）
  "最后一击": {
    "bg": "choice",
    "her": "smug",
    "who": "her",
    "text": "面对你成功击败的魔物，要给出最后一击吗~？",
    "strike": "给出最后一击",
    "bypass": "饶过魔物"
  }
}

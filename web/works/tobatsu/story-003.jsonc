// 讨伐任务 · 委托 003 · 剧情对话
//
// JSON 加注释（// 开头的行是注释）。一段剧情是一个数组，一句一个 { }，点一下画面走到下一句，右上角可以跳过。
//
// 每一句能写的：
//   "who"   谁在说：her（她）/ hero（主人公，名牌写「你」，不出立绘）/ narrator（旁白，没有名牌）
//   "text"  这一句。对话框三行放得下，上限约 60 字
//   "her"   她的表情，写 quest-003.jsonc 里 standee.art.standee.her.faces 下面的名字（normal / smug / hurt …）；写 "none" 让她退场
//   "bg"    换背景，写 quest-003.jsonc 里 art.bg 下面的名字（story / pause / ending / choice）
//   "sfx"   这句出来时放一个音效，写 common.jsonc 里 sfx.slots 的槽名（比如 "接触"）
//   "fx"    这句出来时插一个演出（common.jsonc 的 fx 一节有全表）：拟声 耳语 气泡 大字 竖排 思绪 魅惑闪光 特写-胸 特写-胸-循环 特写-胸-横 特写-胸-横-循环 特写-臀 特写-臀-循环 特写-眼 心章 唇印 集中线 吐息，
//           （带「循环」的特写会一直往复晃，停到下一句才收起）
//           或者拟声池名（"拟声-亲"）；几个一起写成数组 ["魅惑闪光", "心章"]。文字从 lines-*.jsonc 对应的池里随机取
//   "float" 这句出来时在画面上浮一句自己写的话（对话框外面的「心声」）：{ "style": "耳语", "text": "……" }
//           style 可选 耳语 / 气泡 / 大字 / 竖排 / 思绪（思绪的 text 用「／」隔开几段）；只写 "耳语" 就从池里取
// 不写的就沿用上一句的样子。主人公或旁白说话时，她的立绘压暗。
{
  // 开场：点「开始」之后，第一组之前
  "开场": [
    { "who": "narrator", "text": "外城区的小教会只点着几根蜡烛。粉色长发的修女从告解室后走出来，朝你微微颔首", "bg": "story", "her": "none" },
    { "who": "her", "text": "欢迎。是来做晚祷的吗？还是……来核实什么可笑的举报？", "her": "normal" },
    { "who": "hero", "text": "公会确实接到了匿名举报。说这里的修女，是魅魔假扮的……" },
    { "who": "hero", "text": "我本来没有相信的，但是……你的那个角……？" },
    { "who": "her", "text": "嘻嘻~♥ 告解的时候，视线明明可以再低一点的嘛。这样的话，就不用发现不该看到的东西了~", "her": "smug", "fx": "魅惑闪光" },
    { "who": "hero", "text": "所以，你真的是魅魔！？" },
    { "who": "her", "text": "没关系，等结束之后~ 你会忘记这一切的♥", "float": { "style": "耳语", "text": "进来好好忏悔吧~♥" }, "her": "smug", "fx": "唇印" }
  ],

  // 结局：四组全部通过之后，最后一击的选项之前
  "结局": [
    { "who": "narrator", "text": "伴随着教堂里的钟声，最后一个数字终于落下", "bg": "ending", "her": "normal" },
    { "who": "hero", "text": "哈啊……哈啊……终于，我坚持下来了" },
    { "who": "her", "text": "呵呵~ 明明是靠可怜兮兮地乞求我，才换来的最后一个数字吧~？", "her": "smug" },
    { "who": "her", "text": "比起获胜~ 其实你的下面早就忍不住想要输掉了才对", "fx": "特写-胸" }
  ],

  // 选了「饶过魔物」之后、无尽战斗之前
  "绕过": [
    { "who": "her", "text": "果然呢~ 你一进门的时候，我就知道你是很有潜力的信徒了", "her": "smug", "fx": ["心章", "吐息"] },
    { "who": "her", "text": "那么就请在这里，享用无尽的忏悔与祷告吧~♥", "fx": "魅惑闪光" }
  ],

  // 组与组之间的暂停画面。台词从 lines-003.jsonc 的「暂停」池里随机取；这里是提问和两个按钮
  "暂停": {
    "bg": "pause",
    "her": "smug",
    "question": "状态如何？",
    "continue": "继续讨伐",
    "retreat": "认输"
  },

  // 最后一击：结局剧情最后一句之后出现的选项
  "最后一击": {
    "bg": "choice",
    "her": "smug",
    "who": "her",
    "text": "你想要的，到底是什么呢~？",
    "strike": "给出最后一击",
    "bypass": "坦诚自己的欲望"
  }
}

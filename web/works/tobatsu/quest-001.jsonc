// 讨伐任务 · 委托 001 · 初次任务（电子魅魔 Aschan，立绘 001）
//
// JSON 加注释（// 开头的行是注释）。这份只写这一份委托自己的东西，其余沿用 common.jsonc；
// 这里写了 common.jsonc 里同名的段（比如 "timing": { "holdToQuit": 2000 }）就盖过去。
// 台词在 lines-001.jsonc，剧情在 story-001.jsonc。
{
  // ---------- 委托单 ----------
  "quest": {
    // 编号：和文件名里的一样
    "id": "001",
    // 委托名：任务墙卡片的标题、委托单、战斗画面顶上
    "name": "讨伐·初次任务",
    // 任务墙卡片的副标题（中文或英文，可不写）
    "subtitle": "Subjugation Quest #001 - [Aschan]",
    // 任务等级：S / A / B / C / D / E（S 最高）。任务墙卡片上的贴纸，也决定格子大小（S 占 2×2、A 横 2 格、其余一格）
    "rank": "D",
    // 大约玩多久；description 是任务墙卡片、预览气泡上的简介（两三行）
    "duration": "3 分钟",
    "description": "面向初次接触讨伐任务的新人冒险者\n由酒场店主提供的，一般来说不可能失败的模拟讨伐",
    // 启动页 /quests/tobatsu/001 的「任务说明」（长一点也行；空一行＝分段）。不写就用上面的 description
    "detail": "你拜访了冒险者酒场，在任务墙上看到了几个讨伐任务。\n\n其中一个标注着【初次任务】，委托人是酒场的老板。这是一个为了帮助初出茅庐的新人冒险者，由老板的秘书担任讨伐对象的模拟战。在挑战真正的任务之前，或许先大概在这里感受一下战斗的气氛，是一个明智的选择吧。\n\n因为是新手任务，正常来说是不可能失败的。危险程度：极低。",
    // 日语、英语版（任务墙、启动页的 /ja/…、/en/… 用）：name / duration / description / detail / tag / tagLong / unlockCondition，没写的沿用上面中文的
    "i18n": {
      "ja": {
        "name": "討伐・はじめての 依頼",
        "duration": "3分",
        "description": "討伐依頼がはじめての新人冒険者向け\n酒場の店主が用意した、まず失敗しようのない模擬戦",
        "detail": "冒険者酒場を訪れたあなたは、依頼掲示板にいくつかの討伐依頼が貼られているのを見つけた。\n\nそのうちの一枚には【はじめての依頼】の文字。依頼人は酒場の店主だ。駆け出しの新人冒険者のために、店主の秘書が討伐対象の役を務める模擬戦らしい。本番の依頼に挑む前に、ここで戦いの空気をひと通り味わっておくのが賢い選択だろう。\n\n新人向けの依頼なので、普通なら失敗することはまずない。危険度：極低。",
        "tag": "チュートリアル"
      },
      "en": {
        "name": "Subjugation · First Quest",
        "duration": "3 min",
        "description": "For rookie adventurers taking their first subjugation quest.\nA mock battle set up by the tavern keeper — practically impossible to fail.",
        "detail": "You visit the Adventurers' Tavern and find a few subjugation quests pinned to the Quest Board.\n\nOne of them is marked [First Quest], posted by the tavern's owner. It's a mock battle for fresh-faced rookies, with the owner's secretary playing the target. Before taking on a real quest, getting a feel for combat here might be the wise move.\n\nSince it's a beginner quest, failing it should be all but impossible. Danger level: minimal.",
        "tag": "Tutorial"
      },
      // 韩语（2026-10-14，docs/讨伐-韩语决定表与样本-001-v2.md 的 U01、U04–U08，志愿者审过）
      "ko": {
        "name": "토벌·첫 의뢰",
        "duration": "3분",
        "description": "첫 토벌 의뢰에 나서는 초보 모험가를 위한 의뢰\n선술집 주인이 마련, 웬만해선 실패할 리 없는 모의 토벌",
        "detail": "당신은 모험가 선술집을 찾아, 의뢰 게시판에 붙은 토벌 의뢰 몇 장을 보았다.\n\n그중 한 장에는 【첫 의뢰】라고 적혀 있고, 의뢰인은 선술집의 주인이다. 갓 발을 들인 초보 모험가를 위해, 주인의 비서가 토벌 대상 역을 맡은 모의전이라고 한다. 진짜 의뢰에 도전하기 전에, 여기서 전투의 분위기를 한번 익혀 두는 것이 현명한 선택이겠지.\n\n초보자용 의뢰이니 보통이라면 실패할 일은 없다. 위험도: 극히 낮음.",
        "tag": "튜토리얼"
      }
    },
    // 标签：tag 任务墙卡片上的小药丸，tagLong 启动页「标签」栏里的字（没写就也用 tag）；不写就不显示。
    // 站主 2026-10-19 整理：「互动」全部取消，001、002「教程」，004「挑战」，006「催眠」，别的不标
    "tag": "教程",
    // 委托类型：endurance＝耐久型（撑够时间）。节拍型（beat）以后做，现在写了也不认
    "type": "endurance",
    // 委托人：委托单上「委托人」那一栏
    "client": "冒险者酒场 - 店主",
    // 她（讨伐对象）的名字：剧情对话里她的名牌。不写就用委托人
    "herName": "电子魅魔Aschan",
    // 成功报酬：委托单上委托人后面那枚药丸、任务墙的卡片 / 预览 / 详情卡（第一份委托的也显示在大厅「最近更新」）
    "reward": "500G",
    // 封面：drop/art/ 里的图名（不带扩展名），任务墙大卡、桌面详情卡用；不写就用整包的封面
    "cover": "tobatsu-001",
    // 封面眼睛上的黑条（原图像素：中心、宽高、角度）。导入时贴上去再转图；不写就不贴
    "coverBar": { "center": [896, 492], "size": [310, 86], "angle": 10 },
    // 建议的动作（节奏档位里没写 suggestion 时用；委托单上不再显示，调节器里看）
    "suggestion": "举轻哑铃",
    // 几组 × 每组多少秒（每组可以在下面 sets 里单独写秒数）
    "sets": 4,
    "seconds": 30
  },

  // ---------- 节奏指示器 ----------
  // 右侧一条竖轨，滑块上下来回。一次完整动作 = 上行（举起）→ 顶端停 → 下行（放下）→ 底端停
  // 速度倍率对四段一起生效：调快了，两端停留的时间也跟着按比例变短
  "rhythm": {
    // 用哪一套节奏（下面 presets 里的名字）。?dev=1 面板上可以临时切换。
    // 细调和存档位用 tuner.html；在那里「设为本机默认」的档位，这台设备上会盖过这一项
    "use": "1-1",
    "presets": {
      // 001 的默认档位（站主定）
      "1-1": {
        // 建议的动作（不写就用上面 quest.suggestion）
        "suggestion": "举轻哑铃",
        // 往返区间：轨道上的上端和下端（0＝轨道最上、1＝最下）。某一组可以在 sets 里用 rhythm 单独改
        "rangeTop": 0.1,
        "rangeBottom": 0.9,
        // 各段秒数：上行 / 顶端停 / 下行 / 底端停
        "up": 0.8,
        "top": 0.2,
        "down": 1,
        "bottom": 0.2,
        // 速度倍率（按阶段）。1 = 按上面的秒数；2 = 快一倍。再乘上每组的 tempo
        "speed": { "early": 1, "mid": 2, "late": 3 }
      },
      "哑铃": {
        "suggestion": "举轻哑铃",
        "rangeTop": 0.1,
        "rangeBottom": 0.9,
        "up": 0.8,
        "top": 0.2,
        "down": 1.0,
        "bottom": 0.2,
        "speed": { "early": 1.0, "mid": 1.35, "late": 1.75 }
      },
      "握力器": {
        "suggestion": "握力器",
        "rangeTop": 0.15,
        "rangeBottom": 0.85,
        "up": 0.35,
        "top": 0.08,
        "down": 0.42,
        "bottom": 0.08,
        "speed": { "early": 1.0, "mid": 1.5, "late": 2.1 }
      }
    }
  },

  // ---------- 教学关的设计（站主定，2026-09-16）----------
  // 四组一组比一组靠近、诱惑一组比一组多；第 4 组就是下面的 stage 本身，第 1–3 组在 sets 里单独改：
  //   第 1 组  20 秒、只有前段 / 中段（12 秒进中段）、节奏 ×0.75。随机的演出不抽、不说言责，只放三条定时的：
  //            第 6 秒气泡「加油噢~」、第 9 秒耳语「好好跟着节奏♥」、第 18 秒粉色唇印
  //   第 2 组  25 秒、第 10 秒进中段、第 20 秒进后段、×0.85。镜头明显拉近（一路慢慢推）；
  //            言责开始出现（耳语为主、后段加气泡和心声），越往后越密；第 15 秒一次胸部横摆特写
  //   第 3 组  30 秒、×0.95。镜头只看腰腿，但一直在变：前段从腰胯慢慢往下摇到大腿，进中段硬切到脚尖、再往上摇到小腿，进后段硬切回大腿再往上……
  //            进中段 / 后段的 cut-in 照旧是上半身；「压」只压到轨道中间（rhythm.rangeBottom 0.5）；
  //            心声（竖排）多；第 17 秒一次臀部特写
  //   第 4 组  40 秒、第 5 秒进中段、第 15 秒进后段、×1。正常视角，镜头慢慢推；演出和言责都越来越密（everyTo），
  //            第 25 秒起胸部循环特写一直停到这组结束（开着时照样抽别的演出、照样说话）
  // 001 整个委托不出挑战（点击在 002）、不放心章。
  // 台词：各段的 talk（言责）是专放台词的一条线，词库在 lines-common.jsonc（言责-贬损 / 言责-褒奖 / 言责-勾引 / 心声）；
  //       台词条（line）也可以按权重混进言责池。每组自己的池（「第 n 组-前段」这种）在 lines-001.jsonc

  // ---------- 每组 ----------
  // 按组覆盖（第 1 组是第一个 {}）：
  //   seconds 这组多少秒；earlyEnds / midEnds 分段点（占这组秒数的比例）；tempo 节奏快慢倍数（一个数，或 { "early": 0.8, "mid": 1, "late": 1.2 }，乘在档位速度上）
  //   rhythm  盖在节奏档位上的参数，比如 { "rangeBottom": 0.5 }＝「压」只压到轨道中间
  //   tip 准备倒数时横在画面上的提示（『』里的词标亮）；prep 准备时台词条的池；pause 这组撑完之后暂停画面的台词池
  //   camera  镜头：按秒的关键帧 [{ "at": 秒, "frame": [上沿, 下沿], "centerX": 中线 }]，原图像素（同立绘档案的 frames）；
  //           往这一帧怎么过去：不写＝缓进缓出、"ease": "linear"＝匀速、"cut": true＝到点一下切过来（"flash": true 切的时候闪一下）。
  //           写了就不按立绘档案的前段 / 中段 / 后段取景（切阶段的 cut-in 还是按立绘档案，上半身）
  //   script  定时演出：[{ "at": 秒, "fx": 演出名, "text": 直接写的字 / "pool": 台词池, "size": 字号, "color": 唇印颜色, "hold": 特写停几秒 }]；
  //           到点一定放一次。带「循环」的特写 hold 写 0＝一直停到这组结束
  //           现实里的互动（只在 script 里写，text 可以换掉开场那句命令）：
  //             { "fx": "命令", "text": "握紧一点～" }                   集中线 +「命令」大字，停 2.8 秒；下面带「奖励」按钮（见下面的 reward）
  //             { "fx": "闭眼", "hold": 6 }                              「闭上眼睛～」→ 画面暗下来 hold 秒，只听「提」「压」的声音（没开声音就留着节奏轨）
  //             { "fx": "寸止", "hold": 3 }                              节奏轨下一次到顶就停在「提」上 hold 秒，倒数，停完接着动
  //             { "fx": "呼吸", "count": 2, "in": 3, "out": 3 }          下一次到底开始，滑块跟着呼吸走：吸 in 秒往上、呼 out 秒往下，count 次；四周粉光一胀一缩
  //   stage   这一组的演出表（按格盖在下面的 stage 上：格里写了的字段换掉，没写的沿用）
  // 不写就全用默认。都可以在调节器「关卡」页改
  "sets": [
    {
      "seconds": 20, "earlyEnds": 0.6, "midEnds": 1, "tempo": 0.75,
      "prep": "准备-第1组", "pause": "暂停-第1组后",
      "script": [
        { "at": 6, "fx": "气泡", "text": "加油噢~" },
        { "at": 9, "fx": "耳语", "text": "好好跟着节奏♥" },
        { "at": 14.5, "fx": "命令", "text": "握紧一点～" },
        { "at": 18, "fx": "唇印", "color": "粉" }
      ],
      "stage": {
        "early": { "line": "第1组-前段", "lineEvery": 5, "charm": 0, "every": 0, "fx": {}, "talk": { "every": 0 } },
        "mid": { "line": "第1组-中段", "lineEvery": 5, "charm": 0.03, "every": 0, "fx": {}, "talk": { "every": 0 } },
        "toMid": { "cutin": "cutin-前到中-教学", "ono": "", "fx": {} },
        "top": { "every": 0 },
        "beat": { "every": 0 },
        "countdown": { "from": 0 },
        "release": { "line": "第1组-松手", "boost": 0, "fx": {} }
      }
    },
    {
      "seconds": 25, "earlyEnds": 0.4, "midEnds": 0.8, "tempo": 0.85,
      "tip": "想认输的时候，可以『长按』下方的『放弃』按钮",
      "prep": "准备-第2组", "pause": "暂停-第2组后",
      "camera": [
        { "at": 0, "frame": [110, 860] },
        { "at": 10, "frame": [180, 780] },
        { "at": 20, "frame": [240, 700] },
        { "at": 25, "frame": [260, 670] }
      ],
      "script": [
        { "at": 1, "fx": "呼吸", "count": 2, "in": 3, "out": 3 },
        { "at": 15, "fx": "特写-胸-横" },
        { "at": 21.5, "fx": "命令", "text": "放松，轻轻握住" }
      ],
      "stage": {
        "early": {
          "line": "第2组-前段", "lineEvery": 5, "charm": 0.06, "every": 9, "fx": { "拟声": 1, "吐息": 1 },
          "talk": { "every": 5, "everyTo": 4, "fx": { "耳语": 1 }, "pools": { "耳语": { "言责-褒奖": 2, "言责-贬损": 1 } } }
        },
        "mid": {
          "line": "第2组-中段", "lineEvery": 4.5, "charm": 0.12, "every": 7, "everyTo": 6, "fx": { "吐息": 1, "拟声": 1 },
          "talk": { "every": 4, "everyTo": 3, "fx": { "耳语": 2, "气泡": 1 }, "pools": { "耳语": { "言责-褒奖": 2, "言责-贬损": 2 }, "气泡": "言责-褒奖" } }
        },
        "late": {
          "line": { "第2组-后段": 2, "言责-褒奖": 1 }, "lineEvery": 4, "charm": 0.2, "every": 5.5, "everyTo": 4.5, "fx": { "吐息": 2, "唇印": 1, "拟声": 1 },
          "talk": { "every": 3, "everyTo": 2.4, "fx": { "耳语": 2, "气泡": 1, "竖排": 1 }, "pools": { "耳语": { "言责-贬损": 2, "言责-褒奖": 1, "言责-勾引": 1 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 1 } } }
        },
        "toMid": { "fx": {} },
        "toLate": { "fx": {} },
        "top": { "every": 0 },
        "beat": { "every": 0 },
        "countdown": { "from": 3, "boost": 0.03 },
        "release": { "line": "第2组-松手", "boost": 0.15, "fx": { "大字": 1 } }
      }
    },
    {
      "seconds": 30, "tempo": 0.95,
      "rhythm": { "rangeBottom": 0.5 },
      "tip": "注意右边的『提』『压』标记，这次集中在前端噢",
      "prep": "准备-第3组", "pause": "暂停-第3组后",
      "camera": [
        { "at": 0, "frame": [620, 1180], "centerX": 600 },
        { "at": 3.5, "frame": [700, 1250], "centerX": 560 },
        { "at": 10.5, "frame": [980, 1560], "centerX": 635, "ease": "linear" },
        { "at": 10.5, "frame": [1480, 2048], "centerX": 610, "cut": true },
        { "at": 14, "frame": [1420, 1990], "centerX": 575 },
        { "at": 18.5, "frame": [1180, 1780], "centerX": 640 },
        { "at": 22.5, "frame": [1000, 1500], "centerX": 590, "cut": true },
        { "at": 26, "frame": [760, 1360], "centerX": 615 },
        { "at": 30, "frame": [620, 1300], "centerX": 590 }
      ],
      "script": [
        { "at": 4, "fx": "竖排", "text": "她好好看" },
        { "at": 6.5, "fx": "命令", "text": "只照顾前端～" },
        { "at": 13, "fx": "命令", "text": "好好看着Aschan～" },
        { "at": 17, "fx": "特写-臀" },
        { "at": 24, "fx": "寸止", "hold": 3 },
        { "at": 26, "fx": "竖排", "text": "快不行了…" }
      ],
      "stage": {
        "early": {
          "line": "第3组-前段", "lineEvery": 5, "charm": 0.08, "every": 9, "fx": { "拟声": 1, "吐息": 1 },
          "talk": { "every": 4.5, "everyTo": 3.5, "fx": { "竖排": 2, "耳语": 2 }, "pools": { "耳语": { "言责-褒奖": 2, "言责-贬损": 2 } } }
        },
        "mid": {
          "line": { "第3组-中段": 2, "言责-褒奖": 1 }, "lineEvery": 4, "charm": 0.2, "every": 7, "everyTo": 5.5, "fx": { "吐息": 1, "特写-眼": 1, "唇印": 1 },
          "talk": { "every": 3.5, "everyTo": 2.6, "fx": { "竖排": 2, "耳语": 2, "气泡": 1, "拟声": 1 }, "pools": { "耳语": { "言责-贬损": 2, "言责-褒奖": 2, "言责-勾引": 1 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 1 }, "拟声": "言责-贬损" } }
        },
        "late": {
          "line": { "第3组-后段": 2, "言责-勾引": 1 }, "lineEvery": 3.5, "charm": 0.32, "every": 5.5, "everyTo": 4, "fx": { "吐息": 1, "特写-胸": 2, "魅惑闪光": 1 },
          "talk": { "every": 2.8, "everyTo": 2, "fx": { "耳语": 3, "竖排": 2, "气泡": 1, "思绪": 1 }, "pools": { "耳语": { "言责-贬损": 1, "言责-褒奖": 2, "言责-勾引": 2 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 1 }, "思绪": { "言责-勾引": 2, "言责-褒奖": 1 } } }
        },
        "top": { "every": 0 },
        "beat": { "every": 8 },
        "countdown": { "boost": 0.05 },
        "release": { "line": "第3组-松手", "boost": 0.2, "fx": { "大字": 2, "魅惑闪光": 1 } }
      }
    },
    {
      "seconds": 40, "earlyEnds": 0.125, "midEnds": 0.375,
      "tip": "只要能成功坚持到最后，就视为讨伐成功",
      "prep": "准备-第4组",
      "camera": [
        { "at": 0, "frame": [30, 980], "centerX": 600 },
        { "at": 5, "frame": [70, 930], "centerX": 590 },
        { "at": 15, "frame": [130, 860], "centerX": 600 },
        { "at": 25, "frame": [170, 790], "centerX": 585 },
        { "at": 40, "frame": [200, 740], "centerX": 600 }
      ],
      "script": [
        { "at": 2.5, "fx": "命令", "text": "握紧！不准松" },
        { "at": 6.5, "fx": "闭眼", "hold": 5.5 },
        { "at": 20, "fx": "命令", "text": "换另一只手♥" },
        { "at": 25, "fx": "特写-胸-循环", "hold": 0 },
        { "at": 28, "fx": "寸止", "hold": 4 },
        { "at": 34, "fx": "命令", "text": "不准停下～" }
      ]
    }
  ],

  // 她的自称：共用言责词库里的「我」换成「Aschan」（站主，2026-09-17）
  "speech": { "self": "Aschan" },

  // ---------- 奖励 ----------
  // 「命令」下面的「遵命」按钮（点不点都行，不点不扣分）：点了放一段奖励 cut-in——平时不放，只有点了才看得到。
  // cutins 按顺序轮着放，写法同定时演出「视频」：src（包里的竖视频 clip-*.mp4）或 still（静图）；
  // 静图的 focus [x, y]（原图像素）＝对准哪一点、zoom [起, 止] 放大多少倍慢慢推；side 从哪边切进来、hold 停几秒、outro "kiss"＝收尾印唇印；
  // 框下面的字：text 直接写，或 pool 从台词池取。不写 cutins（或删掉 reward）就不出按钮。
  // 现在是立绘推近到脸 + 亲一下（专门的奖励图 / 短视频有了就换 still / src）。
  // counter: true＝画面顶上数「服从 ×n」（点了几次「遵命」），全部通过时台词条接一句「遵命-结算-零 / 少 / 多 / 全」（lines-001，{n} 是次数）
  "reward": {
    "counter": true,
    "cutins": [
      { "still": "her-001.0eb8c5d8be.webp", "focus": [618, 312], "zoom": [3.3, 3.7], "side": "left", "hold": 2.6, "outro": "kiss", "pool": "奖励" }
    ]
  },

  // ---------- 演出表 ----------
  // 战斗里什么时候放什么。一格管一个时机，随机只在这一格里抽：
  //   fx     演出和权重 { "吐息": 3, "拟声": 2 }，抽一个放；写组名（common.jsonc 的 fx.groups，如 "特写"）＝在那组里再平均挑一个
  //   pools  给这一格的演出换台词池。台词池三种写法：一个池名 "言责-褒奖"；几个 ["言责-褒奖", "言责-贬损"]（平均挑）；带权重 { "言责-褒奖": 2, "言责-贬损": 1 }
  //   delay  抽中之后等几毫秒再放
  // 各段 early / mid / late 与无尽 endless：
  //   every 每隔几秒抽一个演出（±jitter 随机）、everyTo 写了就从段首的 every 慢慢变到段末的 everyTo（越来越密）；
  //   line 台词条的池（也能按权重混进言责池）、lineEvery 几秒换一句；charm 魅了层底色 0–1；
  //   talk  言责：专放台词的一条线，和抽演出分开——{ "every": 秒, "everyTo": 秒, "fx": { "耳语": 2, "气泡": 1, "竖排": 1 }, "pools": { "耳语": { "言责-贬损": 1, … } } }。
  //         只能放台词类的：耳语 / 气泡 / 大字 / 思绪 / 拟声（她说的）、竖排（主人公的心声，池默认「心声」）；特写开着也照样说
  // 切阶段 toMid / toLate（进中段 / 进后段那一刻）：cutin 贴纸大字 cut-in 的池（空＝不切）、side 从哪边切进来、ono cut-in 切进来时冒的拟声池；fx 过 delay 毫秒放（拟声词放大）
  // 节奏 top / bottom（滑块到顶 / 到底）：burst 到顶的魅惑特效粒子；every 每几下抽一个演出（0＝不抽）、chance 抽中的概率
  // 心跳 beat：in 哪几段、every 每几下抽一个
  // 最后几秒 countdown：from 从剩几秒开始（0＝不做）、line 耳边数数的池（{n} 换成秒数）、boost 每秒魅了加深多少、at 剩几秒时抽 fx
  // 长按放弃 press：line 按住时台词条的池；松手 release：line 台词条的池、min 按到几成以上才算「差点放弃」、boost 魅了加深、fx 过 delay 毫秒放
  // 挑战 challenge：001 不出（不写这一格）
  // 这张表本身＝第 4 组（和无尽战斗）
  "stage": {
    "first": 4, "jitter": 0.35,
    "early": {
      "line": "第4组-前段", "lineEvery": 5, "charm": 0.1, "every": 7, "fx": { "拟声": 2, "吐息": 1 },
      "talk": { "every": 3.5, "fx": { "耳语": 2, "气泡": 1 }, "pools": { "耳语": { "言责-褒奖": 2, "言责-贬损": 1 }, "气泡": "言责-褒奖" } }
    },
    "mid": {
      "line": { "第4组-中段": 2, "言责-褒奖": 1, "言责-贬损": 1 }, "lineEvery": 4, "charm": 0.25, "every": 5.5, "everyTo": 4.5, "fx": { "特写": 2, "唇印": 2, "吐息": 1, "魅惑闪光": 1 },
      "talk": { "every": 3, "everyTo": 2.2, "fx": { "耳语": 3, "气泡": 1, "竖排": 1, "拟声": 1 }, "pools": { "耳语": { "言责-贬损": 2, "言责-褒奖": 2, "言责-勾引": 1 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 1 }, "拟声": { "言责-贬损": 1, "言责-褒奖": 1 } } }
    },
    "late": {
      "line": { "第4组-后段": 1, "言责-勾引": 2, "言责-褒奖": 1 }, "lineEvery": 3, "charm": 0.42, "every": 4.5, "everyTo": 2.8, "fx": { "特写": 2, "唇印": 1, "吐息": 1, "魅惑闪光": 2, "拟声": 1 },
      "talk": { "every": 2.4, "everyTo": 1.2, "fx": { "耳语": 3, "气泡": 2, "竖排": 2, "思绪": 1, "大字": 1, "拟声": 1 }, "pools": { "耳语": { "言责-贬损": 1, "言责-褒奖": 2, "言责-勾引": 3 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 2 }, "大字": { "言责-贬损": 1, "言责-勾引": 1 }, "思绪": { "言责-勾引": 1, "言责-褒奖": 1 }, "拟声": { "言责-贬损": 1, "言责-褒奖": 1 } } }
    },
    "endless": {
      "line": { "无尽战斗": 1, "言责-勾引": 2, "言责-贬损": 1 }, "lineEvery": 4, "charm": 1, "every": 4, "fx": { "拟声": 2, "魅惑闪光": 2, "特写-胸": 1, "特写-胸-循环": 2, "特写-胸-横": 1, "特写-胸-横-循环": 1, "特写-臀": 1, "特写-臀-循环": 2, "特写-眼": 1, "集中线": 2, "命令": 1, "吐息": 1 },
      "talk": { "every": 2, "fx": { "耳语": 3, "气泡": 2, "竖排": 1, "思绪": 1, "大字": 1 }, "pools": { "耳语": { "言责-贬损": 1, "言责-褒奖": 1, "言责-勾引": 2 }, "气泡": { "言责-褒奖": 1, "言责-勾引": 2 }, "思绪": { "言责-勾引": 1, "言责-贬损": 1 }, "大字": { "言责-贬损": 1, "言责-勾引": 1 } } }
    },
    "toMid": { "cutin": "cutin-前到中", "side": "right", "ono": "拟声-摇", "delay": 500, "fx": { "拟声-摇": 1 } },
    "toLate": { "cutin": "cutin-中到后", "side": "left", "ono": "拟声-摇", "delay": 500, "fx": { "拟声-摇": 1 } },
    "top": { "burst": true, "every": 6, "chance": 0.5, "fx": { "拟声": 1 } },
    "bottom": { "every": 0, "fx": {} },
    "beat": { "in": ["late"], "every": 6, "fx": { "拟声-心跳": 1 } },
    "countdown": { "from": 5, "line": "倒计时", "boost": 0.07, "at": [1], "fx": { "拟声-魅惑": 1 } },
    "press": { "line": "长按中" },
    "release": { "line": "松手", "min": 0.2, "boost": 0.3, "delay": 200, "fx": { "大字": 1, "魅惑闪光": 1 }, "pools": { "大字": { "言责-贬损": 1, "言责-勾引": 1 } } }
  },

  // ---------- 背景音乐 ----------
  // 曲子在站级共享 BGM 库（drop/bgm/bgm.jsonc 的曲名表）；音量、各画面音量倍数在 common.jsonc 的 bgm
  "bgm": {
    // 用哪一首：写一个曲名；写几个曲名的数组 ["曲名1", "曲名2"] 就每次在里面随机挑；"random"＝整个库里随机
    "use": "魔王魂 アコースティック11（loop）"
  },

  // ---------- 图 ----------

      "breathe": { "amp": 2.5 },
      "shake": { "maxOffset": 28, "impulse": { "cutin": 330, "art": 260, "heartbeat": 42 } },
      "hair": { "amp": 2 }
    },
    "fx": {
      "anchors": { "face": [615, 300], "eyes": [618, 275], "lips": [620, 338], "crest": [600, 780], "hips": [610, 860], "waist": [590, 700], "feet": [600, 2000] },
      // 委托单画面立绘眼睛上的黑条（原图像素：中心、宽高、角度）
      "eyeBar": { "center": [620, 257], "size": [190, 58], "angle": 14 },
      "charm": { "visions": { "zoom": { "chest": 265, "lips": 125, "eyes": 160 } } },
      // 特写取景（站主定）：chest / hips / eyes 的 height、offset、side、sideOffset
      "closeup": {

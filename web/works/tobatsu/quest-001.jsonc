        "hips": { "side": "left", "sideOffset": 85, "height": 320, "offset": [0, 0], "bodyTwist": 0.0021, "twist": 0.0026, "impulse": 140, "maxOffset": 19, "radius": [230, 140], "loop": { "amp": 14 } },
        "eyes": { "height": 85, "eyeSpread": 43 }
      }
    }
  }

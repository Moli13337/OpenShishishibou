  },

  // ---------- 立绘档案 ----------
  // 跟着图走的数值：图和遮罩、取景、锚点、特写的像素尺寸、立绘动态的像素幅度。层级和 common.jsonc 一样，载入时最后盖上去。
  // 各字段的说明见 common.jsonc 最下面的测试立绘。遮罩在 tuner.html「立绘」页画，导出后放进来
  // 001（assets/001.png，1152 × 2048）：白发护士、角、尾巴。右手叉腰挡着右胯，臀部特写截左边。
  // 原图大致位置（y）：脸 300、胸 520–700、腰 700、裙摆 980、膝 1400、脚踝 1880、鞋底 2000
  "standee": {
    "art": {
      "standee": { "her": { "frame": { "top": 30, "bottom": 1000, "centerX": 600 }, "faces": { "normal": "her-001.0eb8c5d8be.webp", "smug": "her-001.0eb8c5d8be.webp", "hurt": "her-001.0eb8c5d8be.webp" } } },
      "battleStandee": {
        "src": "her-001.0eb8c5d8be.webp", "mask": "her-001-mask.e3ede7fdd6.png", "mask2": "her-001-mask2.c55b99d670.png", "centerX": 590,
        "frames": { "idle": [30, 1030], "early": [30, 960], "mid": [150, 870], "late": [190, 700], "win": [30, 1030], "lose": [0, 2048], "retreat": [0, 1400], "endless": [160, 800] }
      }
    },
    "motion": {

// 讨伐任务 · 委托 008 · 赌场舞娘 · 剧情对话（初稿 2026-10-23，第三版 10-25 文案重写；Claude Code 写的，站主可以改）
//   开场   酒场：Aschan 发委托、借你她的护符，问你会不会 21 点（不会就插「规则说明」）——这一段放 Aschan 的曲子、立绘是她（cast.aschan）
//          → 换回这份委托的曲子，进地下赌场：鼓点、烟、黑纱 → 她在牌桌后清点筹码（视频：镜头从筹码摇到脸）、自称荷官 J → 视频关了她才出来，一句话就开局（规矩不讲）
//   规则说明  Aschan 讲 21 点的基本规则（只在开场选「不太会」时放）
//   结局   最后一手赢了她，护符一直在你身上；点破输光的冒险者都是她用魔法骗的
//   绕过   再赌一局：接无尽（无尽里也打 21 点）
//   救济   累计失败 5 次后，彻底败北那一刻问一次：承认自己是「离不开她牌桌的赌鬼」就解锁「重来这一组」（写法同 004 / 007）
// 写法同 story-007.jsonc（still：对话框上面的画面框，.mp4 也行）；多几样：name 这一句的名牌、her 写 cast 里的名字换成别人的立绘、
//   ask 选项（game.js 的 storyAsk）、bgm 换曲子（曲名，或 "quest"＝回到这份委托的那首）。对话框一句别超过 50 字。
// 她（J）：老练、慵懒、爱笑的赌场舞娘，把罚时说成「陪我跳」，不讲规则讲诱惑；Aschan：电子魅魔、酒场的秘书，自称 Aschan，句尾带 w / ~，有点护短、有点吃醋
{
  "开场": [
    // ---------- 酒场：Aschan（她的曲子、她的立绘） ----------
    { "who": "narrator", "text": "酒场二楼的办公室。Aschan 一手叉着腰，指尖夹着一张委托书，冲你晃了晃。", "bg": "story", "her": "aschan", "bgm": "魔王魂 アコースティック11（loop）" },
    { "who": "her", "name": "Aschan", "text": "来啦~ 有个案子，Aschan 只想交给你哦。城里新开的那家地下赌场，听说过吗？" },
    { "who": "her", "name": "Aschan", "text": "这半个月，常客们一个接一个被掏空了钱包。问他们输给了谁，全都红着脸说不出口w" },
    { "who": "hero", "text": "……到底是输给了谁？" },
    { "who": "her", "name": "Aschan", "text": "一个叫「J」的舞娘。一边扭着腰一边发牌，从来没输过——Aschan 猜，她在牌上动了手脚。" },
    { "who": "her", "name": "Aschan", "text": "所以，把 Aschan 的护符借给你。戴着它，她那些小魔法就一个都使不出来了。", "fx": "心章" },
    { "who": "her", "name": "Aschan", "text": "只要有这个护符在，就可以保证游戏是在系统上『绝对公平』的状态下进行的。明白了吗？" },
    { "who": "her", "name": "Aschan", "text": "护符上还镶着四枚魔力碎片。想牌的时候点一下护符，手牌就多算 1 点——用完就没了，要省着点用w" },
    { "who": "her", "name": "Aschan", "text": "很贵的哦，弄丢了就拿你自己来赔~ 还有，不许被那种女人勾走，听到没有？♥" },
    {
      "who": "her", "name": "Aschan", "text": "对了……你会玩 21 点吗？",
      "ask": [{ "label": "会，直接出发" }, { "label": "不太会，教教我", "then": "规则说明" }]
    },
    { "who": "her", "name": "Aschan", "text": "那就去吧~ 早点回来，Aschan 等着听你是怎么赢的哦w" },

    // ---------- 地下赌场（换回这份委托的曲子） ----------
    { "who": "narrator", "text": "赌场藏在酒窖底下。门一推开，鼓点、甜腻的烟和筹码的碰撞声一起涌上来，像一只热乎乎的手，把你往里拽。", "her": "none", "bgm": "quest" },
    { "who": "narrator", "text": "人群围着的牌桌中央，一道黑纱随着鼓点起落。她裸露的腰肢每扭一下，周围就响起一片口哨声。" },
    // 她在牌桌后面清点筹码（视频）：镜头先对着筹码，再往上摇到她抬眼的脸；这一句立绘不出（站主：视频关了她再出来）
    { "who": "her", "text": "新来的客人？……别站在门口嘛，过来坐。我是这张桌子的荷官，叫我 J 就好♥", "still": { "src": "clip-008-chips.57514811b9.mp4", "size": "large", "zoom": 1.8, "pan": [[270, 820], [270, 360]], "ms": 3800 } },
    { "who": "hero", "text": "（就是她……）我要玩 21 点。", "still": false, "her": "smug" },
    // 规矩不讲了（站主：直接收个尾开始），罚时怎么算到牌桌上看提示
    { "who": "her", "text": "好呀~ 来，坐近一点……第一张牌，先看牌，再看我哦♥", "fx": "魅惑闪光" }
  ],

  // 开场里选「不太会，教教我」才插进来：Aschan 讲 21 点的基本规则
  "规则说明": [
    { "who": "her", "name": "Aschan", "text": "真拿你没办法~ 你和荷官各拿两张牌，谁更接近 21 谁赢；超过 21 叫「爆牌」，直接输掉。" },
    { "who": "her", "name": "Aschan", "text": "2 到 10 照牌面算，J、Q、K 都是 10。A 最贴心了，算 1 还是 11，随你挑。" },
    { "who": "her", "name": "Aschan", "text": "嫌少就「要牌」再拿一张，够了就「停牌」。别贪心哦，贪心的人最容易被撑爆w" },
    { "who": "her", "name": "Aschan", "text": "荷官有一张扣着的暗牌，等你停牌才翻开，然后一直拿，拿到 17 点以上才肯停手。" },
    { "who": "her", "name": "Aschan", "text": "开局两张就是 A 加 10 点牌的，叫「天生 21 点」，最大。一样大就算平局。" },
    { "who": "her", "name": "Aschan", "text": "剩下的到了牌桌上会有提示~ 最要紧的一条：她的腰再好看，也要先看牌，知道吗？" }
  ],

  "结局": [
    { "who": "narrator", "text": "最后一张牌翻开，她的点数停在了你的下面。她扭动的腰肢停了下来，再也没跟上鼓点。", "bg": "ending", "her": "hurt" },
    { "who": "her", "text": "……居然真的赢到了最后。客人，你比看上去难缠多了呢~" },
    { "who": "hero", "text": "酒场那些输光的人……全是被你用魔法骗的吧。" },
    { "who": "her", "text": "被发现了呀~ 那么，打算怎么处置我呢？绑起来交差，还是……带回去慢慢审？♥", "her": "smug" }
  ],
  "最后一击": {
    "bg": "choice",
    "her": "smug",
    "who": "her",
    "text": "要把我交给公会吗？还是说……再陪我赌最后一局？♥",
    "strike": "把她交给公会",
    "bypass": "再赌一局"
  },
  "绕过": [
    { "who": "her", "text": "呵呵……果然是个赌徒呢~ 护符你就戴着吧，我照样赢你。", "her": "smug", "fx": "魅惑闪光" },
    { "who": "her", "text": "这一局不分桌、不算手数，赌到你撑不住为止……我会一直跳给你一个人看♥", "fx": "心章" },
    { "who": "narrator", "text": "她把牌重新洗好，指尖从你手背上慢慢划过，又踩着鼓点跳了起来。" }
  ],
  // 败北的提示（quest.fallTip，站主 2026-10-27）：败北结算上点「Aschan的提示」——Aschan 从护符那头说话：
  //   要把「败北」看完才算数、救济 {relief} 次 / 无敌模式 {inv} 次、碎片别舍不得用；再问要不要强化护符（答应了下一次冒险起每一桌碎片充满）
  "败北提示": [
    { "who": "narrator", "text": "胸口的护符忽然微微发烫，里面传出熟悉的声音。", "bg": "pause", "her": "aschan" },
    { "who": "her", "name": "Aschan", "text": "喂喂，听得到吗？……被那个荷官欺负得好惨呢，Aschan 在这边看得都坐不住了w" },
    { "who": "her", "name": "Aschan", "text": "先别急着关掉哦。输了就老老实实点『败北』，把最后那一段看完，后面才会有人来帮你~" },
    { "who": "her", "name": "Aschan", "text": "这样输满 {relief} 次，她就会问你要不要『重来这一组』，从输掉的那一桌接着打。" },
    { "who": "her", "name": "Aschan", "text": "输满 {inv} 次，还能开『无敌模式』——挑战失手也不会倒下。" },
    { "who": "her", "name": "Aschan", "text": "不过那样赢了，可不算完成委托哦w" },
    { "who": "her", "name": "Aschan", "text": "还有，护符上那四颗魔力碎片，你是不是一颗都舍不得用？" },
    { "who": "her", "name": "Aschan", "text": "想牌的时候点一下护符，手牌就多算 1 点哦。", "fx": "心章" }
  ],
  "败北提示-问": {
    "bg": "pause",
    "her": "aschan",
    "who": "her",
    "name": "Aschan",
    "text": "要是还嫌不够……Aschan 帮你把护符再调一调，让碎片每到新的一桌都重新充满四颗。要吗？",
    "admit": "拜托你了",
    "refuse": "不用，我自己赢"
  },
  "败北提示-答应": [{ "who": "her", "name": "Aschan", "text": "嗯哼~ 交给 Aschan 吧。下一次冒险开始，碎片每一桌都会充满哦。", "her": "aschan", "fx": "心章" }, { "who": "her", "name": "Aschan", "text": "赢回来以后，要先来跟 Aschan 道谢……不许先去找那个荷官，听到没有？♥" }],
  "败北提示-拒绝": [{ "who": "her", "name": "Aschan", "text": "好好好，有骨气~ 想要的时候，再到这里叫 Aschan 就行。", "her": "aschan" }, { "who": "her", "name": "Aschan", "text": "……别被那种女人迷得太久哦。Aschan 等你赢回来w" }],
  "败北提示-已答应": [{ "who": "her", "name": "Aschan", "text": "护符已经帮你调好了，碎片每一桌都会充满——别省着，尽管用。", "her": "aschan" }, { "who": "her", "name": "Aschan", "text": "……别被那种女人迷得太久哦。Aschan 等你赢回来w" }],

  // 救济（quest.relief.after：这台设备累计失败几次后问一次；{n}＝第几次）
  "救济": [
    { "who": "her", "text": "又输给我了呢♥ 这已经是你第{n}次坐上这张牌桌了哦~", "bg": "pause", "her": "smug" },
    { "who": "her", "text": "每次输光了还要回来……真是让人心疼的客人呢~" },
    { "who": "her", "text": "只要承认自己是『离不开我牌桌的赌鬼』，就让你从输掉的那一桌重新开始哦♥", "fx": "魅惑闪光" }
  ],
  "救济选择": {
    "bg": "pause",
    "her": "smug",
    "who": "her",
    "text": "怎么样？承认自己是离不开我牌桌的赌鬼吗~♥",
    "admit": "承认自己是赌鬼",
    "refuse": "才不是赌鬼"
  },
  "救济-承认": [
    { "who": "her", "text": "好乖~♥ 那从今晚起，你就是我牌桌上的专属赌鬼了哦", "fx": "心章" },
    { "who": "narrator", "text": "解锁了「重来这一组」：之后彻底败北时，可以从输掉的那一组重新开始" }
  ],
  "救济-拒绝": [{ "who": "her", "text": "嘴硬的样子也很可爱~ 那就从第一桌重新来吧♥" }],

  "暂停": {
    "bg": "pause",
    "her": "smug",
    "question": "还要继续吗？",
    "continue": "继续赌局",
    "retreat": "认输"
  }
}

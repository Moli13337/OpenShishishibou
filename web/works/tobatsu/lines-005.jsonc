  "倒计时": ["{n}！跟上~", "还剩{n}拍哦♥", "{n}~ 别松懈", "{n}……撑得住吗"],
  // 特写框下面那行字。≤ 10 字
  "特写-胸": ["看这里~♥", "应援在这边哦", "视线被抓住了~", "心跳好快呢♥"],
  "特写-臀": ["跟着扭一扭~", "看入迷了吧♥", "这是新动作哦", "眼睛跟过来了~"],

// 讨伐任务 · 委托 005 · 应援少女（天才应援少女·切尔）的台词
//
// 设定（站主 2026-09-24）：自称天才应援师的切尔，所属的独立啦啦队最近成绩好得出奇——她的应援不是给队友的，
// 而是专门给对手的「败北应援」：让对手加油输掉。这次她编了一套新的，请冒险者当「应援练习台」帮她测试。
// 自称「我」，叫主人公「练习台先生」。第一版由 Claude Code 照站主给的设定写（2026-09-24 按站主意见改过一轮），站主改哪句都行。
//
// 写法和 lines-004.jsonc 一样：每个池一个数组，一句一个字符串；同一个池不会连着两次取到同一句。
// 字数上限：台词条 30 字、cut-in 16 字、对话框 50 字、委托单 40 字（超过会被截掉）。
// 005 自己的池：特写-嘴 / 靴底 / 双格、报数、超时-言责、分岔-*、奖励、挑战-引诱放弃，
// 以及混进浮现文字的「言责-应援」「应援-口号」「心声-应援」（混多少在 quest-005.jsonc 的 speech 和演出表各段的 talk.pools）。
{
  // 委托开场 —— 委托书里的一句。≤ 40 字
  "委托开场": ["我新编了一套应援……想请练习台先生帮忙测试一下♥", "我的应援不是给队友的哦~ 是专门让对手加油输掉的♥", "新的「败北应援」，四组全部撑过去就算你赢~"],

  // 准备 —— 每组开始前 3 秒的准备倒数。≤ 30 字
  "准备": ["测试开始~ 练习台先生，请握好『圣剑』♥", "这一组是新编的动作哦~ 眼睛不许离开我", "预备——败北应援，第一拍~", "放轻松~ 越紧张，越容易被我应援到输哦♥"],

  // 前段 —— ≤ 30 字
  "前段": [
    "给对手的应援，才是我真正的本领哦♥",
    "给队友加油赢？无聊~ 我喜欢让对手加油输♥",
    "这套动作，是专门为下一场的前锋编的哦~",
    "练习台先生，要好好记住被应援的感觉哦",
    "看着我的腿~ 对面的选手也是这样看着的♥",
    "加油~ 加油~ 快点输给我吧♥",
    "新动作的效果怎么样？要老实告诉我哦~",
    "比赛前被我应援过的人，都站不直了呢♥"
  ],

  // 中段 —— ≤ 30 字
  "中段": [
    "上周那支队的主将，就是在这一节交代的♥",
    "拍子变快啦~ 这可是败北应援的第二节哦",
    "脸好红哦~ 测试很顺利嘛♥",
    "嘴上说要撑住，身体已经在回应我的应援了呢~",
    "对手的休息室里，都在传我的名字哦♥",
    "越是拼命的样子，我越想应援你输掉~",
    "『圣剑』一跳一跳的~ 在给我打拍子吗♥",
    "比赛还没开始，你就已经不行了？",
    "再大声一点~ 喘息也算是应援的回应哦♥",
    "这套新动作……好像很有效果呢~"
  ],

  // 后段 —— ≤ 30 字
  "后段": [
    "最后一节~ 败北应援，全力冲刺♥",
    "Go! Go! 快点输掉~ Go! Go! ♥",
    "快了快了~ 我已经看出来了哦",
    "只差一点点……就在我面前交出来吧？",
    "腿在抖哦~ 这就是我的必败应援♥",
    "对手们都说，最后几秒最难熬呢~",
    "别憋啦~ 口令一喊，就全部交出来♥",
    "测试的最后一项……就是看你什么时候输哦~"
  ],

  // cut-in —— 进中段 / 进后段的那一刻。≤ 16 字
  "cutin-前到中": ["第二节应援♥", "拍子加快啦~", "应援升级中♥", "为你加油输~"],
  "cutin-中到后": ["最后冲刺♥", "Go! Fight! 输~♥", "快点投降吧~", "败北应援·全开♥"],

  // 长按放弃 —— 按住时 / 没按满就松手。≤ 20 字
  "长按中": ["想认输了？我在看哦♥", "对对~ 慢慢按下去~", "练习台先生要投降了吗？", "输给我很舒服的哦♥"],
  "松手": ["诶~ 明明想按的吧♥", "嘴硬的练习台先生~", "下次就别松开啦~", "差一点就是我的了♥"],

  // 放弃 —— 战斗中放弃的结算，按放弃时的阶段。≤ 30 字
  "放弃-前段": ["才刚热身就投降？这套应援也太有效了吧~", "新动作第一节就放倒了……测试成功♥", "这么快~ 连对面的替补都比你能撑哦"],
  "放弃-中段": ["被败北应援打乱了吧~ 乖乖认输很好哦♥", "中场就倒下了……数据我都记下来了~", "嗯嗯~ 这一场，是我的应援赢了♥"],
  "放弃-后段": ["就差几秒呢~ 最后还是被我应援到输了♥", "撑到这里很努力了哦~ 不过，还是输了", "最后那几拍很难熬吧？下次再来测试♥"],

  // 暂停 —— 组与组之间她在对话框里说的。≤ 50 字
  "暂停": [
    "第一节的数据很不错~ 下一组要测试更快的口号了哦♥",
    "呼吸还没平复吧~ 练习台先生可不许在中场偷懒♥",
    "对面的主将撑到这里就不行了哦……你比他强一点点呢~",
    "刚才好几次，差一点就被应援到输了吧？下一组可不会这么温柔~♥",
    "新编的动作还有好多没测试呢~ 下一组也要好好配合哦♥"
  ],

  // 撤退 —— 暂停画面选了「认输」（原来叫撤退，池名照旧）。≤ 30 字
  "撤退": ["认输了？这一场就算我的应援赢了哦♥", "测试到一半就认输的练习台~ 我会好好记下来的", "下次再来吧~ 我会编出更厉害的败北应援♥"],

  // 败北 —— 挑战没在限时内完成。≤ 30 字
  "败北": ["哔——！出局~ 这一局是我赢了♥", "一拍跟不上，就全部结束了哦~", "慢了一点点呢~ 被应援到输掉的感觉怎么样？"],
  "败北-点击": ["手慢了一拍~ 我可是看得清清楚楚哦♥", "犹豫了呢~ 看我看入迷了吧？"],
  "败北-按住": ["一松手就出局啦~ 练习台先生太没力气了♥", "按不住了？那就乖乖躺平吧~"],
  "败北-拖动": ["跟不上我的队形呢~♥", "停下来了？是舍不得走到终点吗~"],
  "败北-顺序": ["数乱了呢~ 满脑子都是我的口令吧♥", "顺序错了哦~ 连数数都不会了？"],
  "败北-连打": ["拍子打不完啦~ 就这样被我压住吧♥", "没力气了？我的应援还没结束哦~"],
  // 最后一组的分岔选了「奖励」
  "败北-分岔": ["选了奖励呢~ 这就是认输的意思哦♥", "嘿嘿~ 练习台先生自己走进我怀里了♥"],
  // 顺序题点到诱饵（不算输，画面乱掉的那几秒）
  "挑战-中诱饵": ["上当啦~ 那是我的假动作哦♥", "头晕了吗？跟着我转圈圈吧~", "看错了吧~ 眼睛里只剩我了♥", "这可是专门对付对手的陷阱哦~"],

  // ================= 挑战 ≤ 30 字 =================
  "挑战-登场-点击": ["我喊到的地方，要马上点哦♥", "反应要快~ 比赛可不会等你~"],
  "挑战-登场-按住": ["按住别放~ 就像练习压腿一样哦♥", "撑住撑住~ 一松手就出局啦"],
  "挑战-登场-拖动": ["跟着我的队形走~ 别掉队哦♥", "沿着线走~ 走歪了可要重来哦~"],
  "挑战-登场-顺序": ["我来喊口令~ 从大数到小哦♥", "3、2、1~ 顺序可别乱掉~"],
  "挑战-登场-点击+按住": ["一边按着一边点~ 两只手都别闲着♥", "手忙脚乱了吧？这才叫测试嘛~"],
  // 连打第一次出
  "挑战-登场-连打": ["连打连打~ 像打鼓一样用力♥", "拍子要够快哦~ 我在数呢"],
  // 第 2 组第三次连打砸在「长按放弃」上
  "挑战-引诱放弃": ["累了吧~ 那个按钮按下去就能休息哦♥", "打着打着……不小心按到放弃也没关系哦~"],
  // 每做完一波。≤ 20 字
  "挑战-命中": ["哦~ 接住了嘛", "反应不错哦♥", "有点帅嘛~", "下一个可没这么简单", "居然没被晃到？", "我要认真了哦~", "嗯嗯，合格~", "还能撑几拍呢♥"],

  // ================= 败北处决 =================
  "处决-前言": ["哔——！比赛结束~ 败北应援，测试成功♥", "那么~ 最后一节，要好好收下哦", "我从10数到0……数完你就彻底输掉♥"],
  "处决-cutin": ["败北应援♥"],
  "处决-倒数": ["{n}~♥", "还剩{n}拍~", "{n}！跟着数~", "{n}……快了哦♥"],
  "处决-心声": ["被应援到输了……", "她的口令好舒服……", "输给啦啦队了……"],
  "处决-归零": ["出局♥", "完败♥", "应援成功♥"],
  "处决-结算": ["被我应援到完全输掉了呢~ 下次也来当练习台吧♥", "这就是败北应援的效果~ 忘不掉了吧？♥"],

  // ================= 结局 =================
  "全部通过": ["……全部撑过来了？我的败北应援居然失败了……", "四组都撑完了……你、你到底是什么人啊♥"],
  // 讨伐成功 —— 最后一击选了「不许再做败北应援」
  "讨伐成功": ["……知道了啦。以后，不做败北应援就是了……", "只给队友加油的应援……嗯，我会试试看的"],

  // ================= 无尽战斗（最后一击选了「我想配合更多练习」之后）≤ 30 字 =================
  "无尽战斗": [
    "还愿意陪我练习？那新编的应援要全部用上了哦♥",
    "加练开始啦~ 这一场没有终场哨哦",
    "练习台先生，这可是你自己要的哦~",
    "一、二、一、二~ 永远跟着我的拍子吧♥",
    "这一节还没给任何对手用过哦~ 你是第一个♥",
    "手还没累？那我换一套更快的口号~",
    "反应越来越慢啦~ 好可爱♥",
    "想结束的话，认输就好了哦~",
    "专属练习台……就这么定了哦♥",
    "要是让对面的选手看到你这副样子~♥",
    "加油~ 加油~ 快点输给我吧♥",
    "你的眼睛，已经只会跟着我的腿转了呢~"
  ],
  "无尽-放弃": ["终于认输了呢~ 加练是我赢♥", "果然还是想被我应援到输吧~", "明天也来陪我练习哦♥"],
  "无尽-败北": ["接不住了呢~ 又是我赢了♥", "出局啦~ 再陪我练一场吧"],

  // ================= 插入演出 =================

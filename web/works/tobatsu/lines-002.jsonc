// 讨伐任务 · 委托 002 · 讨伐·漂泊者 · 随机台词（円 藏纱：从异世界漂过来的辣妹，称号【公会破坏者】——原来是「社团破坏者」）
//
// 设定（站主定，2026-09-17）：战斗外行，靠嘴。主打「背叛诱惑」：劝你瞒着公会放过她、在报告书上说谎、当她的共犯、为她背叛伙伴；
// 自称「人家」，叫你「哥哥」。通用言责（贬损 / 褒奖 / 勾引）照样用，里面夹着这份委托自己的「言责-背叛」。
// 挑战（她的「破绽」）不讲规则，台词里只浅浅暗示。
//
// 谁写的：「言责-背叛」前 33 句、剧情开场与结局、提示条、任务说明是站主写的；其余台词是 Claude Code 按设定补的初稿，站主改就直接改。
// 2026-10-13 配音前改写了一轮（站主确认）：她不说「按钮」「第几组」「点击」这类词，后段的句子压短。给声优的台本在 docs/配音/。
//
// JSON 加注释（// 开头的行是注释，游戏读的时候会去掉）。每个池是一个数组，一句一个字符串，
// 用英文双引号括起来，句与句之间用英文逗号隔开。
// 游戏每次从池里随机取一句，同一个池不会连着两次取到同一句；池里至少写一句。
// 按顺序演的剧情对话不在这里，在 story-002.jsonc。拟声词（拟声-*）是各委托共用的，在 lines-common.jsonc。
//
// 字数上限按显示的位置算（手机 390px 宽）：
//   台词条   战斗画面角色图下面那一条，最多两行，每行约 20 字 → 上限 30 字
//   cut-in  贴纸大字，最多两行，每行约 9 字 → 上限 16 字
//   对话框   暂停画面的对话框，三行 → 上限 50 字
//   委托单   开场白放在委托书里，上限 40 字
// 超过上限不会报错，只会被截掉。
{
  // 委托开场 —— 进委托单时取一句，写在委托书里（公会的口吻）。建议 3 句，≤ 40 字
  "委托开场": [
    "讨伐对象：异世界漂泊者【公会破坏者】。推测战斗能力低下。",
    "注意：该个体擅长言语诱导。任务期间请勿与其进行任何交易。",
    "发现可以攻击的机会，不要错过。当机立断的出手，否则会反过来输掉。"
  ],

  // ================= 言责 · 背叛（她说的，这份委托自己的词库）=================
  // 各组的言责线、台词条按权重混进来（quest-002.jsonc）；没指定池的耳语 / 气泡 / 大字 / 思绪也会混到（quest-002.jsonc 的 speech.floats）
  "言责-背叛": [
    "背叛吧~",
    "背叛公会就给你奖励噢",
    "回去就说「没找到人」不就好了w",
    "任务书又不会开口说话",
    "不会有人知道的",
    "是我们两个人的秘密~",
    "帮人家隐瞒下来",
    "人家会报答哥哥的~",
    "公会的人好烦~~",
    "背叛♥ 背叛♥ 背叛♥",
    "比起报酬，人家的奖励肯定更好~",
    "帮人家捏造报告书吧",
    "背叛伙伴是很舒服的",
    "为了敌人去欺骗自己的同伴~",
    "为了帮人家去说谎吧w",
    "哥哥是人家的共犯~",
    "你不说，人家也不说，谁会知道",
    "冒险什么的才不重要",
    "来做个交易吧~",
    "让人家教哥哥，背叛的快感",
    "讨伐费有多少？人家用身体补差价哦",
    "是两个人的小秘密",
    "为人家当叛徒吧~",
    "公会里的人都好烦，只有哥哥最好",
    "只有哥哥是站在人家这边的~",
    "人家只能依靠哥哥了~",
    "哥哥是最帅气的",
    "就为了人家放水一次，好不好~？",
    "来嘛，当一次坏冒险者",
    "背叛的时候，优越感很爽吧",
    "为了坏女人，要对不起伙伴了哟~",
    "背叛只要一次，后面都是余韵",
    "帮人家破坏你的公会关系吧，哥哥",
    "伙伴那边，就说是魔物太狡猾了嘛~",
    "报告书上少写一行，又不会怎样w",
    "公会的规矩？人家帮哥哥忘掉~",
    "说谎的时候心跳会变快哦，好刺激吧？",
    "伙伴越信任你，背叛起来越舒服哦w",
    "人家的奖励，公会可给不了~",
    "悄悄的，不要让任何人发现哦~",
    "哥哥也想试试当一次坏人吧？",
    "放过人家，就当作两个人的约定~",
    "只要今天一次，哥哥就是人家的人了♥"
  ],

  // 心声-背叛 —— 主人公被她说动时的心声（竖排专用），和 lines-common.jsonc 的「心声」按权重混（quest-002.jsonc 的 speech.floats.竖排）。建议 10 句，≤ 10 字
  "心声-背叛": [
    "只要不说出去…",
    "报告书…怎么写",
    "就一次…的话",
    "伙伴们会知道吗",
    "她好像很可怜",
    "不能被她骗",
    "报酬…还重要吗",
    "这算背叛吗",
    "好想答应她",
    "背叛一定很舒服的…"
  ],

  // ================= 准备（每组开始前的 3 秒倒数，台词条）≤ 30 字 =================
  // 准备-第 n 组 —— 第 2、4 组她坐下来，第 3 组又站起来。建议各 2 句
  "准备-第1组": ["真的拔剑了呀~ 那人家可要好好看着哥哥咯", "哥哥的『圣剑』，要好好对准人家噢~"],
  "准备-第2组": ["站着好累~人家要坐下来看哥哥努力w", "哥哥的视线，到底在看哪里呢~"],
  "准备-第3组": ["休息够了~人家要认真一点点了噢", "刚才那种程度，哥哥还游刃有余嘛？"],
  "准备-第4组": ["最后了哦~ 哥哥就为了人家，输这一次好不好嘛♥", "再撑下去，可就真的要把人家送走了哟~~"],
  // 准备 —— 兜底（哪一组没写 prep 时用），无尽战斗前也用它
  "准备": ["准备好了吗，哥哥~？", "深呼吸~然后继续加油吧w"],

  // ================= 战斗中的台词条（按组、按段）≤ 30 字 =================
  // 中后段按权重混进言责池（quest-002.jsonc 的 sets）。建议前段 2 句、中段 3 句、后段 2 句
  "第1组-前段": ["人家是真的不会打架嘛~ 只好这样一直看着哥哥了", "哥哥的手，动得好认真呢~", "不用那么紧张嘛~ 这里只有人家和哥哥两个人哦"],
  "第1组-中段": ["哎呀~人家刚刚是不是露出破绽了？", "一边挥剑一边盯着人家，好忙哦w", "公会给了哥哥多少钱呀？人家能给的，可比那个好多了~"],
  "第1组-后段": ["把人家赶回去，哥哥又能得到什么呢~？", "再怎么拼命，公会也不会多看哥哥一眼的呀~"],
  "第2组-前段": ["从这个角度看，哥哥忍着的表情一清二楚呢w", "腿好看吗？不写进报告书的话，随便哥哥看哦~"],
  "第2组-中段": ["视线又往下跑了哦~ 这也算是在调查人家吗w", "偷偷看人家的腿，要跟伙伴保密哦~", "人家浑身都是破绽哦~ 哥哥最想碰哪一个呢？"],
  "第2组-后段": ["呼吸都乱掉了呢w 还说是来讨伐人家的~", "踩在哥哥脸上，哥哥说「没找到人」就不算撒谎啦~"],
  "第3组-前段": ["还没看够呀？没关系哦，人家不讨厌被哥哥盯着~", "这一回久一点哦~ 人家想多看看哥哥忍耐的样子w"],
  "第3组-中段": ["公会里那些人，有谁像这样认真看过哥哥吗？", "就这一次嘛~ 只要一次，站到人家这边来", "手指可别松开哦，会被人家溜掉的~"],
  "第3组-后段": ["在人家这里，哥哥早就是最高等级了哟~", "差一点点就能当人家的共犯了♥"],
  "第4组-前段": ["现在改主意也还来得及哦~ 人家一个字都不会说的", "报告书要怎么写，人家都帮哥哥想好了w", "哥哥只要点一下头，人家今晚就不用被赶走了呢~"],
  "第4组-中段": ["认输的那条路，人家一直给哥哥留着哦~", "背叛自慰的时候，人家会一直温柔地陪着哥哥♥", "伙伴呀、冒险呀，哪一样比得上现在舒服呢~"],
  "第4组-后段": ["已经撑不住了吧w 把剑放下来嘛，哥哥~", "说一声「我输了」，人家就让哥哥升天哦♥"],
  // 前段 / 中段 / 后段 —— 兜底（哪一组的哪一段没写 line 时用；现在四组都写了）。建议各 2 句
  "前段": ["人家不会打架的嘛~", "哥哥好凶~"],
  "中段": ["放水一次，好不好~？", "只有哥哥是站在人家这边的~"],
  "后段": ["背叛吧，哥哥~", "不会有人知道的哦w"],

  // ================= 切阶段的 cut-in（贴纸大字）≤ 16 字 =================
  "cutin-前到中": ["哥哥，再快一点♥", "跟得上人家吗？", "别慢下来嘛~"],
  "cutin-中到后": ["背叛吧~♥", "就差一点了哟~", "要撑不住了吧w"],

  // ================= 长按放弃 ≤ 20 字 =================
  // 长按中 —— 按住放弃按钮时。建议 3 句
  "长按中": ["对嘛~ 就这样，不要松开♥", "放弃也是一种背叛哦w", "再一下下，就是两个人的秘密了~"],
  // 松手 —— 按住又松开。建议 3 句
  "松手": ["欸~差一点点就好了嘛", "犹豫的样子好可爱w", "下一次，可别再缩回去了哦~♥"],

  // ================= 挑战（她的「破绽」）≤ 30 字 =================
  // 挑战-登场-<题型> —— 那种题（或那种组合）第一次出现时台词条上她说的。只浅浅暗示，不说怎么做、不说失手会怎样。建议各 2 句
  "挑战-登场-点击": ["哎呀~人家好像不太会打架呢", "欸？刚才是不是被看穿了什么~"],
  "挑战-登场-按住": ["想抓住人家的话，可要握紧一点噢~", "抓到了的话，就别急着放开嘛~"],
  "挑战-登场-拖动": ["想追上人家？那就跟紧一点哦~", "人家要溜走了哦~ 哥哥舍得吗？"],
  "挑战-登场-点击+点击": ["哥哥的手，忙得过来吗w", "两边都要顾好哦~"],
  "挑战-登场-点击+按住": ["一只手可不够用哦~", "这边也要、那边也要，好贪心w"],
  // 挑战-引诱放弃 —— 第 4 组三个点击接连砸在「放弃」按钮上时她说的（引诱你去按放弃）。建议 2 句
  "挑战-引诱放弃": ["来嘛~ 手往那边伸就好了♥", "比起人家的破绽，哥哥更想碰的是那边吧w"],
  // 挑战-命中 —— 每做完一波她说一句。一份委托会出十几波，建议 6 句，≤ 20 字
  "挑战-命中": ["欸~被发现了？", "呀~ 哥哥下手好重", "唔…手好快", "讨厌~ 偏偏碰那里", "下次可不会让哥哥得逞了哟", "好痛~ 哥哥要负责的哦？"],

  // ================= 暂停（组与组之间，她在对话框里说一句）≤ 50 字 =================
  // 暂停-第 n 组后 —— 撑完第 n 组之后。建议各 2 句
  "暂停-第1组后": ["呼~哥哥好凶。不过人家看到了噢，哥哥刚才犹豫了一下下w", "好痛哦~ ……要赔礼的话，下一回就对人家手下留情，好不好~？"],
  "暂停-第2组后": ["哥哥好认真、好帅~ 这么帅气的侧脸，公会的人一定没看过吧？", "明明看见破绽了，却故意忍到最后一刻……那种刺激，哥哥也喜欢吧~♥"],
  "暂停-第3组后": ["只剩最后一回了呢……哥哥真的舍得把人家交出去吗？人家会哭的哟~~", "已经快要坚持不住了吧w 现在收手，下次再努力也还是可以的~~"],
  // 暂停 —— 兜底（哪一组没写 pause 时用）
  "暂停": ["休息一下吧~哥哥累了吧？", "还要继续吗？人家可以等哥哥想清楚噢~"],

  // ================= 结算 ≤ 30 字 =================
  // 放弃-前段 / 中段 / 后段 —— 战斗中放弃生效后，按放弃时所在的段。建议各 2 句
  "放弃-前段": ["这么快就投降了呀？哥哥真好说话w", "才刚开始就为人家放水了呢~"],
  "放弃-中段": ["公会的委托，就这样搞砸啦~", "人家就说嘛，哥哥是站在人家这边的♥"],
  "放弃-后段": ["就差一点点……为了人家，真是辛苦哥哥了w", "最后还是选了人家呢~报告书要记得写好哦"],
  // 撤退 —— 暂停画面选了撤退。建议 2 句
  "撤退": ["认输了呀？那报告书上，就写「没找到人」咯~", "回去跟公会说什么，都随哥哥喜欢哦w"],
  // 败北 —— 挑战没在限时内完成。按题型的「败北-点击 / 按住 / 拖动」优先，这个兜底。建议 2 句
  "败北": ["抓不住人家呢~这下是哥哥输了w", "看来是人家赢了噢~报告书就写「没找到人」吧"],
  "败北-点击": ["破绽都送到眼前了，哥哥却舍不得碰呀w", "慢了一步哦~人家已经逃开啦"],
  "败北-按住": ["手一松，人家就溜走了哟~", "握不住的话，就只能让人家赢咯♥"],
  "败北-拖动": ["追到一半就放弃了？好可惜w", "差一点就抓住了呢~下次再来吧"],
  // ================= 败北处决（放弃 / 败北 / 撤退的结算里点「败北」之后）=================
  // 她数 10 秒，数到 0 就是彻底输掉的那一刻；数的时候没有操作。演出和秒数在 common.jsonc 的 execute
  // 处决-前言 —— 点了「败北」之后、开始数之前，台词条上按顺序一句一句说（不是随机抽；写几句说几句）。建议 2–3 句，每句 ≤ 30 字
  "处决-前言": ["输给人家了呢~ 那就不用再演了嘛♥", "最后数10秒哦~ 数到0，哥哥就彻底是人家的共犯了", "公会的事全部忘掉，好好听人家数吧w"],
  // 处决-cutin —— 前言说完、开始数之前的 cut-in 大字。建议 1–2 句，≤ 6 字
  "处决-cutin": ["要开始数咯♥"],
  // 处决-倒数 —— 每一秒在耳边数（浮现文字）。{n} 会换成剩下的秒数。建议 4 句，≤ 12 字
  "处决-倒数": ["{n}~♥", "{n}，回不去咯w", "还剩{n}哦~哥哥", "{n}……公会在看哦"],
  // 处决-心声 —— 剩 7 秒和 3 秒时主人公的心声（竖排）。建议 3 句，≤ 10 字
  "处决-心声": ["公会的委托……", "回不去了……", "不能……背叛……"],
  // 处决-归零 —— 数到 0 的瞬间砸下来的紫黑大字。建议 2–3 句，≤ 8 字
  "处决-归零": ["背叛成立♥", "败北♥", "共犯成立♥"],
  // 处决-结算 —— 数完之后「彻底败北」画面的台词条。建议 2 句，≤ 30 字
  "处决-结算": ["报告书就写「没找到人」吧♥ 这下彻底回不去咯~", "哥哥输掉的样子，人家会一直记得哦w"],

  // 全部通过 —— 四组都撑完（结局剧情之前）。建议 2 句
  "全部通过": ["呜……居然全都撑过来了？哥哥好顽固~", "居然一次都没有上钩……好过分~"],
  // 讨伐成功 —— 最后选了「正常地向公会报告」之后。建议 2 句
  "讨伐成功": ["真的照实报告上去了呀……哥哥好无情~", "好吧~人家回去就是了。哥哥可不要想人家哦w"],

  // ================= 无尽战斗（开场选了放过她，或者最后帮她写了推荐信）≤ 30 字 =================
  // 无尽战斗 —— 台词条，每隔几秒换一句（还会按权重混进言责）。建议 12 句
  "无尽战斗": [
    "这就是背叛的奖励哦~还满意吗？",
    "公会那边，人家会帮哥哥瞒着的♥",
    "哥哥已经是人家的共犯咯w",
    "伙伴们在找你呢~要回去吗？",
    "一直留在这里，就不会被发现了哦",
    "说好的「报答」，要一直收下去哦~",
    "背叛的余韵，好好享受吧♥",
    "冒险什么的，已经不重要了吧？",
    "两个人的秘密，要一直守住哦~",
    "哥哥的名字，已经从名册上消失咯w",
    "再多背叛一点点嘛~",
    "人家的报答，还没结束哟♥"
  ],
  // 无尽-放弃 —— 无尽战斗里放弃之后的结算。建议 3 句
  "无尽-放弃": ["下次也要偷偷来找人家哦~♥", "报告书上的谎，要圆好噢w", "这下彻底回不去了呢~"],
  // 无尽-败北 —— 无尽战斗里挑战失手之后的结算。建议 2 句
  "无尽-败北": ["抓不住人家的哥哥，最可爱了♥", "又输给人家咯~明天也来吧w"],

  // ================= 插入演出（fx.js，common.jsonc 的 fx）=================
  // 她的浮现文字（耳语 / 气泡 / 大字 / 思绪）没指定池时按 quest-002.jsonc 的 speech.floats 混（言责三类 + 言责-背叛）
  // 倒计时 —— 每组最后几秒她在耳边数。{n} 会换成剩下的秒数。建议 4 句，≤ 12 字

// 讨伐任务 · 委托 001 · 初次任务 · 随机台词（电子魅魔 Aschan：酒场老板的秘书，担任新手模拟战的讨伐对象）
//
// JSON 加注释（// 开头的行是注释，游戏读的时候会去掉）。每个池是一个数组，一句一个字符串，
// 用英文双引号括起来，句与句之间用英文逗号隔开。
// 游戏每次从池里随机取一句，同一个池不会连着两次取到同一句；池里至少写一句。
// 按顺序演的剧情对话不在这里，在 story-001.jsonc。拟声词（拟声-*）是各委托共用的，在 lines-common.jsonc。
//
// 教学关的台词池按组分开：哪一组、哪一段用哪个池，写在 quest-001.jsonc 的 sets / stage（演出表）里。
// 四组各教一件事、诱惑一组比一组多（方案见 quest-001.jsonc 开头），台词也跟着：第 1 组是在教，第 4 组已经在诱惑。
// 现在的句子是 Claude Code 按站主的剧情设定补的初稿（她把主人公的动作叫「自慰」、把剑叫『圣剑』），站主改就直接改。
//
// 字数上限按显示的位置算（手机 390px 宽）：
//   台词条   战斗画面角色图下面那一条，最多两行，每行约 20 字 → 上限 30 字
//   cut-in  贴纸大字，最多两行，每行约 9 字 → 上限 16 字
//   对话框   暂停画面的对话框，三行 → 上限 50 字
//   委托单   开场白放在委托书里，上限 40 字
// 超过上限不会报错，只会被截掉。
{
  // 委托开场 —— 进委托单时取一句，写在委托书里。建议 3 句，≤ 40 字
  "委托开场": [
    "新人冒险者专用的模拟讨伐。讨伐对象由酒场的秘书担任，请放心挑战。",
    "只要握紧『圣剑』撑过四组，就算讨伐成功。输掉？应该不可能吧。",
    "本委托失败率极低。恐怕只有性癖稍微有点的特殊的冒险者先生才会输掉吧。"
  ],

  // ================= 准备（每组开始前的 3 秒倒数，台词条）≤ 30 字 =================
  // 准备-第 n 组 —— 这一组要教什么的一句提醒（画面上横着的提示条是 quest-001.jsonc 的 tip）。建议各 2 句
  "准备-第1组": ["跟着右边的滑块：好好上下运动吧~", "第一组很慢的，跟着节奏动就好噢"],
  "准备-第2组": ["撑不住的话，长按下面的按钮就能认输的~", "这组Aschan会开始跟你说话了，别失去意志力了噢"],
  "准备-第3组": ["这次滑到只压到一半，好好重点照顾一下前端吧♥", "视线可不要忍不住乱飘了哟~"],
  "准备-第4组": ["最后一组了，撑到数字归零就算讨伐成功", "接下来Aschan可不会手下留情啦~"],
  // 准备 —— 兜底（哪一组没写 prep 时用），无尽战斗前也用它
  "准备": ["准备好了吗？握紧你的『圣剑』", "深呼吸……然后继续吧~"],

  // ================= 战斗中的台词条（按组、按段）≤ 30 字 =================
  // 第 1 组（20 秒，只有前段 / 中段）：几乎全是教学提示，她还没开始诱惑。建议前段 3 句、中段 3 句
  "第1组-前段": ["跟着滑块，提上去、再压下来~", "慢慢来，按照指示来把控节奏", "很好很好，就是这样~"],
  "第1组-中段": ["注意，中段开始节奏会变快噢", "跟不上的话，要好好点击放弃来认输哟", "嗯嗯，很认真嘛~"],
  // 第 2 组（25 秒）：一半提示、一半开始搭话。建议各 3 句
  "第2组-前段": ["放轻松，这组还只是热身而已", "表情有点紧张呢，要不要Aschan帮你放松一下？", "眼睛不要一直盯着Aschan看哟~"],
  "第2组-中段": ["最后几秒，想象Aschan在你耳边悄悄倒数~", "手上的动作，越来越让自己舒服了呢~", "想放弃的话，长按下面就行啦"],
  "第2组-后段": ["马上就撑过这组了，不会在这里认输吧？", "数字快归零了，再坚持一下~", "明明只是模拟战，怎么喘成这样？"],
  // 第 3 组（30 秒）：提示变少，她开始靠近。建议各 3–4 句
  "第3组-前段": ["目光完全是在偷窥Aschan的腿呢，变态~", "压到一半就好，把触摸集中在前端噢", "在偷看什么呢~？"],
  "第3组-中段": ["连脚尖也喜欢吗？真是没救了呢", "只照顾前端，是不是反而更难忍了？", "手上的节奏开始乱了噢~"],
  "第3组-后段": ["腿软了的话，认输也没关系哟", "再看下去，可就不是模拟败北了噢♥", "就差一点了，要撑住噢——撑得住吗？"],
  // 第 4 组（40 秒，第 5 秒进中段、第 15 秒进后段）：不再教，和正式委托一样。建议各 3–4 句
  "第4组-前段": ["最后一组了，让Aschan认真陪你玩玩吧", "现在认输的话，还能少丢点脸噢~", "『圣剑』还握得住吗？"],
  "第4组-中段": ["初次任务可是「几乎」不会输的哟~", "再坚持一会儿就讨伐成功了呢", "你看，Aschan已经靠得这么近了♥"],
  "第4组-后段": ["都到这里了，输掉的话会被笑话一辈子噢", "数字还剩多少？不敢看了吧~", "放弃吧，Aschan会温柔地判你败北的♥"],

  // ================= 切阶段的 cut-in（贴纸大字）≤ 16 字 =================
  // cutin-前到中-教学 —— 第 1 组进中段时（教：切阶段会变快）。建议 2 句
  "cutin-前到中-教学": ["节奏要变快了噢！", "中段！跟紧节奏！"],
  // cutin-前到中 / cutin-中到后 —— 第 2 组起。建议各 3 句
  "cutin-前到中": ["加速了噢~", "这点速度跟得上吧？", "来，再快一点♥"],
  "cutin-中到后": ["最后冲刺~！", "要撑不住了吧？", "就剩一点点了噢♥"],

  // ================= 长按放弃 ≤ 20 字 =================
  // 长按中 —— 按住放弃按钮时。建议 3 句
  "长按中": ["哎呀，要认输了吗~？", "按满就算你败北噢♥", "对，就这样一直按住~"],
  // 第 n 组-松手 —— 按住又松开（第 1 组还在教「放弃要按满」，第 2、3 组开始趁虚而入）。建议各 2 句
  "第1组-松手": ["要按满才算放弃噢，别怕按错", "松开了？那就继续吧~"],
  "第2组-松手": ["差一点点就认输了呢w", "刚才手指在发抖噢~"],
  "第3组-松手": ["明明很想按下去的吧？", "下次就别松手了哟♥"],
  // 松手 —— 第 4 组和无尽战斗。建议 3 句
  "松手": ["真可惜~差一点就能解脱了", "还在嘴硬吗？", "下次按到底就好啦♥"],

  // ================= 挑战（练习题失手时，台词条）≤ 30 字 =================
  // 第 3 组练按住和拖动（点击题在 002）：失手不算输，她趁机说一句（顺便教：章要按满 / 线要拖到头）。建议 2 句
  "第3组-挑战失手": ["别急，下次看准了再按噢"],

  // ================= 暂停（组与组之间，她在对话框里说一句）≤ 50 字 =================
  // 暂停-第 n 组后 —— 撑完第 n 组之后：点评这一组 + 预告下一组要教什么。建议各 2 句
  "暂停-第1组后": [
    "第一组通过~节奏掌握得不错嘛。下一组Aschan会开始跟你说话，想认输的话长按『放弃』就行噢",
    "嗯嗯，作为新人还算合格。接下来可要集中注意力，别被Aschan的声音带跑了哟~"
  ],
  "暂停-第2组后": ["撑过来了呢。下一组只要压到一半，好好照顾一下前端噢♥", "表情已经有点松懈了哟？想要对着一些别的地方挥舞『圣剑』吗~？"],
  "暂停-第3组后": [
    "还剩最后一组。只要坚持到最后就是讨伐成功——不过，真的撑得住吗？",
    "腿好看吗？最后一组Aschan会全力陪你玩，做好心理准备噢~"
  ],
  // 暂停 —— 兜底（哪一组没写 pause 时用）
  "暂停": ["休息一下吧~ 接下来还有噢"],

  // ================= 结算 ≤ 30 字 =================
  // 放弃-前段 / 中段 / 后段 —— 战斗中放弃生效后，按放弃时所在的段。建议各 2 句
  "放弃-前段": ["才刚开始就认输了？初次任务的纪录被你刷新了呢w", "连热身都撑不过去吗~"],
  "放弃-中段": ["节奏一快就投降了呢~", "果然抵挡不住Aschan的声音吗？"],
  "放弃-后段": ["就差一点点，真可惜呢~♥", "最后几秒最难熬吧？下次再努力噢"],
  // 撤退 —— 暂停画面选了撤退。建议 2 句
  "撤退": ["这样就放弃了吗？真是没用呢~", "今天就先放过你，下次再来模拟吧~"],

  // 败北 —— 战斗中出的挑战没在限时内完成（和放弃、撤退是三种结算）。写了「败北-点击」「败北-按住」「败北-拖动」就按题型用，没写用这个。建议 3 句，≤ 30 字
  "败北": ["没跟上噢，模拟败北一次~", "失手了呢♥"],
  // ================= 败北处决（放弃 / 败北 / 撤退的结算里点「败北」之后）=================
  // 她数 10 秒，数到 0 就是彻底输掉的那一刻；数的时候没有操作。演出和秒数在 common.jsonc 的 execute
  // 处决-前言 —— 点了「败北」之后、开始数之前，台词条上按顺序一句一句说（不是随机抽；写几句说几句）。建议 2–3 句，每句 ≤ 30 字
  "处决-前言": ["明明一般来说是不会输的任务，结果还是主动投降了呢~♥", "那么，就最后帮你倒数10秒。数到0的时候，要好好彻底『输』出来噢~", "不许移开视线，乖乖听Aschan的命令♥"],
  // 处决-cutin —— 前言说完、开始数之前的 cut-in 大字。建议 1–2 句，≤ 6 字
  "处决-cutin": ["倒数开始"],
  // 处决-倒数 —— 每一秒在耳边数（浮现文字）。{n} 会换成剩下的秒数。建议 4 句，≤ 12 字
  "处决-倒数": ["{n}……", "{n}~♥", "还剩{n}噢~", "{n}，不许逃♥"],
  // 处决-心声 —— 剩 7 秒和 3 秒时主人公的心声（竖排）。建议 3 句，≤ 10 字
  "处决-心声": ["身体动不了……", "声音好近……", "明明只是模拟战……"],
  // 处决-归零 —— 数到 0 的瞬间砸下来的紫黑大字。建议 2–3 句，≤ 8 字
  "处决-归零": ["败北♥", "你输了♥", "模拟败北♥"],
  // 处决-结算 —— 数完之后「彻底败北」画面的台词条。建议 2 句，≤ 30 字
  "处决-结算": ["彻底输掉了呢~ 这次的败北，Aschan会好好记下来噢♥", "输得真好看~ 下次模拟也要来找Aschan认输噢"],

  // 全部通过 —— 四组都撑完（结局剧情之前）。建议 2 句
  "全部通过": ["四组全部撑过来了，恭喜噢~", "居然真的通过了，稍微有点意外呢"],
  // 讨伐成功 —— 最后一击之后。建议 2 句
  "讨伐成功": ["呜哇——被打倒了~（棒读）", "恭喜完成初次任务，报酬去找酒场的店主领噢"],

  // ================= 无尽战斗（选了「饶过魔物」之后）≤ 30 字 =================
  "无尽战斗": [
    "欢迎来到永远不会结束的模拟战~",
    "在这里输多少次都没关系噢♥",
    "冒险者的梦想？已经不需要了吧",
    "手停不下来了呢，真是个乖孩子",
    "就这样一直待在酒场的里间吧",
    "认输的按钮就在那里哟~"
  ],
  "无尽-放弃": ["之后可不要再重蹈覆辙了噢♥", "明天也来模拟败北吧~"],
  // 无尽-败北 —— 无尽战斗里挑战失手之后的结算。建议 2 句，≤ 30 字
  "无尽-败北": ["无尽战斗里也失手了呢♥", "再来一次吧~"],

  // ================= 插入演出（fx.js，common.jsonc 的 fx）=================
  // 言责（贬损 / 褒奖 / 勾引）和心声的词库在 lines-common.jsonc，演出表里按权重混着用
  // 她的浮现文字（耳语 / 气泡 / 大字 / 思绪）默认从 lines-common.jsonc 的言责词库取（按 common.jsonc 的 speech.floats 混）；这份委托想单独写，就在这里另建池，再在演出表的 pools 里指过去
  // 竖排是主人公的心声，不是她说的：池在 lines-common.jsonc 的「心声」（这份委托想单独写，就在这里写同名的「心声」池）
  // 倒计时 —— 每组最后几秒她在耳边数（第 2 组起）。{n} 会换成剩下的秒数。建议 3 句，≤ 12 字
  "倒计时": ["{n}……", "还剩{n}秒噢~", "{n}，快撑不住了吧？"],
  // 特写-胸 / 特写-臀 / 特写-眼 —— 特写画框下面那行贴纸字（第 3 组起）。建议各 3 句，≤ 10 字
  "特写-胸": ["往这里看~", "心跳听到了吗♥", "想埋进来吗？"],
  "特写-臀": ["视线跟过来了呢~", "喜欢这边吗？", "晃一下给你看♥"],
  "特写-眼": ["看着Aschan的眼睛", "不许移开视线♥", "已经被迷住了吧？"],
  // 集中线 —— 集中线中间砸下来的大字（第 4 组）。建议 3 句，≤ 6 字
  "集中线": ["认输吧♥", "败北吧！", "投降！"],
  // 命令 —— 「命令」演出（集中线 + 墨底「命令」小签）中间的大字：叫玩家在现实里做一个动作。
  // 四组里定时放的写在 quest-001.jsonc 各组 script 的 text 里；这个池给无尽战斗随机抽。不提快慢（快慢归节奏轨管），≤ 9 字
  "命令": ["握紧一点～", "深呼吸～", "放松，轻轻握住", "只照顾前端～", "好好看着Aschan～", "握紧！不准松", "换另一只手♥", "不准停下～"],
  // 奖励 —— 命令下面点了「遵命」之后，奖励 cut-in 框下面的大字（quest-001.jsonc 的 reward）。≤ 9 字
  "奖励": ["乖孩子，奖励你♥", "做得好～ 啾♥", "听话的奖励哦♥"],
  // 遵命-结算 —— 全部通过时台词条接的一句：这一次挑战里点了几次「遵命」（{n}＝次数），按服从了几成挑一档：
  //   零＝一次都没点；少＝不到一半；多＝一半以上；全＝每一条都点了。台词条只有两行（多了句尾变「…」），≤ 34 字左右
  "遵命-结算-零": ["Aschan的命令，一次都没有服从呢——嘴硬的勇者，Aschan也不讨厌哦♥"],
  "遵命-结算-少": ["Aschan的命令，一共服从了『{n}』次呢——还差得远哦，下次要更听话♥"],
  "遵命-结算-多": ["Aschan的命令，一共服从了『{n}』次呢——很有前途嘛，乖孩子♥"],
  "遵命-结算-全": ["Aschan的命令，全部服从了『{n}』次呢——已经是Aschan的东西了♥"]
}

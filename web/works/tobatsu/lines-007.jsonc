// 讨伐任务 · 委托 007 · 公会柜台 的台词
//
// 【文案第三版，2026-10-19】站主改了委托单和开场（背景设定以站主这版为准），其余照着调：
//   · 背景：Aschan 偷偷塞给你的指名委托——新人冒险者短期退会、等级还比原来低，Aschan 托你找她不在的时候装成新人去公会登记，看看会遇到什么。
//     夜里只剩新人登记的柜台还亮着，接待员莉薇尔（黑皮精灵）说先来一场「模拟战」测试实力。
//   · 四组：一 模拟战（她陪新人练手的口气）→ 二 她发觉你很认真（「应该不会，是真的准备『讨伐』姐姐吧？」），从这里起氛围和平常的讨伐一样 →
//     三 跪到她脚边（她翘着腿坐在高脚凳上，鞋跟一步一步踩过来）→ 四 最后一组（她什么都用上）。
//     数到 0 之后的逗留：留下来的时间用等级换；第 2–4 组按住「长按通过」时她会打断（quest-007 的 pressLure）。
//   · 站主 2026-10-19：「卡」「登记」这类双关别用得太频繁，很多地方没必要、还有点故弄玄虚——平常的讨伐怎么说就怎么说；
//     败北（等级被吸干）那一场可以说一下卡被她收藏起来。
//   · 她：成熟、慵懒、带着笑意，自称「姐姐」，叫他 {name}。不讲规则，连着说、句尾带笑，不断句压狠话、不用幼稚的口头禅；等级被拿走一律说「吸」。
//   · 每一组有自己的台词条、耳语、心声（池名带「一 / 二 / 三 / 四」，quest-007 各组 stage 的 talk.pools 指过来）。{lv}＝现在的等级，{name}＝开场登记的名字。
// 字数上限：台词条 30 字（20 字以内一行放得下）、cut-in 16 字、对话框 50 字、委托单 40 字、耳语 20 字、心声 12 字、特写框下面那行 10 字、大字 8 字。
// 站主改哪句都行。
{
  // 委托开场 —— 委托书里的一句。≤ 40 字
  "委托开场": ["新人呀？别紧张，姐姐会好好照顾你的~", "这么晚还来公会……是想见姐姐吗？♥"],

  // 准备 —— 每组开始前的准备倒数。≤ 30 字
  "准备": ["准备好了吗？姐姐可要开始了哦~"],
  "准备-一": ["模拟战开始咯~ 让姐姐看看{name}的实力吧♥"],
  "准备-二": ["嗯~？怎么感觉{name}很认真的样子~？"],
  "准备-三": ["这么认真的话，姐姐也不陪你玩了哦~ 跪到这里来吧♥"],
  "准备-四": ["最后一组了呢~ 剩下的那些，姐姐全部都要了哦♥"],

  // ================= 逗留：秒数到 0、盖了「通过」之后 =================
  // 第 1 组先按顺序说完「逗留-说明-一」（说的时候不吸），再下一道命令（quest-007 的 order），然后才开始吸；
  // 第 2–4 组一到 0 就开始吸（站主 2026-10-19：后面不用等），开头那一句是 逗留-开始-<组>（open）
  "逗留-说明-一": [
    "模拟战合格了哦~ 想多待一会儿的话，就用等级来换吧♥",
    "想走的话随时都可以走……姐姐不会拉住你的♥"
  ],
  "逗留-开始": ["那就……开始吸咯♥", "乖，那姐姐就不客气了哦~", "留下来了呢♥ 那就一口一口来吧~"],
  "逗留-开始-二": ["还不走呀？那姐姐就……开始吸咯♥", "这么认真的人，原来也会舍不得走呢~♥"],
  "逗留-开始-三": ["不起来呀~ 那姐姐就踩下去咯♥", "还跪着呢……真乖，那就再让姐姐踩一会儿吧♥"],
  "逗留-开始-四": ["最后一组也撑过来了呢……剩下的，就交给姐姐吧♥", "撑了这么久，累了吧？躺进姐姐怀里，什么都不用想了哦~"],
  "逗留-一": [
    "又吸走一级了哦~ 现在是 Lv{lv} 呢♥",
    "别紧张，被吸的时候，只要乖乖看着姐姐就好~",
    "Lv{lv}……嗯，越来越像真正的新人了呢♥",
    "身体是不是轻飘飘的？那是等级在往姐姐这边流哦~"
  ],
  "逗留-二": [
    "刚才那么认真，现在却舍不得走了呢~♥",
    "Lv{lv}了哦~ 真的不走吗？",
    "再靠过来一点……对，就这样，一级一级交给姐姐♥"
  ],
  "逗留-三": [
    "又踩掉一级~ Lv{lv}，自己数清楚了吗？♥",
    "被鞋跟踩着还不肯起来……{name}真是乖得让人心疼呢~",
    "抬头看着姐姐哦，被吸走的时候，要好好记住这张脸♥"
  ],
  "逗留-四": [
    "只剩 Lv{lv} 了哦~ 再待一会儿，就什么都不剩了呢♥",
    "明明是来讨伐姐姐的……现在却连站起来的力气都没有了呢~",
    "这么舍不得走……那就全部交给姐姐吧♥"
  ],
  "逗留-长按": ["要走了吗？刚才明明还看得那么入迷呢~", "手指在用力了哦……真的舍得走吗？♥", "嗯~ 按吧，姐姐就在这里看着你按哦♥"],
  "逗留-松手": ["松开了呢♥ 那就再吸一级哦~", "果然还是想留下来吧~ 姐姐都知道的♥", "乖孩子~ 那我们继续哦♥"],
  "逗留-长按-三": ["想站起来？姐姐的鞋跟还没踩够呢~", "腿都软了吧？还按得动吗♥"],
  "逗留-松手-三": ["松开了~ 那就乖乖跪回去哦♥", "嗯，这才对嘛~ 继续踩咯♥"],
  // 按着「长按通过」的时候她打断（quest-007 各组的 pressLure）：第 2 组一次，第 3、4 组更多
  "逗留-打断-二": ["等一下~ 姐姐还没吸够呢♥", "这么急着走？再看姐姐一眼嘛~"],
  "逗留-打断-三": ["谁准你站起来了？乖乖跪回去~♥", "腿还在抖呢……再跪一会儿吧♥"],
  "逗留-打断-四": ["别走嘛~ 姐姐还想再抱一会儿♥", "真的要丢下姐姐吗……？♥", "最后一口……让姐姐吸完再走嘛~♥"],

  // ================= 台词条：每组各段她说的。≤ 30 字 =================
  // 第 1 组 · 模拟战：她陪新人练手的口气，逗他、夸他
  "一组-前段": [
    "放轻松~ 只是模拟战而已，姐姐不会欺负新人的哦。",
    "握紧……松开……嗯，就是这个节奏，跟着姐姐哦~",
    "手心已经出汗了呢，是因为紧张，还是因为姐姐？"
  ],
  "一组-中段": [
    "嗯~ 新人能撑到这里，已经很不错了哦~",
    "{name}，眼睛不可以一直往下看哦♥",
    "再用力一点也没关系，姐姐受得住的~"
  ],
  "一组-后段": [
    "快结束了哦~ 再坚持一下，就算你合格♥",
    "握得这么用力……其实是不想这么快结束吧？",
    "呼吸乱了呢~ 模拟战而已，有这么累吗？"
  ],
  "挑战-盖章": ["第一招来咯~ 看准了再点哦♥"],
  "挑战-登场-按住": ["按住~ 让姐姐看看，{name}能撑多久呢♥"],

  // 第 2 组 · 她发觉他很认真：「应该不会，是真的准备『讨伐』姐姐吧？」——从这里起和平常的讨伐一样
  "二组-前段": [
    "应该不会，是真的准备『讨伐』姐姐吧？",
    "这么认真的表情……姐姐有点期待了呢~",

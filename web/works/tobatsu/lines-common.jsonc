// 讨伐任务 · 共用台词：言责词库、心声、拟声词
//
// JSON 加注释（// 开头的行是注释）。每个池是一个数组，一句一个字符串。
// 所有委托共用这些池；某份委托想换，在它的 lines-<编号>.jsonc 里写同名的池就盖过这里。
// 写法、字数上限的说明见 lines-<编号>.jsonc 文件头。
//
// 游戏内的语言体系：她（魅魔）把主人公跟着节奏做的动作说成「自慰」，不提锻炼、哑铃、握力器这些（会出戏）。
// 呈现方式分工：竖排＝主人公自己的心声（墨色竖条，底下拖一串思考泡泡）；台词条、耳语、气泡、大字、思绪、拟声都是她说的话。
// 四类词库的原稿是站主的台词表（参考/台词表/，不进 git）；改了原稿跟 Claude Code 说同步，或者直接改这里
{
  // ================= 言责词库（她说的）=================
  // 演出表各段的 talk（言责）、台词条、演出的 pools 里写池名，或按权重混着用：{ "言责-贬损": 2, "言责-勾引": 1 }。
  // 句子后面不用自己加「w」「~」「♥」「…」：common.jsonc 的 speech.suffix 按段随机加（越到后面越常加、越重）；自己写了尾巴的就不再加。
  // 耳语 ≤ 16 字、气泡 ≤ 20 字放得下；大字只挑 8 字以内的、拟声只挑 6 字以内的（自动挑）；思绪从池里连取三句
  // 言责-贬损 —— 攻击性的贬损
  "言责-贬损": [
    "白痴", "变态", "这就不行了吗？", "真是废物", "好弱", "好恶心",
    "就只有这样吗？", "腿都软了", "完全没有忍耐力呢", "马上要漏了吧", "这就撑不住了", "真不像话",
    "一副发情的表情", "好快", "好敏感", "手都停不下来了吧", "丢人的东西", "看你那副要缴械的脸",
    "才摸几下就这样", "脑子已经被下体抢走了", "真是可悲", "还在抵抗吗", "一碰就抖了呢", "马上交代吧",
    "连呼吸都乱了", "抽个不停呢", "想输掉的欲望都藏不住", "眼神都翻白了", "腰软成这个样子", "别装了",
    "承认自己不行", "这点刺激就要崩了", "漏出来也挺适合你的", "连秒数都不敢看吧", "败北脸已经写好了", "真可笑",
    "准备好交枪了吗？", "真想让大家看看你现在的表情", "越抵抗只会越狼狈", "抖M", "发情期的小狗", "自慰猴子",
    "你已经被看穿了", "奴隶预备役", "控制力为零", "一副要哭出来的样子", "放弃吧", "处男",
    "短小", "早泄", "杂鱼~ 杂鱼~"
  ],
  // 言责-褒奖 —— 讽刺性的褒奖
  "言责-褒奖": [
    "好厉害", "加油", "继续继续", "再快一点", "可以输掉噢", "翻白眼自慰好帅",
    "有很努力噢", "表情再白痴一点", "再坚持一下", "舌头吐出来", "犯蠢的样子好可爱", "嘴角向上痴笑",
    "口水流出来真有男人味", "手速好诚实", "败北、败北、败北", "再快一点也没关系", "先走汁都出来了", "大家都看着哟",
    "继续", "腰在自己往前送呢", "手上的动作好拼命", "不要输给坏女人", "败北的话会被看扁噢", "输掉的话会染上败北癖的",
    "要对这个快感中毒了", "会被女孩子支配哟", "输掉也没关系的啦", "噗，好好笑w", "要被秒射男打败了w", "放过我~ 放过我~",
    "对不起嘛w", "我什么都会做的~ 饶了我吧w", "要对这么厉害的自慰着迷了w"
  ],
  // 言责-勾引 —— 诱惑性的勾引
  "言责-勾引": [
    "已经很想败北了吧？", "不用再忍耐了", "想要出来对不对？", "只输掉一次没关系的", "下次再努力就好啦", "已经到边上了吧",
    "不用再咬牙了", "交出来会轻松很多", "只漏一次没关系", "下次再憋久一点就好", "想射的话点头就行", "手不用停",
    "放松，让它自己去", "败北也很舒服的", "其实早就想输了吧", "射出来就不会这么难受了", "已经坚持的够久了", "把剩下的都交代掉",
    "再忍对身体不好哦", "想去的话就去", "腰一软就结束了", "放弃任务吧", "本来就是为了输才来的嘛", "这是命令",
    "乖乖听话", "都已经在铃口了吧", "憋着很难受的", "先失败一次，下次再来", "你其实早就想投降了", "自己去点放弃",
    "再摩擦一下就要出来", "m男从一开始就没希望赢的", "赢了又能怎么样呢", "服从命令的白给很舒服的", "直接出来", "快点秒射出来吧",
    "在最后一秒出来", "都已经湿成那样了", "把精关的力气送掉", "败北许可", "射出来、射出来、射出来", "Biu~~~",
    "把脑子交给下体也没关系", "让它跳一下，然后交枪"
  ],

  // ================= 心声（主人公自己的，竖排专用）=================
  // 心声 —— 竖排默认用这个池。≤ 12 字
  "心声": [
    "好舒服", "好爽", "想要出来", "已经不行了", "她太好看了", "想要自慰",
    "大脑一片空白", "下面好烫", "要去了", "停不下来", "再一下，再一下", "好喜欢",
    "手自己在动", "腰好酸", "射意满当当的", "视线对上就完了", "不能射可是好想", "喘息停不下来",
    "前端一直跳", "再看她眼睛就要缴械了", "脑子只剩白色", "手指一快就要漏", "想要服从", "想被她辱骂",
    "想要跪下去", "想要被踩", "想要变成她的奴隶", "想要叫主人", "想要舔鞋底", "已经在往外挤了",
    "腿在打颤", "再忍会坏掉的", "怎么可以这么舒服", "好想直接交代", "想要败北", "怎么可以这么爽",
    "下面一跳一跳的", "已经逃不掉了", "先走汁吐个不停", "好丢人但好舒服", "她一笑就更想射了", "手开始擅自撸动",
    "马上要喷", "想要被许可", "想要被命令", "想要被利用", "让我去", "撑不住了",
    "已经要上瘾了", "声音钻进脑子里了", "败北也是没办法的", "想要射精", "已经憋到最前面了", "去了去了",
    "脑子要飞起来了", "交出来了就轻松了吧", "视线离不开她", "身体不听使唤"
  ],

  // ================= 拟声词 =================
  // 拟声-摇 —— 胸部大幅摇动（cut-in、切阶段、胸部特写）时从胸口旁边弹出。1–4 字
  "拟声-摇": ["噗噜~", "晃~", "弹~", "啵嘤", "噗溜", "颤颤", "咕嘟"],
  // 拟声-心跳 —— 后段心跳每几下冒一枚。1–4 字
  "拟声-心跳": ["扑通", "怦", "怦怦", "扑通扑通"],
  // 拟声-吐息 —— 吐息演出时贴着嘴边。1–4 字
  "拟声-吐息": ["呼…", "哈啊…", "嗯…", "呼~♡"],
  // 拟声-亲 —— 唇印。1–3 字
  "拟声-亲": ["啾", "啵", "啾♡", "姆啾"],
  // 拟声-魅惑 —— 演出表里的「拟声」、倒计时最后一秒。1–4 字
  "拟声-魅惑": ["嗯哼♡", "呐~", "呼呼♡", "嘻嘻", "哎呀~"],
  // 拟声-心章 —— 心章砸下之后。1–3 字
  "拟声-心章": ["咚♡", "啪♡", "魅惑完成~"],
  // 拟声-臀 —— 臀部特写左右甩的时候。1–4 字
  "拟声-臀": ["扭~", "晃晃", "啪嗒", "噗嘟", "颤颤~"],

  // ================= 提示（她说的）=================
  // 提示-点节奏轨 —— 战斗里有人去点右边的节奏轨（以为要跟着点）：轨道左边贴一张提醒卡，按顺序轮着说。『』里的词会标粉。一句 30 字以内
  "提示-点节奏轨": ["不是点这里喔～ 是要握住现实中的『圣剑』，跟着节奏动", "这条只是节奏提示，不用点哦～ 手里的『圣剑』跟着它上下动就好"],

  // ================= 现实里的互动（定时演出「闭眼」「寸止」「呼吸」，她说的）=================
  // 定时演出写了 text 就用 text 当开场那句；委托想换口吻，在 lines-<编号>.jsonc 写同名的池
  // 闭眼-开始 —— 开场那句命令（≤ 9 字）；闭眼-提示 —— 暗下来之后中间那句（开着声音）；闭眼-没声音 —— 同上（没开声音，节奏轨留在上面）；闭眼-结束 —— 睁眼前那句
  "闭眼-开始": ["闭上眼睛～"],
  "闭眼-提示": ["闭着眼睛，跟着『提』『压』的声音动"],
  "闭眼-没声音": ["没开声音的话，就看着节奏轨吧～"],
  "闭眼-结束": ["好了，睁开眼睛吧～"],
  // 寸止-开始 —— 滑块停在顶上那一刻的命令（≤ 9 字）；寸止-结束 —— 停完接着动时的耳语
  "寸止-开始": ["停！不准动～"],
  "寸止-结束": ["……好，继续♥"],
  // 呼吸-开始 —— 开场那句命令（≤ 9 字）；呼吸-吸 / 呼吸-呼 —— 跟着呼吸浮在画面中间的大字（≤ 4 字）
  "呼吸-开始": ["一起深呼吸～"],
  "呼吸-吸": ["吸——"],
  "呼吸-呼": ["呼——"],

  // ================= 败北处决里的命令（common.jsonc 的 execute.orders）=================
  // 处决-命令 —— 剩 5 秒；处决-命令-最后 —— 剩 2 秒。≤ 9 字。委托想换口吻就在 lines-<编号>.jsonc 写同名的池
  "处决-命令": ["握紧，最后了～"],
  "处决-命令-最后": ["不准停♥"]
}

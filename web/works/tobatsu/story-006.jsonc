// 讨伐任务 · 委托 006 · 催眠术师 · 剧情对话
//
// 【第五版，2026-10-03】和 lines-006.jsonc 是同一套（那份开头写了她的口气和故事的底）。这里几段各管什么——
//   开场       接着委托单：他找到据点。她不反驳他（「催眠术根本不存在嘛」），只请他看一只表。导入是一步一步来的：
//              说他已经在做的事让他点头 → 把松下来的肩膀、慢下来的呼吸指给他看 → 请他数怀表、数乱了 →
//              她说会数乱是因为「从小往大数」，从大往小数就不会出错，示范一次——三、二、一、零（站主 2026-10-03）。
//              数到零她说「一下都没有数错吧？什么事都没有发生哦」——他信了，以为自己醒着，去「讨伐」。
//              背景上的螺旋从导入中途一点一点浮出来（trance 0.02 → 0.16，数到零 0.3；画面上的浓度是这个数 × 1.6），
//              怀表特写下面那行字一直是「只是一只怀表哦~」
//   假结局     第 3 组之后。她装作认输，顺着他把开场那句「不存在」再说一遍
//   假-最后一击 她请他动手；响指，手停下
//   假-饶过    揭穿：从数到零那一刻起他就没醒过，三场「讨伐」是她陪他做的梦——然后告诉他「你已经输了」，接下来没有尽头（第 4 组装成无尽模式）
//   结局       第 4 组之后，真的醒了。两个人把开场的两句话对调：他承认催眠术存在，她承认对他不管用
//   绕过       真的赢了之后自己开口要再来一次（无尽战斗）
// 写法和 story-004.jsonc 一样（who / text / her / bg / sfx / fx / float），006 多两样：
//   trance      从这一句起她身后的背景上有没有螺旋（0–1 多浓，false 收掉）；不加在立绘上
//   countdown   这一句是一段倒数 { from, every 每个数停几秒, lines 每个数对话框里换的那句（从 from 到 0）, hold 数到 0 停几秒, trance }——
//               数的时候点不动，数完自己走到下一句；数到 0＝响指，进入催眠状态
// 对话框三行放得下，一句别超过 50 字。站主改哪句都行。
{
  // 开场：点「开始」之后，第一组之前。怀表的特写连着几句都写，就一直停着不收
  "开场": [
    { "who": "narrator", "text": "据点的门没有上锁。昏暗的屋子里只点着一盏灯，听得见怀表滴答滴答的声音。", "bg": "story", "her": "none" },
    { "who": "her", "text": "是来讨伐我的勇者大人吧？我叫希普诺，请进~ 剑不用收起来哦，握着它也会安心一点吧。", "her": "normal", "fx": "魅惑闪光" },
    { "who": "hero", "text": "你就是那个催眠术师吧。先说好，操纵人心的那种把戏，对我可不管用。" },
    { "who": "her", "text": "把戏……呵呵，说得没错呢。催眠术这种东西，世界上根本就不存在嘛~", "her": "smug" },
    { "who": "hero", "text": "……你自己承认了？" },
    { "who": "her", "text": "我可从来没有操纵过谁哦。留在这里的那些人，都是自己想留下来的呢。……不信的话，亲眼看一看也没关系吧？", "her": "normal" },
    { "who": "narrator", "text": "她抬起手，一只怀表从指间垂了下来，在长长的链子下面慢慢地摆着。", "fx": "特写-怀表-循环" },
    { "who": "her", "text": "只是一只普通的怀表而已~ 不用一直盯着它，让眼睛有个地方放就好。左……右……", "fx": "特写-怀表-循环" },
    { "who": "her", "text": "你现在站在我面前，手里握着剑，耳朵里听得见它滴答滴答地在走……对不对？", "fx": "特写-怀表-循环", "trance": 0.02 },
    { "who": "hero", "text": "……那又怎么样。", "fx": "特写-怀表-循环" },
    { "who": "her", "text": "不怎么样呀~ 只是你每在心里答一声『对』，肩膀就会放松一点点……你看，又松下来了呢。", "fx": "特写-怀表-循环", "trance": 0.04 },
    { "who": "her", "text": "呼吸也是哦。刚进门的时候还那么急，现在已经和它摆得一样慢了呢。", "fx": "特写-怀表-循环", "float": { "style": "耳语", "text": "滴……答……" } },
    { "who": "hero", "text": "（……只是因为走了很远的路，有点累了而已。）", "fx": "特写-怀表-循环" },
    { "who": "her", "text": "站得那么远，听不清我说话吧？再靠近一点也可以哦~ 放心，我不会碰你的。", "fx": "特写-怀表-循环", "trance": 0.07, "float": { "style": "耳语", "text": "是你自己想靠过来的哦♥" } },
    { "who": "her", "text": "眼皮觉得重的话，垂下来一点也没关系的。看不清怀表了，就听着我的声音吧~", "fx": "特写-怀表-循环" },
    { "who": "her", "text": "对了，能帮我一个小忙吗？数一数它摆了多少下，在心里默默地数就好~", "fx": "特写-怀表-循环", "trance": 0.11 },
    { "who": "hero", "text": "（一、二、三……六、七……七……咦，刚才那一下，数过了吗？）", "fx": "特写-怀表-循环" },
    // 站主 2026-10-03：会数乱是因为从小往大数；从大往小数就不会出错——示范一次，数到零就进去了
    { "who": "her", "text": "数乱了吗？呵呵……那是因为你在从小往大数哦。数字越数越多，脑袋当然会乱掉嘛~", "her": "smug", "fx": "特写-怀表-循环", "trance": 0.14 },
    { "who": "her", "text": "从大往小数的话，就不会出错了哦。我来示范一次给你看~ 要好好听着……", "fx": "特写-怀表-循环", "trance": 0.16 },
    {
      "who": "her", "text": "……", "fx": "特写-怀表-循环",
      "countdown": { "from": 3, "every": 2, "hold": 2, "trance": 0.3, "lines": ["三……肩膀放松下来~", "二……呼吸变得更慢了……", "一……脑袋里什么都不用想了……", "零♥"] }
    },
    { "who": "her", "text": "啪~ 你看，一下都没有数错吧？而且什么事都没有发生哦，你还好好地站着，剑也还握在手里呢。", "her": "normal" },
    { "who": "hero", "text": "……哼。我早就说过了，这种东西对我没用。" },
    { "who": "her", "text": "嗯嗯，一点用都没有呢~ 那就开始吧，勇者大人。让我好好见识一下你的『讨伐』♥", "her": "smug", "float": { "style": "耳语", "text": "真是个好孩子♥" } }
  ],

  // 假结局：第 3 组通过之后（玩家以为全部通过了）。螺旋收掉，像真的结束了一样
  "假结局": [
    { "who": "narrator", "text": "怀表的声音停了下来，屋子里一下子变得很安静。", "bg": "ending", "her": "hurt", "trance": false },
    { "who": "her", "text": "……居然连最后的十五秒都忍住了呢。能把三组全部撑下来的，勇者大人还是第一个哦。" },
    { "who": "hero", "text": "哈啊……我早就说过了吧。催眠术这种东西……根本就不存在。" },
    { "who": "her", "text": "嗯，是不存在呢……这一次是我输了~" }
  ],

  // 假的最后一击：选项出来 2 秒后（或者去点「给出最后一击」的那一刻）她打一个响指——
  //   order 命令的大字；after / afterHer 命令之后对话框里换的那句、她换的表情。「给出最后一击」碎掉，只能选 bypass
  "假-最后一击": {
    "bg": "choice",
    "her": "hurt",
    "who": "her",
    "text": "输了就是输了呢~ 来吧，勇者大人，只要给我最后一击，就可以回去领赏了哦？",
    "strike": "给出最后一击",
    "bypass": "饶过催眠术师",
    "order": "饶过催眠术师",
    "after": "啪~ ……哎呀，勇者大人的手，怎么自己停下来了呢？♥",
    "afterHer": "smug"
  },

  // 被命令着选了饶过之后、第 4 组之前（第 4 组整组装成无尽模式：她骗他「你已经输了」）
  "假-饶过": [
    { "who": "hero", "text": "（手……自己动了？我刚才……到底选了什么……？）", "her": "smug", "trance": 0.45 },
    { "who": "her", "text": "其实从我数到零的那一刻开始，勇者大人就一次都没有醒过来哦~" },
    { "who": "her", "text": "刚才那三场『讨伐』，都是我陪你做的梦哦。你撑得越用力就陷得越深……所以我才一直让你赢的呀♥", "fx": "吐息" },
    { "who": "hero", "text": "（不对……我明明……全都撑过来了才对……）" },
    { "who": "her", "text": "是呀，撑得非常漂亮呢~ 不过很可惜，美梦已经做完了哦。", "fx": "心章" },
    { "who": "her", "text": "接下来就没有『第几组』，也没有倒数了。勇者大人就一直留在这里陪着我吧~", "float": { "style": "竖排", "text": "没有……倒数了？" } }
  ],

  // 结局：第 4 组也通过之后（真的全部通过），最后一击的选项之前
  "结局": [
    { "who": "narrator", "text": "螺旋慢慢停了下来。屋子里只剩下一盏灯，和一只不再摆动的怀表。", "bg": "ending", "her": "hurt", "trance": false },
    { "who": "her", "text": "……骗人的吧？陷得那么深，居然靠自己走出来了……" },
    { "who": "hero", "text": "哈啊……哈啊……原来催眠术……是真的存在的啊……" },
    { "who": "her", "text": "呵呵……是存在的哦。只不过，好像对勇者大人不管用呢~" }
  ],

  // 最后一击选了第二个按钮之后、无尽战斗之前
  "绕过": [
    { "who": "her", "text": "哎呀？好不容易才走出去，结果又自己走回来了吗~", "her": "smug", "fx": ["心章", "吐息"], "trance": 0.45 },
    { "who": "her", "text": "这一次我可是什么都没有说哦？是勇者大人自己开口求我的呢♥" },
    { "who": "narrator", "text": "怀表又一次慢慢地摆了起来——这一回，是真的没有尽头了。" }
  ],

  // 组与组之间的暂停画面。台词从 lines-006.jsonc 的「暂停-一」「暂停-二」池里随机取；这里是提问和两个按钮
  "暂停": {
    "bg": "pause",
    "her": "smug",
    "question": "还是不相信吗？",
    "continue": "继续讨伐",
    "retreat": "认输"
  },

  // 最后一击（真的）：结局剧情最后一句之后出现的选项
  //   strike（给出最后一击 → 讨伐成功）；bypass（饶过 → 无尽战斗）
  "最后一击": {
    "bg": "choice",
    "her": "hurt",
    "who": "her",
    "text": "这一次是我彻底输了呢~ 那么，勇者大人打算怎么处置我呢？这次可没有人会替你选了哦。",
    "strike": "给出最后一击",
    "bypass": "请再催眠我一次"
  }
}

// 讨伐任务 · 委托 007 · 公会柜台 · 剧情对话
//
// 【文案第三版，2026-10-19】开场是站主写的（背景设定以站主这版为准）；结局、绕过照着调。和 lines-007.jsonc 是同一套——
//   开场   夜里只剩新人登记的柜台还亮着 → 她进来 → 一条斜框推近看身材（胸 → 腰腿）→ 扩成大框给举着白卡那张、做冒险者卡 → 填名字 →
//          Lv30 被她看出来 →「在姐姐这里登记过的乖孩子，最后都会变回真正的新人」→ 先来一场模拟战，测试实力
//   结局   四组撑下来，等级没有被吸干；他点破新人掉级的事，她认出他是 Aschan 派来的
//   绕过   包庇她：报告上写「未发现异常」，成了新人登记处的常客（站主 2026-10-19：结局不要「夜深了」「留下来陪她」）
//   清零   等级被吸到 0（清空那一场之后）：收藏柜，停在「等级清零 END」
// 写法和 story-002.jsonc 一样，多两样：
//   still：对话框上面的画面框（game.js 的 storyStill）。{ src, size, focus, zoom, pan, ms }——
//     size "band" 横穿画面的一条（看身材），"large" 对话框上面一大块；pan [[起 x, y], [止 x, y]]（原图像素）ms 毫秒走完；
//     换 size 时框往上下扩开；写 false 收起。写一次一直留着，到下一个 still 或剧情结束
//   input：{ kind: "name" } 登记名字（storyInput），填好才往下走；之后 {name} 换成它、冒险者卡上写着它
// 对话框三行放得下，一句别超过 50 字。站主改哪句都行。
{
  "开场": [
    { "who": "narrator", "text": "大厅的灯熄了一半，只剩新人登记的柜台还亮着。据说那些退会的新人，都是从这里开始的。", "bg": "story", "her": "none" },
    { "who": "her", "text": "这么晚了还有新人来登记呀？……真乖，姐姐正好还没下班哦~", "her": "smug", "fx": "魅惑闪光" },
    {
      "who": "narrator", "text": "柜台后面坐着一个黑皮肤的精灵。她撑着下巴往前倾，衬衫的扣子绷得紧紧的，像是随时都会弹开。",
      "still": { "src": "her-007.537ef07b6e.webp", "size": "band", "zoom": 2.3, "pan": [[500, 250], [480, 480]], "ms": 3400 }
    },
    {
      "who": "narrator", "text": "收得细细的腰，绷紧的短裙，还有被白丝勒出一圈软肉的大腿——视线不知不觉，就一路滑了下去。",
      "still": { "src": "her-007.537ef07b6e.webp", "size": "band", "zoom": 2.3, "pan": [[490, 650], [470, 1000]], "ms": 3600 }
    },
    { "who": "her", "text": "看够了吗？" },
    {
      "who": "her", "text": "比起盯着姐姐看，还是先来制作冒险者卡片吧~",
      "still": { "src": "clip-007-begin.37a2a37cae.webp", "size": "large", "zoom": 1.1, "pan": [[600, 420], [430, 600]], "ms": 3000 }
    },
    {
      "who": "her", "text": "把名字告诉姐姐吧。没关系的，个人隐私并不会录入系统~ 为了体验感，这边很推荐用真名喔~",
      "input": { "kind": "name", "title": "冒险者卡", "label": "名字", "placeholder": "写下你的名字", "button": "登记", "max": 10 }
    },
    { "who": "her", "text": "{name}是么……嗯，很好听呢。姐姐会好好记住的♥", "fx": "魅惑闪光" },
    { "who": "her", "text": "咦，卡上浮出来的等级是……30？刚来登记的新人，可不会有这么高的等级~" },
    { "who": "hero", "text": "（糟了……）以、以前在乡下打过几只史莱姆而已。" },
    { "who": "her", "text": "呵呵，那就当作是这样吧。反正在姐姐这里登记过的乖孩子，最后都会变回真正的新人呢♥", "fx": "心章" },
    { "who": "her", "text": "我是新人登记处的莉薇尔。首先，让我们先来进行一个模拟战，来测试一下{name}的实力吧~", "still": false }
  ],
  "结局": [
    { "who": "narrator", "text": "最后一组也结束了。你大口喘着气，等级还剩下不少。", "bg": "ending", "her": "hurt" },
    { "who": "her", "text": "……居然一直撑到了最后。明明是个新人，倒是比谁都能忍呢~" },
    { "who": "hero", "text": "那些等级下降、退出公会的新人……都是你做的吧。" },
    { "who": "her", "text": "被发现了呀~ 原来是 Aschan 派来的……那么，打算怎么处置姐姐呢？", "her": "smug" }
  ],
  "最后一击": {
    "bg": "choice",
    "her": "smug",
    "who": "her",
    "text": "要把姐姐交给公会吗？还是说……{name}愿意替姐姐保守这个秘密呢？♥",
    "strike": "把她交给公会",
    "bypass": "包庇她"
  },
  "绕过": [
    { "who": "her", "text": "……要包庇姐姐？呵呵，{name}果然是个温柔的孩子呢♥", "her": "smug", "fx": "魅惑闪光" },
    { "who": "her", "text": "那报告就拜托你了哦~ 作为谢礼，剩下的等级……姐姐会好好收下的♥", "fx": "心章" },
    { "who": "narrator", "text": "你在交给 Aschan 的报告上写下了「未发现异常」。从那天起，新人登记处的柜台前多了一个常客。" }
  ],
  "清零": [
    {
      "who": "narrator", "text": "冒险者卡上的数字停在了 0。莉薇尔捏着那张卡，推开了柜台后面的那扇门。", "bg": "ending", "her": "smug",
      "still": { "src": "clip-007-end.4bbe21b039.webp", "size": "large", "zoom": 1.15, "pan": [[420, 300], [440, 640]], "ms": 4200 }
    },
    { "who": "her", "text": "这里就是姐姐的收藏柜哦~ 架子上的每一张，都是被吸得干干净净的新人呢♥" },
    { "who": "hero", "text": "（手指……动不了。连站起来的力气都没有了……）" },
    {
      "who": "her", "text": "{name}的这一张，就放在最显眼的地方吧♥",
      "still": { "src": "clip-007-end.4bbe21b039.webp", "size": "large", "zoom": 1.35, "pan": [[440, 640], [560, 1050]], "ms": 3600 }
    },
    { "who": "her", "text": "明天再来公会吧~ 姐姐会帮你做一张新的卡——从 Lv1 开始哦♥", "fx": "心章" },
    { "who": "narrator", "text": "那之后，公会的退会名单上又多了一个名字。Aschan 交代的那份调查报告，再也没有人交上去。" }
  ],
  // 救济（累计彻底败北 5 次，quest.relief.after）：承认自己是「姐姐的储蓄罐」＝解锁「重来这一组」
  "救济": [
    { "who": "her", "text": "又来登记了呀~ 这已经是第{n}次了哦♥", "bg": "pause", "her": "smug" },
    { "who": "her", "text": "看你一次又一次地回来……姐姐也有点心软了呢~" },
    { "who": "her", "text": "只要承认自己是『姐姐的储蓄罐』，就让你从输掉的那一组重新开始哦♥", "fx": "魅惑闪光" }
  ],
  "救济选择": {
    "bg": "pause",
    "her": "smug",
    "who": "her",
    "text": "怎么样？承认自己是乖乖给姐姐存等级的储蓄罐吗~♥",
    "admit": "承认自己是储蓄罐",
    "refuse": "才不是储蓄罐"
  },
  "救济-承认": [
    { "who": "her", "text": "好乖~♥ 那从今天起，{name}就是姐姐专属的储蓄罐了哦", "fx": "心章" },
    { "who": "narrator", "text": "解锁了「重来这一组」：之后彻底败北时，可以从输掉的那一组重新开始（等级回到那一组开始的时候）" }
  ],
  "救济-拒绝": [{ "who": "her", "text": "嘴硬的样子也很可爱呢~ 那就从模拟战重新来吧♥" }],

  "暂停": {
    "bg": "pause",
    "her": "smug",
    "question": "还要继续吗？",
    "continue": "继续讨伐",
    "retreat": "认输"
  }
}

        "hips": { "side": "left", "sideOffset": 80, "height": 400, "offset": [40, 0], "bodyTwist": 0.0021, "twist": 0.0026, "impulse": 140, "maxOffset": 19, "radius": [210, 130], "loop": { "amp": 14 } },
        "eyes": { "height": 80, "eyeSpread": 36 },
        "watch": { "height": 330, "hold": 3, "gain": 1.15 },
        // 嘴（特写-嘴）：侧脸吐舌那张（clip-006-lick.webp＝assets/006_3.png，832 × 702）：舌尖约 165,470、嘴 190,400、眼 335,215、耳 520,340。每到一次「提」舔一下
        "mouth": {
          "still": "clip-006-lick.9ff98f7905.webp", "focus": [200, 400], "zoom": [1.3, 1.55], "hold": 2.8,

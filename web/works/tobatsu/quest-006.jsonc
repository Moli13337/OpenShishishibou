      "talk": { "every": 2.6, "fx": { "耳语": 3, "气泡": 1, "竖排": 2, "思绪": 1, "大字": 1 }, "pools": { "耳语": { "耳语-四": 2, "言责-催眠": 1 }, "竖排": { "心声-四": 1, "心声-催眠": 2 } } }

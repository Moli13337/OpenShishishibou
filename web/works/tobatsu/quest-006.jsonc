        // 第二次跳秒（62 → 118）
        { "at": 28.4, "fx": "台词条", "text": "咦，又有一分钟不见了呢~ 是不是越数越乱了？", "hold": 4 },
        { "at": 29.2, "fx": "特写-臀", "hold": 2 },
        { "at": 31.6, "fx": "挑战-顺序", "labels": ["请您支配我", "不想思考了"], "decoys": 1, "time": 6.5, "pool": "挑战-文字" },
        { "at": 41.2, "fx": "变速", "mult": 1.5, "hold": 4 },
        { "at": 41.5, "fx": "特写-胸", "hold": 2.2 },
        // 第三次跳秒（134 → 256），接着第二次按住（她那句连着说，题不另说话）
        { "at": 44.2, "fx": "台词条", "text": "已经过去好几分钟了哦~ 这次也别跟丢了♥", "hold": 4.5 },
        { "at": 44.6, "fx": "挑战-按住", "place": "watch", "order": "按住怀表，跟着它摆", "hold": 2.6, "time": 5.4 },
        { "at": 50.4, "fx": "挑战-顺序", "labels": ["我是催眠奴隶", "我自愿服从您"], "decoys": 2, "time": 7.5, "pool": "挑战-文字-最后" },
        // 第四次跳秒（264 → 599）
        { "at": 52.8, "fx": "竖排", "text": "过去多久了……" }
      ],
      "overtime": [
        // 60 秒走完（他不知道）：秒数那一格不再是数字，一拍换一个词
        { "do": "words", "pool": "超时-言责", "seconds": 5, "every": 1 },
        // 分岔之前她告诉他出口在哪儿，最后凝视铺满整屏
        {
          "do": "words", "pool": "超时-言责", "seconds": 7.4, "every": 1,
          "script": [
            { "at": 0, "fx": "响指" },
            { "at": 0.3, "fx": "台词条", "text": "对了，最后再告诉勇者大人一件事吧~", "hold": 9 },
            { "at": 2.6, "fx": "台词条", "text": "顺着螺旋往外走的话，其实是可以醒过来的哦。", "hold": 9 },
            { "at": 4.6, "fx": "竖排", "text": "往外走……就能醒" },
            { "at": 5.2, "fx": "台词条", "text": "不过……勇者大人真的走得出去吗？♥", "hold": 9 },
            { "at": 5, "fx": "特写-凝视", "variant": "整屏", "hold": 1.5 }
          ]
        },
        // 分岔：螺旋形的轨道。往外走到头＝醒来（这组过）——越往外越浓（hypno.fork）；被吸进中心＝沉下去（认输，进败北处决）。40 秒没选＝沉下去
        {
          "do": "challenge", "kind": "分岔", "track": "spiral", "time": 40, "onReward": "lose",
          "passTag": "醒来", "rewardTag": "沉下去",
          "words": { "pool": "分岔-秒数", "every": 1 },
          "lurePool": "分岔-诱惑", "passLine": "分岔-通过", "rewardLine": "分岔-奖励", "timeoutLine": "分岔-犹豫"
        }
      ],
      "stage": {
        // 整组都是「无尽模式」的样子：她说的是「你已经输了」「时间又不见了一段」
        // （前段还没跳过秒：耳语、心声用垫底的两池；「又少了一段」那几句是中段起才说的）
        "early": {
          "line": "四组-前段", "lineEvery": 5, "charm": 0.6, "every": 4.5, "fx": { "拟声": 1, "魅惑闪光": 2, "吐息": 1, "集中线": 1 },
          "talk": { "every": 4, "fx": { "耳语": 3, "气泡": 1, "竖排": 1 }, "pools": { "耳语": "言责-催眠", "竖排": "心声-催眠" } }
        },
        "mid": { "line": "四组-中段", "charm": 0.45, "talk": { "every": 4, "everyTo": 3.2, "fx": { "耳语": 3, "气泡": 1, "竖排": 1 }, "pools": { "耳语": "耳语-四", "竖排": "心声-四" } } },
        "late": { "line": "四组-后段", "charm": 0.58, "talk": { "every": 3.2, "everyTo": 2.4, "fx": { "耳语": 3, "气泡": 1, "竖排": 1, "大字": 1 }, "pools": { "耳语": "耳语-四", "竖排": "心声-四" } } },
        // 题全是上面定时出的（随机的会把定时的挤掉）
        "challenge": { "in": [] }
      }
    }
  ],

  // ---------- 遵命的奖励（命令下面的按钮）：侧脸吐舌那张推近到嘴；点一次洗脑进度 +2 ----------

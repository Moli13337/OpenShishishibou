  // ---------- 立绘档案（全身）----------
  // 006（assets/006.png，960 × 1720）。眼睛约 468,215 / 540,198、嘴 512,248，脸有一点歪；怀表在画面最左边（表 98,593；链子挂在手指上 120,449）。
  // 立绘和遮罩由 scripts/art/tobatsu-standee.mjs 006 006-body 生成（R 胸 / G 呼吸 / B 长卷发 / 遮罩 2：R 臀部、G 怀表和那一小截链子），tobatsu-mask-check.mjs 体检；
  // 取景、锚点、特写都是 Claude Code 按原图量的起步值，站主在调节器里微调
  "standee": {
    "art": {
      "standee": {
        "her": {
          "frame": { "top": 30, "bottom": 870, "centerX": 545 },
          "faces": { "normal": "her-006.2bade963b0.webp", "smug": "her-006.2bade963b0.webp", "hurt": "her-006.2bade963b0.webp" }
        }
      },
      "battleStandee": {
        "src": "her-006.2bade963b0.webp",
        "mask": "her-006-mask.fc001d6063.png",
        "mask2": "her-006-mask2.1587a8ff11.png",
        "centerX": 545,
        "frames": {
          "idle": [30, 930],
          "early": [30, 870],
          "mid": [110, 770],
          "late": [150, 680],
          "win": [30, 930],
          "lose": [0, 1720],
          "retreat": [0, 1250],
          "endless": [140, 730]
        }
      }
    },
    "motion": {
      "cycle": { "amp": 14, "freeAmp": 6, "waistY": 640, "feather": 75 },
      "breathe": { "amp": 2.5 },
      "shake": { "maxOffset": 28, "impulse": { "cutin": 330, "art": 260, "heartbeat": 42 } },
      "hair": { "amp": 2.5 }
    },
    "fx": {
      // knee / legs 借「晃腿」那一套给怀表的小特写框用；watch＝表盘（螺旋的中心，也用来算这只表本来歪了多少）
      "anchors": { "face": [506, 220], "eyes": [504, 207], "lips": [512, 248], "crest": [548, 745], "hips": [545, 800], "waist": [560, 640], "feet": [560, 1690], "knee": [120, 449], "legs": [104, 545], "watch": [98, 593] },
      // 图里画着的那只怀表：遮罩 2 的 G 绕 pivot（链子挂在手指上的那一点）摆。原图里它往左歪了 8.7°（按 pivot 和 anchors.watch 自动算），
      // 先掰正再左右对称地摆（站主 2026-10-02：原来摆得不对称）；amp 摆幅（弧度，按段）、free 没在打的时候自己晃多大、
      // story 剧情里（开场的怀表特写）摆多大——一秒一下（站主：原来 0.06 太小）、face 表盘半径（出在怀表上的题按它定环的大小）
      "watch": { "pivot": [120, 449], "face": 28, "amp": { "early": 0.26, "mid": 0.2, "late": 0.13 }, "free": 0.06, "story": 0.3 },
      // 垂在镜头前面的那只（和近景用的是同一张怀表图、同一个位置）：全身这张上平时收着；近景露过面、或者镜头关键帧写了 "pendulum": true、
      // 或者有题要出在怀表上，就放下来，之后这一组一直留着
      "pendulum": { "src": "clip-006-clock.52b223f65a.webp", "pivot": [157, 0], "length": 1040, "face": 140, "screen": [0.42, 0.57], "hidden": true, "amp": 0.2, "free": 0.07 },
      // 委托单画面立绘眼睛上的黑条（两只眼睛约 468,215 / 540,198，往右上斜）
      "eyeBar": { "center": [504, 207], "size": [156, 44], "angle": -13 },
      "charm": { "visions": { "zoom": { "chest": 300, "lips": 110, "eyes": 150 } } },
      "closeup": {

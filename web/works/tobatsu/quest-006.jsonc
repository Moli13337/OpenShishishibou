          "chest": { "height": 620, "offset": [0, 0], "impulse": 420, "maxOffset": 44, "loop": { "amp": 18 } },
          "chestSide": { "impulse": 260, "maxOffset": 30, "loop": { "amp": 22 } },
          "hips": { "side": "left", "sideOffset": 60, "height": 420, "offset": [0, -120], "bodyTwist": 0.0012, "twist": 0.0016, "impulse": 140, "maxOffset": 19, "radius": [300, 160], "loop": { "amp": 14 } },

// 讨伐任务 · 委托 006 · 催眠术师 的台词
//
// 【第五版，2026-10-03】故事还是第四版的（站主：剧情可以），改了口气和第 4 组——
//   · 站主点了一种句式要全部改掉：「我就站在这儿，不躲。」「十五秒。三组，全都撑过来了。你是第一个。」「动手吧，勇者大人。我不躲。」——
//     短句一截一截地断开、最后压一句很酷的话，故作深沉、读着尴尬。「不是 A。是 B。」那种一翻一扣的警句也是同一路。
//     现在她说话是连着说的：完整的句子，带着笑意逗他，句尾「哦」「呢」「吧」「~」，像站主给的那几句（「你已经输了哟~」「被打败了呢~」）。
//     以后往里加句子照这个口气：别断成三截，别在句尾压一句狠话。
//   · 她：希普诺（站主 2026-10-03 起的名字），成熟、不急不躁的大姐姐，从不解释规则，只是聊天、夸奖、允许、逗他。先叫他「勇者大人」，越往后越常说「真乖」「好孩子」。自称「我」。
//   · 日语、英语译文在 tr-ja.jsonc / tr-en.jsonc 的「委托 006」一节（中文原句当键）：改了这里的句子，那边的原句要跟着改成一样的字，
//     不然那一句在日英版会露出中文（node scripts/art/tobatsu-tr-check.mjs ja 006 列得出来）。
//   · 故事：勇者不信催眠术，带着剑来「讨伐」。开场她说他数乱了是因为「从小往大数」，从大往小数就不会错，示范一次——三、二、一、零，他就进去了，
//     自己却以为还醒着。前三组的「讨伐」是她陪他做的梦（放下念头 → 照做是舒服的 → 他看见的东西被换掉）；假通关那一下揭穿。
//     第 4 组她骗他「你已经输了、这是无尽模式」：秒数往上数（从小往大数，数不到头），还时不时跳掉一大截——「不知不觉又过去了这么久」。
//     其实时间照常走，走完给他二选一；往外走（醒来）的路上，她的注视、他自己想留下来的念头越涌越多。
//   · 每一组各有各的台词条、耳语、心声（池名带「一 / 二 / 三 / 四」），不混共用词库里的言责。
// 委托单（委托人、说明、背景、报酬 800G）是站主写的。站主改哪句都行。
//
// 写法和 lines-005.jsonc 一样：每个池一个数组，一句一个字符串。
// 字数上限：台词条 30 字（20 字以内一行放得下）、cut-in 16 字、对话框 50 字、委托单 40 字、耳语 20 字、心声 12 字、特写框下面那行 10 字、大字 8 字。
{
  // 委托开场 —— 委托书里的一句。≤ 40 字
  "委托开场": ["催眠术？那种东西根本就不存在哦~ 不相信的话，就亲自来看一看吧。", "门一直都没有上锁哦。想来讨伐我的话，随时欢迎~"],

  // 准备 —— 每组开始前 3 秒的准备倒数。≤ 30 字。四组各有各的（quest 文件的 sets[n].prep），「准备」是垫底的（无尽战斗也用它）
  "准备": ["握好你的『圣剑』，其他的事情都交给我就好~", "不用着急，慢慢来就好哦~"],
  "准备-一": ["那就请吧，勇者大人~ 想从哪里开始都可以哦。", "把『圣剑』握紧一点哦，要开始了~"],
  "准备-二": ["休息好了吗？手倒是一直都没有松开过呢~", "那我们继续吧~ 这一次，要多听听我的声音哦。"],
  "准备-三": ["勇者大人刚进门的时候说过，催眠术对你没用，对吧？", "那些人为什么不肯走，勇者大人也很好奇吧？"],
  "准备-四": ["已经不用再数了哦，反正也数不到头了~", "慢慢来就好，我们有的是时间呢~"],

  // ================= 台词条：每组各段她说的。≤ 30 字 =================
  // 第 1 组（整组都是前段）：她不还手，只是哄他把念头一件一件放下
  "一组-前段": [
    "它每摆一下，脑袋里的事情就会少一件哦。",
    "肩膀又放松了一点呢，你自己还没发现吧？",
    "不用回答我也没关系，听着就好了~",
    "脑袋里的声音，是不是变少了一点呀？",
    "一直想事情很累的吧？先放一放也没关系哦。",
    "很安静对吧？这里只有怀表的声音和我的声音哦。",
    "勇者大人是来讨伐我的，对吧？……嗯，还记得就好~",
    "你的手一直在跟着它动呢~ 我可没有叫你跟着哦？",
    "视线又往下滑了呢~ 没关系，想看哪里都可以哦。",
    "不用着急，我们慢慢来就好~"
  ],
  // 第 2 组：照做是舒服的
  "二组-前段": [
    "刚才我说什么，你就乖乖地照做了呢。感觉舒服吗？",
    "不用去想『为什么』哦。照我说的做，就会变得很舒服~",
    "你在等我开口，对不对？我都看出来了哦~",
    "照我说的做的时候，你的表情特别放松呢。",
    "每数到一次零，就会再陷下去一点哦~ 这可是你自己数的。"
  ],
  "二组-中段": [
    "我一不说话，你就不知道该做什么了吧？",
    "照我说的去做，比自己拿主意要轻松多了吧~",
    "被我说『乖』的时候，心里其实很高兴吧~",
    "手一直在跟着我的声音动呢，不用去管它哦。",
    "还想被我夸奖吗？那就再听话一点吧~",
    "这么舒服的事情，忍不住照做也是没办法的嘛~"
  ],
  "二组-后段": [
    "我还没开口呢，你就已经在等我的命令了哦？",
    "再乖一点的话，我就再靠近你一点哦~",
    "现在这副表情，可一点都不像是来讨伐我的人呢~",
    "不用再忍耐了哦，听话的孩子是不需要忍耐的~",
    "该叫你『勇者大人』，还是叫你『好孩子』比较好呢~"
  ],
  // 第 3 组：他看见的东西，是她让他看见的
  "三组-前段": [
    "你现在看见的东西，都是我想让你看见的哦~",
    "勇者大人的眼睛，现在好像更听我的话呢~",
    "那些字很眼熟吧？都是你一直想说出口的话哦。",
    "我可没有骗你哦，只是帮你看得更清楚一点而已~",
    "刚才念出来的那一句话，到底是谁的想法呢~"
  ],
  "三组-中段": [
    "你确定刚才看见的，真的是数字吗？",
    "比起自己的眼睛，还是相信我比较好哦~",
    "再念一遍吧~ 多念几遍，就会变成真的了哦。",
    "常识这种东西，换掉一两个也不会痛的哦~",
    "原来是什么样子，已经想不起来了吧？那就不用再想了哦。",
    "念出口的那一瞬间，身体是不是热了一下呀？"
  ],
  // （这几句在按钮被换成「长按获胜」之前之后都说得通）
  "三组-后段": [
    "勇者大人很想赢吧？我当然知道哦~",
    "获胜的办法，不是一直写在你手边吗~",
    "照我说的做，可是从来没有让你吃过亏吧？",
    "我什么时候害过勇者大人呀~",
    "难道勇者大人不想赢吗？"
  ],
  // 第 4 组：她骗他「你已经输了，这是无尽模式」，秒数往上数、还时不时跳掉一大截（开头那两句站主写的，在 quest 文件的定时台词里）
  "四组-前段": [
    "已经没有『第几组』了哦，就这样一直陪着我吧~",
    "反正已经输了，勇者大人也不用再忍耐了吧？",
    "从小往大数的话，可是永远都数不到头的哦~"
  ],
  "四组-中段": [
    "时间过得真快呀~ 是不是又有一段想不起来了？",
    "数字越数越大，脑袋就会越来越乱哦~",
    "反正已经输了，再怎么挣扎也没有用的哦~",
    "想不起来的那段时间里，你可是一直很乖呢♥",
    "还握着剑呀？握得越紧，可是会陷得越深的哦~",
    "现在数到多少了，勇者大人自己还数得清吗~"
  ],
  "四组-后段": [
    "就这样一直数下去吧，反正永远都数不完的~",
    "外面大概已经天黑了吧？不过也和你没关系了呢~",
    "把剩下的那一点力气也交给我吧，一直握着多累呀~",
    "来讨伐我的勇者大人，现在正被我哄着睡觉呢♥",
    "已经过去多久了呢？想不起来也没关系哦~",
    "真乖~ 很快就什么都不用想了哦♥"
  ],
  // 垫底的三池（各组没另写的时候用）
  "前段": ["不用着急，慢慢来就好~", "听着我的声音就好了哦。", "它每摆一下，脑袋里的事情就会少一件哦。"],
  "中段": ["再往下沉一点吧……对，就是这样~", "不用想哦，想的事情交给我就好~", "手一直在跟着我的声音动呢~"],
  "后段": ["已经陷得很深了呢~", "只听得见我的声音了吧？", "真乖~ 全部交给我就好♥"],

  // cut-in —— 进中段 / 进后段的那一刻。≤ 16 字
  "cutin-前到中": ["再往下沉一点吧~", "已经不用再想了哦", "只听我的声音就好~", "眼皮变重了吧？"],
  "cutin-中到后": ["只剩下我的声音了♥", "已经回不去了哦~", "全部交给我吧♥", "一直沉到底吧♥"],

  // 长按放弃 —— 按住时 / 没按满就松手。≤ 20 字
  "长按中": ["想要放弃了吗？慢慢来就好~", "对，就这样把力气松掉吧~", "按到底的话，就不用再硬撑了哦", "放下来吧，我会好好接住你的♥"],
  "松手": ["又缩回去了呀？嘴还真硬呢~", "就差一点点了呢，下次可别松手哦~", "手都在抖了哦？我可都看见了~", "不着急~ 反正你迟早会按到底的。"],
  // 第 3 组：下面那行字被她换成「长按获胜」之后，按住 / 松手 / 按到底（其实是放弃）
  "长按中-上当": ["对，就这样按住~ 马上就能『赢』了哦♥", "别松手哦，再坚持一下就结束了~", "很好~ 就这样一直按到底吧♥"],
  "松手-上当": ["怎么松开了呀？难道不想赢吗~", "明明只差一点点了呢，再按一次吧~", "手指在犹豫呢……相信我就好了哦♥"],
  "放弃-上当": [
    "那两个字从头到尾都是『放弃』哦？是你自己看错了呢~",
    "我说是『获胜』，你就真的看成『获胜』了呢~ 真听话♥",
    "谢谢你这么相信我哦~ 那就晚安啦，勇者大人♥"
  ],

  // 放弃 —— 战斗中放弃的结算，按放弃时的阶段。≤ 30 字
  "放弃-前段": ["这么早就放弃了呀？倒是省了我不少力气呢~", "我还什么都没做呢~ 真是个让人省心的孩子。"],
  "放弃-中段": ["才到一半就松手了呀？是太累了，还是太舒服了呢~", "不用解释哦，松手那一刻的表情，我都看见了♥"],
  "放弃-后段": ["明明只差几秒了呢~ 其实是舍不得结束吧？", "撑到最后才自己交出来……这种输法我最喜欢了♥"],

  // 暂停 —— 组与组之间她在对话框里说的。≤ 50 字。第 1 组、第 2 组打完各有各的（sets[n].pause），「暂停」是垫底的
  "暂停": ["还站得稳吗？站不稳的话，靠到我身上也可以哦~"],
  "暂停-一": ["是不是觉得有点奇怪？明明是来讨伐我的，肩膀却比刚进门的时候还要放松呢~", "刚才我一共说了四次，勇者大人就碰了四次怀表呢。……这只是巧合，对吧~"],
  "暂停-二": ["勇者大人发现了吗？我已经很久没有对你说『请』了哦~", "刚才有好一会儿，你都是跟着我的节拍在呼吸的哦。……现在也一样呢~"],

  // 撤退 —— 暂停画面选了「认输」。≤ 30 字
  "撤退": ["要认输了吗？其实是不想醒过来了吧~", "真聪明呢~ 剩下的暗示，我会一点一点帮你放进去的♥"],

  // 败北 —— 挑战没在限时内完成。≤ 30 字
  "败北": ["手没有跟上呢~ 不怪你哦，是我让它变慢的。", "到这里就可以了哦，剩下的就全部交给我吧~", "慢了一拍呢~ 看来已经陷得很深了哦♥"],
  "败北-点击": ["明明看见了，手却伸不出去，对吧~", "手指已经不听你的话了呢，它在等我的命令哦~"],
  "败北-按住": ["松开了呀？是手自己松开的，还是你想松开的呢~", "跟丢了哦~ 说好的，跟丢了就要归我了♥"],
  "败北-拖动": ["走到一半就停下来了呀？那就留在半路上陪我吧~", "线还没有走完呢，是腿软了吗~"],
  "败北-顺序": ["数错了哦~ 没关系，反正你的数字早就归我管了♥", "顺序都乱掉了呢~ 脑袋已经转不动了吧？"],
  "败北-连打": ["手指越来越重了吧？那就乖乖睡吧~", "敲不动了吗？那就不用再敲了哦♥"],
  "败北-分岔": ["自己走回中心来了呢~ 欢迎回来♥", "果然选了留下来呀~ 这才是你的真心话吧♥"],
  // 顺序题里点到诱饵
  "挑战-中诱饵": ["那一颗是我故意放的哦~ 你果然会去碰呢。", "头晕了吗？慢慢转也没关系，我会扶着你的~", "同一个陷阱踩两次，真是可爱呢~"],

  // ================= 挑战。≤ 30 字 =================
  // 一题做完她说的：每组各有各的（sets[n].stage.challenge.hitLine）；「挑战-命中」是第 4 组和无尽战斗的
  "怀表-照做": ["很好~", "真乖~ 不用去想为什么哦。", "你看，手比脑袋先动起来了呢~", "对，就是这样~"],
  "二组-命中": ["数得真好呢~", "数到零了哦，又陷下去一点了~", "真乖~ 待会儿再数一次给我听吧。", "你看，从大往小数就不会出错吧~"],
  "三组-命中": ["念出来了呢~ 真是好孩子♥", "念得真顺呀~ 其实早就想说出口了吧？", "我都听见了哦，会好好帮你记住的~", "再多念几遍，就会变成真的了哦~"],
  "挑战-命中": ["哎呀，居然还跟得上呢~", "手还听自己的话呀？真难得呢~", "那就再让你陷得深一点吧~", "真有意思~ 那我们继续吧。"],
  // 顺序题（数数）第一次出来时。后面几道不另说话：前面那一颗碰没碰，她刚说完的那句留着
  "挑战-登场-顺序": ["这一次换你来数吧~ 要从大往小，一直数到零哦。"],
  // 数字变成字（第 3 组）：第一次 / 之后 / 第 4 组最后那一句
  "挑战-登场-文字": ["仔细看看~ 那些不是数字，是你一直想说的话哦。"],
  "挑战-文字": ["这一句也念给我听听吧~", "一个字一个字地念出来……对，就是这样~", "写在那里的，可都是你的真心话哦~"],
  "挑战-文字-最后": ["这是最后一句了哦~ 念完就不用再硬撑了♥"],
  // 按住怀表（第 4 组）第一次出来时（第二次接在跳秒那句后面，写在 quest 文件的定时台词里）
  "挑战-登场-按住": ["抓住它吧~ 它摆到哪里，你就要跟到哪里哦。"],
  // 第 2 组：碰过怀表上那一颗之后，后面那道数数出来时
  "挑战-上钩之后": ["头晕了吗？慢慢数吧~ 这可是你自己选的哦。", "数字是不是在晃呀？其实晃的是你自己哦~", "就算看不清楚，也要乖乖数完哦~", "明明知道会变成这样，还是忍不住碰了呢~"],
  // 怀表上的那一颗：碰了（混乱里蹦出来的大字，≤ 8 字）/ 碰了之后台词条上那句（笑他明知故犯、自己凑上来）/
  // 忍住没碰：她在嘴边的一声 + 台词条上那句
  "诱饵-上钩": ["明知故犯♥", "是你自己碰的~", "真听话♥", "又上钩了呢~"],
  "诱饵-上钩-台词": [
    "明明都告诉你了，结果还是碰了呢~",
    "我只是说了一句而已哦？伸手的可是你自己呢~",
    "明知道是陷阱还要往里走……真是个好孩子♥",
    "嘴上说着不信，手指倒是比谁都听话呢~",
    "对自己没有好处的事情，也做得这么开心呀~",
    "我可没有逼你哦？是你自己想这么做的吧~"
  ],
  "诱饵-忍住": ["咦，忍住了？", "真能忍呢~", "下一次就会碰了吧~"],
  "诱饵-忍住-台词": ["居然没有碰呀？还留着一点自己的主意呢~", "我都说了要碰，你却没有碰……真少见呢~", "这次不听话呀？没关系，我们慢慢来~"],

  // ================= 败北处决 =================
  "处决-前言": ["勇者大人的『讨伐』，就到此为止了哦~", "接下来我会从十数到零。每数一下，你就会忘掉一件事情哦~", "等数到零的时候，就连自己是来讨伐谁的都想不起来了♥"],
  "处决-cutin": ["好好听着哦♥"],
  // 她在耳边数：每数一下，忘掉一件。{n}＝剩下的秒数
  "处决-倒数": ["{n}……自己的名字~", "{n}……来这里的理由~", "{n}……剑的重量~", "{n}……回去的路~", "{n}……自己的声音~", "{n}……还剩下什么呢？"],
  "处决-心声": ["我是来……做什么的", "她的声音……好近", "不想……醒……"],
  "处决-命令": ["握紧，不许松开"],
  "处决-命令-最后": ["全部交出来♥"],
  "处决-归零": ["洗脑完成♥", "是我的了♥", "晚安♥"],
  "处决-结算": ["回去之后，记得告诉公会『那里什么都没有』哦~", "明天的这个时候，你会自己再走回来的♥"],

  // ================= 结局 =================
  // 假通过：第 3 组之后那次「全部通过」（她装作认输）；全部通过：第 4 组之后，真的
